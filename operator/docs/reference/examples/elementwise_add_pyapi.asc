/**
 * elementwise_add · Python 调用接口的 C ABI（试验实现，2026-10-23）
 *
 * 目的：验证《交付物规范》里「host 侧导出 extern "C" C ABI + CMake 同时产出共享库」这条路线
 * 在算子开发镜像里**能编译、能被 ctypes 加载**（运行时 ACL 上下文兼容性需有卡时再验）。
 *
 * ABI（与 docs/reference/deliverable-standards.md 一致）：
 *   int elementwise_add_run(const void *a_dev, const void *b_dev, void *out_dev,
 *                           int64_t n, int dtype_code, int device_id);
 *     dtype_code: 0 = float32；device_id: 目标设备号（调用方负责进程内的 ACL 上下文）
 *     返回：0 成功；2 REJECT_BAD_ARGS；4 REJECT_N_OUT_OF_RANGE；5 REJECT_UNSUPPORTED_DTYPE；1 运行失败
 *   const char *elementwise_add_abi_version(void);
 *
 * 约束：不 aclInit / 不 aclrtResetDevice / 不 aclFinalize —— Python 进程里 torch_npu 可能已初始化
 * ACL 上下文，生命周期交给调用方（这正是要真机 spike 确认的点）。
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "../op_kernel/elementwise_add_tiling.h"

// 与可执行文件共用同一份 kernel（device 侧代码在共享库里同样打进去）
#include "../op_kernel/elementwise_add_kernel.asc"

namespace {

constexpr int64_t N_MIN = 1;
constexpr int64_t N_MAX = 1048576;
constexpr int DTYPE_CODE_FLOAT32 = 0;

int build_tiling(int64_t n, int deviceId, AddTilingData *tiling, int64_t *coresOut)
{
    int64_t cores = 0;
    if (aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores) != ACL_SUCCESS || cores <= 0) {
        return 1;
    }
    uint32_t totalLength = static_cast<uint32_t>(n);
    uint32_t tileLength = (totalLength <= SMALL_TILE_MAX_LENGTH) ? SMALL_TILE_LENGTH : MAX_TILE_LENGTH;
    uint64_t totalTiles = (totalLength + tileLength - 1) / tileLength;
    uint64_t tilesPerCore = (totalTiles + cores - 1) / cores;
    tiling->tileLength = tileLength;
    tiling->totalLength = totalLength;
    tiling->blockNum = static_cast<uint32_t>((totalTiles + tilesPerCore - 1) / tilesPerCore);
    tiling->numPerCore = tilesPerCore * tileLength;
    tiling->tailNumLastCore = totalLength - tiling->numPerCore * (tiling->blockNum - 1);
    *coresOut = cores;
    return 0;
}

int launch(const void *aDev, const void *bDev, void *outDev, int64_t n, int deviceId)
{
    AddTilingData tiling{};
    int64_t cores = 0;
    if (build_tiling(n, deviceId, &tiling, &cores) != 0) {
        return 1;
    }
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        return 1;
    }
    uint8_t *tilingDevice = nullptr;
    int rc = 1;
    if (aclrtMalloc(reinterpret_cast<void **>(&tilingDevice), sizeof(AddTilingData),
                    ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
        aclrtMemcpy(tilingDevice, sizeof(AddTilingData), &tiling, sizeof(AddTilingData),
                    ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS) {
        elementwise_add_kernel<<<tiling.blockNum, nullptr, stream>>>(
            reinterpret_cast<uint8_t *>(const_cast<void *>(aDev)),
            reinterpret_cast<uint8_t *>(const_cast<void *>(bDev)),
            reinterpret_cast<uint8_t *>(outDev), tilingDevice);
        rc = (aclrtSynchronizeStream(stream) == ACL_SUCCESS) ? 0 : 1;
    }
    if (tilingDevice != nullptr) {
        aclrtFree(tilingDevice);
    }
    aclrtDestroyStream(stream);
    return rc;
}

}  // namespace

extern "C" {

int elementwise_add_run(const void *aDev, const void *bDev, void *outDev,
                        int64_t n, int dtypeCode, int deviceId)
{
    if (aDev == nullptr || bDev == nullptr || outDev == nullptr) {
        return 2;  // REJECT_BAD_ARGS
    }
    if (dtypeCode != DTYPE_CODE_FLOAT32) {
        return 5;  // REJECT_UNSUPPORTED_DTYPE
    }
    if (n < N_MIN || n > N_MAX) {
        return 4;  // REJECT_N_OUT_OF_RANGE
    }
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        return 1;
    }
    return launch(aDev, bDev, outDev, n, deviceId);
}

const char *elementwise_add_abi_version(void)
{
    return "opx-python-abi/1";
}

}  // extern "C"
