{
  "schema": "opx-cases/1",
  "op": "elementwise_add",
  "spec_version": 1,
  "dtype": "float32",
  "criteria_ref": "ops-precision-standard@1",
  "constraints": {
    "n_min": 1,
    "n_max": 1048576,
    "same_shape": true,
    "broadcasting": false,
    "supported_dtypes": ["float32"],
    "invalid_shape_behavior": "reject",
    "unsupported_dtype_behavior": "reject"
  },
  "case_groups": ["常规", "边界", "数值边界", "异常", "回归"],
  "cases": [
    {
      "case_id": "add_norm_001",
      "group": "常规",
      "required": true,
      "n_a": 4096,
      "n_b": 4096,
      "dtype": "float32",
      "gen_a": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "gen_b": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "seed": 20261015,
      "expected": "match",
      "note": "典型尺寸；4096 = TILE_LENGTH，整除无尾块"
    },
    {
      "case_id": "add_norm_002",
      "group": "常规",
      "required": true,
      "n_a": 65536,
      "n_b": 65536,
      "dtype": "float32",
      "gen_a": {"dist": "normal", "mean": 0.0, "std": 1.0},
      "gen_b": {"dist": "normal", "mean": 0.0, "std": 1.0},
      "seed": 20261016,
      "expected": "match",
      "note": "多核切分（16 个 TILE）"
    },
    {
      "case_id": "add_norm_003",
      "group": "常规",
      "required": true,
      "n_a": 1048576,
      "n_b": 1048576,
      "dtype": "float32",
      "gen_a": {"dist": "normal", "mean": 0.0, "std": 1.0},
      "gen_b": {"dist": "normal", "mean": 0.0, "std": 1.0},
      "seed": 20261017,
      "expected": "match",
      "note": "N 上界（1M 元素，8 MB/张量）"
    },
    {
      "case_id": "add_norm_004",
      "group": "常规",
      "required": true,
      "n_a": 8192,
      "n_b": 8192,
      "dtype": "float32",
      "gen_a": {"dist": "uniform", "low": 1000000.0, "high": 10000000.0},
      "gen_b": {"dist": "uniform", "low": 1000000.0, "high": 10000000.0},
      "seed": 20261018,
      "expected": "match",
      "note": "大值域（rtol 项生效，检查相对精度）"
    },
    {
      "case_id": "add_edge_001",
      "group": "边界",
      "required": true,
      "n_a": 1,
      "n_b": 1,
      "dtype": "float32",
      "gen_a": {"dist": "const", "value": 1.5},
      "gen_b": {"dist": "const", "value": 2.5},
      "seed": 20261019,
      "expected": "match",
      "note": "最小合法 N=1 单元素"
    },
    {
      "case_id": "add_edge_002",
      "group": "边界",
      "required": true,
      "n_a": 4095,
      "n_b": 4095,
      "dtype": "float32",
      "gen_a": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "gen_b": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "seed": 20261020,
      "expected": "match",
      "note": "TILE_LENGTH-1：尾块不满一个 TILE"
    },
    {
      "case_id": "add_edge_003",
      "group": "边界",
      "required": true,
      "n_a": 4097,
      "n_b": 4097,
      "dtype": "float32",
      "gen_a": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "gen_b": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "seed": 20261021,
      "expected": "match",
      "note": "TILE_LENGTH+1：尾块只有 1 个元素"
    },
    {
      "case_id": "add_edge_004",
      "group": "边界",
      "required": true,
      "n_a": 8191,
      "n_b": 8191,
      "dtype": "float32",
      "gen_a": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "gen_b": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "seed": 20261022,
      "expected": "match",
      "note": "非 32B 对齐（8191×4=32764 B，不是 32 的整数倍）"
    },
    {
      "case_id": "add_edge_005",
      "group": "边界",
      "required": true,
      "n_a": 1048575,
      "n_b": 1048575,
      "dtype": "float32",
      "gen_a": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "gen_b": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "seed": 20261023,
      "expected": "match",
      "note": "N 上界-1：尾块落在最后一个核"
    },
    {
      "case_id": "add_edge_006",
      "group": "边界",
      "required": true,
      "n_a": 262144,
      "n_b": 262144,
      "dtype": "float32",
      "gen_a": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "gen_b": {"dist": "uniform", "low": -1.0, "high": 1.0},
      "seed": 20261033,
      "expected": "match",
      "note": "64 个 TILE：逼出「每核 >1 个分块」这条路（CANNBot 模板的 add 样例在这里有洞——不按 TILE 推进 GM 偏移，2026-10-15 实测 1M 用例时暴露：每核只算了第一个 TILE）"
    },
    {
      "case_id": "add_num_001",
      "group": "数值边界",
      "required": true,
      "n_a": 4096,
      "n_b": 4096,
      "dtype": "float32",
      "gen_a": {"dist": "zeros"},
      "gen_b": {"dist": "zeros"},
      "seed": 20261024,
      "expected": "match",
      "note": "零值（0+0）"
    },
    {
      "case_id": "add_num_002",
      "group": "数值边界",
      "required": true,
      "n_a": 4096,
      "n_b": 4096,
      "dtype": "float32",
      "gen_a": {"dist": "zeros"},
      "gen_b": {"dist": "const", "value": 1e-45},
      "seed": 20261025,
      "expected": "match",
      "note": "次正规数量级（NPU 若 flush-to-zero，误差 1e-45 远在 atol 内）"
    },
    {
      "case_id": "add_num_003",
      "group": "数值边界",
      "required": true,
      "n_a": 4096,
      "n_b": 4096,
      "dtype": "float32",
      "gen_a": {"dist": "uniform", "low": -10000000.0, "high": 10000000.0},
      "gen_b": {"dist": "uniform", "low": -10000000.0, "high": 10000000.0},
      "seed": 20261026,
      "expected": "match",
      "note": "正负混合、量级接近 → 相消，绝对误差最敏感"
    },
    {
      "case_id": "add_num_004",
      "group": "数值边界",
      "required": true,
      "n_a": 4096,
      "n_b": 4096,
      "dtype": "float32",
      "gen_a": {"dist": "special", "leading": ["nan", "inf", "-inf", "float32_max"]},
      "gen_b": {"dist": "const", "value": 1.0},
      "seed": 20261027,
      "expected": "match",
      "note": "NaN/Inf 传播（规格 unknowns 项：用实测给出结论——NaN→NaN、±Inf→同号 Inf、上溢→Inf）"
    },
    {
      "case_id": "add_num_005",
      "group": "数值边界",
      "required": true,
      "n_a": 4096,
      "n_b": 4096,
      "dtype": "float32",
      "gen_a": {"dist": "const", "value": 3.4028235e38},
      "gen_b": {"dist": "const", "value": 3.4028235e38},
      "seed": 20261028,
      "expected": "match",
      "note": "fp32 上溢 → Inf（IEEE 语义；标杆在 fp64 求和后按 fp32 舍入同样是 Inf）"
    },
    {
      "case_id": "add_bad_001",
      "group": "异常",
      "required": true,
      "n_a": 0,
      "n_b": 0,
      "dtype": "float32",
      "gen_a": {"dist": "zeros"},
      "gen_b": {"dist": "zeros"},
      "seed": 20261029,
      "expected": "reject",
      "expect_reject_code": "REJECT_N_OUT_OF_RANGE",
      "note": "N=0：空输入合法？规格 v1 明确 empty_input_valid=false → 必须拒绝"
    },
    {
      "case_id": "add_bad_002",
      "group": "异常",
      "required": true,
      "n_a": 1048577,
      "n_b": 1048577,
      "dtype": "float32",
      "gen_a": {"dist": "zeros"},
      "gen_b": {"dist": "zeros"},
      "seed": 20261030,
      "expected": "reject",
      "expect_reject_code": "REJECT_N_OUT_OF_RANGE",
      "note": "N 超上界（1M+1）"
    },
    {
      "case_id": "add_bad_003",
      "group": "异常",
      "required": true,
      "n_a": 4096,
      "n_b": 4095,
      "dtype": "float32",
      "gen_a": {"dist": "zeros"},
      "gen_b": {"dist": "zeros"},
      "seed": 20261031,
      "expected": "reject",
      "expect_reject_code": "REJECT_SHAPE_MISMATCH",
      "note": "形状不一致（规格 v1：broadcasting=false，同 shape 是硬约束）"
    },
    {
      "case_id": "add_bad_004",
      "group": "异常",
      "required": true,
      "n_a": 4096,
      "n_b": 4096,
      "dtype": "float16",
      "gen_a": {"dist": "zeros"},
      "gen_b": {"dist": "zeros"},
      "seed": 20261032,
      "expected": "reject",
      "expect_reject_code": "REJECT_UNSUPPORTED_DTYPE",
      "note": "规格 v1 支持范围只有 float32 → float16 必须拒绝"
    }
  ]
}
