// ============================================================================
// bid_elementwise_sub_review_01 · Host 直调层 + main 入口
// ============================================================================
// 由 elementwise_sub 的直调工程改造（同调用协议 / 同 EXEC 标记 / 同拒绝码）。
//
// 调用契约（`tools/run_cases.py`，与 elementwise_sub 完全一致）：
//   bid_elementwise_sub_review_01 --n-a <N> --n-b <M> --dtype float32 --in-a <a.bin> --in-b <b.bin> --out <y.bin>
//   输入/输出都是**裸二进制**（float32，无头部），元素数分别为 N / M / N。
//
// 退出码与拒绝码（规格 v4：非法 shape / 不支持的 dtype 一律 reject）：
//   0  成功（stdout 打印 EXEC 标记行 + OK）
//   2  REJECT_BAD_ARGS            参数缺失/未知参数
//   3  REJECT_SHAPE_MISMATCH      N_A ≠ N_B（v4：不广播，必须同 shape）
//   4  REJECT_N_OUT_OF_RANGE      N ∉ [1, 1048576]
//   5  REJECT_UNSUPPORTED_DTYPE   dtype ≠ float32
//   1  运行失败（ACL/设备/读写文件）
// ============================================================================

#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <cerrno>
#include <iostream>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/bid_elementwise_sub_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件（包含 kernel_operator.h）
#include "../op_kernel/bid_elementwise_sub_kernel.asc"

//: 本实现支持的 dtype（规格 v4：只 float32）
static constexpr const char *SUPPORTED_DTYPE = "float32";
//: 架构标签（与 CMakeLists 的 --npu-arch 一致；进 EXEC 标记行，用于证明跑的是候选路径）
static constexpr const char *NPU_ARCH = "dav-2201";

struct ArgInfo {
    std::string fileName;
    size_t length;
};

static void reject(const char *code, const std::string &detail)
{
    std::cout << "REJECT_" << code << " " << detail << std::endl;
    std::cout.flush();
}

// 严格整型解析：必须完整消费整个字符串（无前后缀残留）、无溢出，否则失败。
static bool ParseInt64(const std::string &s, int64_t *out)
{
    if (s.empty()) {
        return false;
    }
    errno = 0;
    char *end = nullptr;
    long long v = strtoll(s.c_str(), &end, 10);
    if (errno == ERANGE || end == s.c_str() || *end != '\0') {
        return false;
    }
    *out = static_cast<int64_t>(v);
    return true;
}

// [PATTERN] KernelCall 封装 - 处理完整的核函数调用流程（沿用样例结构，tiling 用共享的 BuildTiling）
// 返回 0 成功 / 1 失败：逐步校验 allocate/copy/sync/ReadFile/WriteFile 返回码，失败即传播并清理已获取资源。
int KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    BidSubTilingData &tiling)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size(), nullptr);
    std::vector<uint8_t *> inputDevice(inputsInfo.size(), nullptr);
    std::vector<uint8_t *> outputHost(outputsInfo.size(), nullptr);
    std::vector<uint8_t *> outputDevice(outputsInfo.size(), nullptr);
    uint8_t *tilingDevice = nullptr;
    int rc = 1;

    if (aclrtMalloc(reinterpret_cast<void **>(&tilingDevice), sizeof(BidSubTilingData),
                    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc(tiling) failed" << std::endl;
        goto cleanup;
    }
    if (aclrtMemcpy(tilingDevice, sizeof(BidSubTilingData), (void *)&tiling,
                    sizeof(BidSubTilingData), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy(tiling H2D) failed" << std::endl;
        goto cleanup;
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        if (aclrtMallocHost(reinterpret_cast<void **>(&inputHost[i]), inputsInfo[i].length) != ACL_SUCCESS) {
            std::cerr << "aclrtMallocHost(inputHost[" << i << "]) failed" << std::endl;
            goto cleanup;
        }
        if (aclrtMalloc(reinterpret_cast<void **>(&inputDevice[i]), inputsInfo[i].length,
                        ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
            std::cerr << "aclrtMalloc(inputDevice[" << i << "]) failed" << std::endl;
            goto cleanup;
        }
        if (!ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length)) {
            std::cerr << "ReadFile(" << inputsInfo[i].fileName << ") failed" << std::endl;
            goto cleanup;
        }
        if (aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
                        inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
            std::cerr << "aclrtMemcpy(input H2D[" << i << "]) failed" << std::endl;
            goto cleanup;
        }
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        if (aclrtMallocHost(reinterpret_cast<void **>(&outputHost[i]), outputsInfo[i].length) != ACL_SUCCESS) {
            std::cerr << "aclrtMallocHost(outputHost[" << i << "]) failed" << std::endl;
            goto cleanup;
        }
        if (aclrtMalloc(reinterpret_cast<void **>(&outputDevice[i]), outputsInfo[i].length,
                        ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
            std::cerr << "aclrtMalloc(outputDevice[" << i << "]) failed" << std::endl;
            goto cleanup;
        }
    }

    bid_elementwise_sub_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1],
        outputDevice[0], tilingDevice);
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
        std::cerr << "aclrtSynchronizeStream(kernel launch) failed" << std::endl;
        goto cleanup;
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        if (aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
                        outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            std::cerr << "aclrtMemcpy(output D2H[" << i << "]) failed" << std::endl;
            goto cleanup;
        }
        if (!WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length)) {
            std::cerr << "WriteFile(" << outputsInfo[i].fileName << ") failed" << std::endl;
            goto cleanup;
        }
    }

    rc = 0;

cleanup:
    if (tilingDevice != nullptr) {
        aclrtFree(tilingDevice);
    }
    for (size_t i = 0; i < inputDevice.size(); i++) {
        if (inputDevice[i] != nullptr) {
            aclrtFree(inputDevice[i]);
        }
        if (inputHost[i] != nullptr) {
            aclrtFreeHost(inputHost[i]);
        }
    }
    for (size_t i = 0; i < outputDevice.size(); i++) {
        if (outputDevice[i] != nullptr) {
            aclrtFree(outputDevice[i]);
        }
        if (outputHost[i] != nullptr) {
            aclrtFreeHost(outputHost[i]);
        }
    }
    return rc;
}

int32_t main(int32_t argc, char *argv[])
{
    std::string inA, inB, outFile, dtype;
    int64_t nA = -1, nB = -1;
    bool hasNA = false, hasNB = false;

    // 参数必须以 --key value 成对出现；参数总数为奇数（存在孤立尾部参数）即严格拒绝。
    if ((argc - 1) % 2 != 0) {
        reject("BAD_ARGS", "参数必须成对出现（存在孤立尾部参数）");
        return 2;
    }
    for (int32_t i = 1; i + 1 < argc; i += 2) {
        std::string key = argv[i];
        std::string val = argv[i + 1];
        if (key == "--n-a") {
            if (!ParseInt64(val, &nA)) { reject("BAD_ARGS", "n-a 非完整十进制整数（或溢出）: " + val); return 2; }
            hasNA = true;
        } else if (key == "--n-b") {
            if (!ParseInt64(val, &nB)) { reject("BAD_ARGS", "n-b 非完整十进制整数（或溢出）: " + val); return 2; }
            hasNB = true;
        } else if (key == "--dtype") {
            dtype = val;
        } else if (key == "--in-a") {
            inA = val;
        } else if (key == "--in-b") {
            inB = val;
        } else if (key == "--out") {
            outFile = val;
        } else {
            reject("BAD_ARGS", "unknown key " + key);
            return 2;
        }
    }
    if (!hasNA || !hasNB || dtype.empty() || inA.empty() || inB.empty() || outFile.empty()) {
        std::cout << "REJECT_BAD_ARGS 用法：bid_elementwise_sub_review_01 --n-a N --n-b M --dtype float32 "
                     "--in-a a.bin --in-b b.bin --out y.bin" << std::endl;
        return 2;
    }

    // ---- 调用接口层的输入校验（规格 v4 要求 reject，而不是静默截断或偷偷广播）----
    if (dtype != SUPPORTED_DTYPE) {
        reject("UNSUPPORTED_DTYPE", "dtype=" + dtype + "（本版只支持 " + SUPPORTED_DTYPE + "）");
        return 5;
    }
    if (nA != nB) {
        reject("SHAPE_MISMATCH", "n_a=" + std::to_string(nA) + " n_b=" + std::to_string(nB)
               + "（规格 v4：不广播，必须同 shape）");
        return 3;
    }
    if (nA < N_MIN || nA > N_MAX) {
        reject("N_OUT_OF_RANGE", "n=" + std::to_string(nA) + "（合法范围 ["
               + std::to_string(N_MIN) + ", " + std::to_string(N_MAX) + "]）");
        return 4;
    }

    auto ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        printf("aclInit failed, ret=%d\n", ret);
        return 1;
    }
    int32_t deviceId = 0;
    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        aclFinalize();
        return 1;
    }

    // 核数以运行时 aclrtGetDeviceInfo 为准（必须在 aclrtSetDevice 之后）；无效时回落 DEFAULT_CORE_NUM。
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS || availableCoreNum <= 0) {
        availableCoreNum = DEFAULT_CORE_NUM;
    }

    uint32_t totalLength = static_cast<uint32_t>(nA);
    size_t inputByteSize = static_cast<size_t>(totalLength) * sizeof(float);
    size_t outputByteSize = inputByteSize;

    BidSubTilingData tiling;
    // 分核逻辑统一在 op_kernel/bid_elementwise_sub_tiling.h，可执行文件与共享库共用（避免两份漂移）
    BuildTiling(totalLength, static_cast<uint32_t>(availableCoreNum), &tiling);

    // 证明跑的是候选算子路径（用例执行器要求这一行；缺了会被判 INVALID，而不是「过了」）
    std::cout << "EXEC op=bid_elementwise_sub_review_01 kernel=bid_elementwise_sub_kernel arch=" << NPU_ARCH
              << " impl=ascendc-direct-invoke" << std::endl;

    std::vector<ArgInfo> inputsInfo = {
        {inA, inputByteSize},
        {inB, inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {outFile, outputByteSize}
    };

    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        printf("aclrtCreateStream failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 1;
    }

    int kernelRc = KernelCall(tiling.blockNum, stream, inputsInfo, outputsInfo, tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    if (kernelRc != 0) {
        std::cerr << "KernelCall 运行失败（退出码 1）" << std::endl;
        return 1;
    }

    std::cout << "OK n=" << totalLength << " dtype=" << SUPPORTED_DTYPE
              << " blocks=" << tiling.blockNum << " cores=" << availableCoreNum << std::endl;
    return 0;
}