// ============================================================================
// bid_elementwise_sub_review_01 · Python 调用接口的 C ABI
// ============================================================================
// 供 ops/bid_elementwise_sub_review_01/python/bid_elementwise_sub_review_01.py 用 ctypes 加载
// （libbid_elementwise_sub_review_01_host.so）。
//
// ABI（与 docs/reference/deliverable-standards.md 一致）：
//   int  bid_elementwise_sub_review_01_run(const void *a_dev, const void *b_dev, void *out_dev,
//                                         int64_t n, int dtype_code, int device_id);
//       y = a - b；dtype_code: 0 = float32
//   const char *bid_elementwise_sub_review_01_abi_version(void);   // "opx-python-abi/1"
//
// 无 scale / 无 alpha / 无 opMode（规格 v4 语义固定 y = a - b）；包装层不做任何数值计算（编码规则 A1）。
//
// 约束：不 aclInit / 不 aclrtResetDevice / 不 aclFinalize —— Python 进程里 torch_npu 可能已初始化
// ACL 上下文，生命周期交给调用方；本库只 aclrtSetDevice + 查询核数 + 建流 + 同步。
// 返回码与可执行文件一致：0 成功 / 1 运行失败 / 2 REJECT_BAD_ARGS / 4 REJECT_N_OUT_OF_RANGE /
// 5 REJECT_UNSUPPORTED_DTYPE。
// ============================================================================

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "../op_kernel/bid_elementwise_sub_tiling.h"

// 与可执行文件共用同一份 kernel（device 侧代码在共享库里同样打进去）
#include "../op_kernel/bid_elementwise_sub_kernel.asc"

namespace {

constexpr int DTYPE_CODE_FLOAT32 = 0;

int launch(const void *aDev, const void *bDev, void *outDev, int64_t n, int deviceId)
{
    // 核数以运行时 aclrtGetDeviceInfo 为准（调用方已 aclrtSetDevice）；无效时回落 DEFAULT_CORE_NUM。
    uint32_t coreNum = DEFAULT_CORE_NUM;
    int64_t queried = 0;
    if (aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &queried) == ACL_SUCCESS &&
        queried > 0) {
        coreNum = static_cast<uint32_t>(queried);
    }

    BidSubTilingData tiling{};
    BuildTiling(static_cast<uint64_t>(n), coreNum, &tiling);
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        return 1;
    }
    uint8_t *tilingDevice = nullptr;
    int rc = 1;
    if (aclrtMalloc(reinterpret_cast<void **>(&tilingDevice), sizeof(BidSubTilingData),
                    ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
        aclrtMemcpy(tilingDevice, sizeof(BidSubTilingData), &tiling, sizeof(BidSubTilingData),
                    ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS) {
        bid_elementwise_sub_kernel<<<tiling.blockNum, nullptr, stream>>>(
            reinterpret_cast<uint8_t *>(const_cast<void *>(aDev)),
            reinterpret_cast<uint8_t *>(const_cast<void *>(bDev)),
            reinterpret_cast<uint8_t *>(outDev), tilingDevice);
        rc = (aclrtSynchronizeStream(stream) == ACL_SUCCESS) ? 0 : 1;
    }
    if (tilingDevice != nullptr) {
        aclrtFree(tilingDevice);
    }
    aclrtDestroyStream(stream);
    return rc;
}

}  // namespace

extern "C" {

int bid_elementwise_sub_review_01_run(const void *aDev, const void *bDev, void *outDev,
                                     int64_t n, int dtypeCode, int deviceId)
{
    if (aDev == nullptr || bDev == nullptr || outDev == nullptr) {
        return 2;  // REJECT_BAD_ARGS
    }
    if (dtypeCode != DTYPE_CODE_FLOAT32) {
        return 5;  // REJECT_UNSUPPORTED_DTYPE
    }
    if (n < N_MIN || n > N_MAX) {
        return 4;  // REJECT_N_OUT_OF_RANGE
    }
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        return 1;
    }
    return launch(aDev, bDev, outDev, n, deviceId);
}

const char *bid_elementwise_sub_review_01_abi_version(void)
{
    return "opx-python-abi/1";
}

}  // extern "C"