// ============================================================================
// Ascend C Kernel 实现 - bid_elementwise_sub_review_01（纯 kernel，不含 host 代码）
// ============================================================================
// 语义：y[i] = x1[i] - x2[i]（float32；同 shape 1-D 连续；不广播 / 无 alpha / 无 opMode）。
//
// 分核沿用 elementwise_add 的「常规分块」模型（blockNum / numPerCore / tailNumLastCore），
// tile 固定 8192 元素 / 单缓冲（DOUBLE_BUFFER=1）；计算固定 AscendC::Sub。
// 搬运统一 DataCopyPad（含 32B 对齐整块与非 32B 尾块）：storage_offset≠0 视图的主存基址不是
// 32B 对齐，DataCopy 在非对齐源上不适用（编码规则黑名单），故不区分整块/尾块、统一走 DataCopyPad，
// 与已验证参考 elementwise_sub 一致。
// ============================================================================

#include "kernel_operator.h"
#include "bid_elementwise_sub_tiling.h"

class KernelBidSub {
public:
    __aicore__ inline KernelBidSub(AscendC::TPipe *pipe)
    {
        pipe_ = pipe;
    }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const __gm__ BidSubTilingData *tilingData)
    {
        tiling = tilingData;
        tileLength = tiling->tileLength;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx >= tiling->blockNum) {
            // 防御：正常 blockNum <= coreNum，blockIdx 不会越界；此处兜底直接退出。
            tileNum = 0;
            return;
        }

        uint32_t total = 0;
        uint32_t tiles = 0;
        if (blockIdx < tiling->blockNum - 1) {
            total = static_cast<uint32_t>(tiling->numPerCore);
            tiles = total / tileLength;
            tailTileElementNum = tileLength;
        } else {
            total = static_cast<uint32_t>(tiling->tailNumLastCore);
            tiles = (total + tileLength - 1) / tileLength;
            tailTileElementNum = total - tileLength * (tiles - 1);
        }
        tileNum = tiles;

        uint64_t blockOffset = static_cast<uint64_t>(blockIdx) * tiling->numPerCore;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x) + blockOffset, total);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y) + blockOffset, total);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(z) + blockOffset, total);

        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(inQueueY, DOUBLE_BUFFER, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(outQueueZ, DOUBLE_BUFFER, TILE_LENGTH * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t offset = i * tileLength;
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : tileLength;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

    // 搬运长度恒为有效元素数 count：只搬运 count * sizeof(float) 字节（绝不向上取整到 32B），
    //   因此 GM 侧不读/写逻辑 in/out 元素之外的任何字节。非 32B 对齐的尾块由 DataCopyPad
    //   在 UB 侧补齐（GM 侧只移动有效字节），见 CopyIn / CopyOut。
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        uint32_t bytes = count * sizeof(float);
        // 非 32B 尾块（count%8 != 0）：rightPadding 按元素数填 (8 - count%8)，isPad=true、
        //   paddingValue=0，由 DataCopyPad 在 UB 侧补齐 32B（dummy=0）；GM 侧只读 bytes 有效字节。
        uint8_t rightPad = (count % VEC_ALIGN_LENGTH == 0)
            ? 0
            : static_cast<uint8_t>(VEC_ALIGN_LENGTH - count % VEC_ALIGN_LENGTH);
        AscendC::DataCopyPad(xLocal, xGm[offset],
            {1, static_cast<uint16_t>(bytes), 0, 0},
            {true, 0, rightPad, 0});
        AscendC::DataCopyPad(yLocal, yGm[offset],
            {1, static_cast<uint16_t>(bytes), 0, 0},
            {true, 0, rightPad, 0});
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        uint32_t vecCount = count / VEC_ALIGN_LENGTH * VEC_ALIGN_LENGTH;
        if (vecCount > 0) {
            AscendC::Sub(zLocal, xLocal, yLocal, vecCount);
        }
        // 不足 8 的标量收尾：上方向量段已覆盖 [0, vecCount)，这里只补 [vecCount, count)。
        for (uint32_t j = vecCount; j < count; j++) {
            zLocal.SetValue(j, xLocal.GetValue(j) - yLocal.GetValue(j));
        }

        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        uint32_t bytes = count * sizeof(float);
        // UB→GM：DataCopyPad 自动补齐 UB 读取所需 dummy 并在写回 GM 时丢弃，只写 bytes 有效字节。
        AscendC::DataCopyPad(zGm[offset], zLocal,
            {1, static_cast<uint16_t>(bytes), 0, 0});
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe *pipe_;
    const __gm__ BidSubTilingData *tiling;

    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;

    AscendC::TQue<AscendC::TPosition::VECIN, DOUBLE_BUFFER> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, DOUBLE_BUFFER> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, DOUBLE_BUFFER> outQueueZ;

    uint32_t tileLength;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口（可执行文件与共享库共用；名字进 EXEC 标记行）
extern "C" __global__ __vector__ void bid_elementwise_sub_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                                 GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelBidSub op(&pipe);
    op.Init(x, y, z, reinterpret_cast<__gm__ BidSubTilingData *>(tiling));
    op.Process();
}