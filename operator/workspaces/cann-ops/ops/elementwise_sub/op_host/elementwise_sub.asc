// ============================================================================
// elementwise_sub · Host 直调层 + main 入口
// ============================================================================
// 由 `ascendc-direct-invoke-template` 的 add_custom 样例经 elementwise_add 改造而来。
//
// 调用契约（`tools/run_cases.py` 按这个调用，**与 elementwise_add 完全一致**）：
//   elementwise_sub --n-a <N> --n-b <M> --dtype float32 --in-a <a.bin> --in-b <b.bin> --out <y.bin>
//   输入/输出都是**裸二进制**（float32，无头部），元素数分别为 N / M / N。
//   alpha 不在命令行上：协议固定 alpha=1（规格用例要求「未知参数必须拒绝」，所以协议本身是接口），
//   alpha≠1 与 out= 复用走 Python 接口（op_host/elementwise_sub_pyapi.asc）。
//
// 退出码与拒绝码（规格 v1：非法 shape / 不支持的 dtype 一律 reject）：
//   0  成功（stdout 打印 EXEC 标记行 + OK）
//   2  REJECT_BAD_ARGS            参数缺失/未知参数
//   3  REJECT_SHAPE_MISMATCH      N_A ≠ N_B（v1：不广播，必须同 shape）
//   4  REJECT_N_OUT_OF_RANGE      N ∉ [1, 1048576]
//   5  REJECT_UNSUPPORTED_DTYPE   dtype ≠ float32
//   1  运行失败（ACL/设备/读写文件）
// ============================================================================

#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <iostream>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/elementwise_sub_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件（包含 kernel_operator.h）
#include "../op_kernel/elementwise_sub_kernel.asc"

//: 规格 v1 的 N 上下界（与 cases/elementwise_sub/cases.json 的 constraints 一致）
static constexpr int64_t N_MIN = 1;
static constexpr int64_t N_MAX = 1048576;
//: 本实现支持的 dtype（规格 v1：只 float32）
static constexpr const char *SUPPORTED_DTYPE = "float32";
//: 架构标签（与 CMakeLists 的 --npu-arch 一致；进 EXEC 标记行，用于证明跑的是候选路径）
static constexpr const char *NPU_ARCH = "dav-2201";

struct ArgInfo {
    std::string fileName;
    size_t length;
};

static void reject(const char *code, const std::string &detail)
{
    std::cout << "REJECT_" << code << " " << detail << std::endl;
    std::cout.flush();
}

// [PATTERN] KernelCall 封装 - 处理完整的核函数调用流程（沿用样例结构，tiling 改用共享的 BuildTiling）
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    SubTilingData &tiling)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(SubTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(SubTilingData), (void *)&tiling,
        sizeof(SubTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    elementwise_sub_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1],
        outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    std::string inA, inB, outFile, dtype;
    int64_t nA = -1, nB = -1;
    for (int32_t i = 1; i + 1 < argc; i += 2) {
        std::string key = argv[i];
        std::string val = argv[i + 1];
        if (key == "--n-a") nA = strtoll(val.c_str(), nullptr, 10);
        else if (key == "--n-b") nB = strtoll(val.c_str(), nullptr, 10);
        else if (key == "--dtype") dtype = val;
        else if (key == "--in-a") inA = val;
        else if (key == "--in-b") inB = val;
        else if (key == "--out") outFile = val;
        else { std::cout << "REJECT_BAD_ARGS unknown key " << key << std::endl; return 2; }
    }
    if (nA < 0 || nB < 0 || dtype.empty() || inA.empty() || inB.empty() || outFile.empty()) {
        std::cout << "REJECT_BAD_ARGS 用法：elementwise_sub --n-a N --n-b M --dtype float32 "
                     "--in-a a.bin --in-b b.bin --out y.bin" << std::endl;
        return 2;
    }

    // ---- 调用接口层的输入校验（规格 v1 要求 reject，而不是静默截断或偷偷广播）----
    if (dtype != SUPPORTED_DTYPE) {
        reject("UNSUPPORTED_DTYPE", "dtype=" + dtype + "（本版只支持 " + SUPPORTED_DTYPE + "）");
        return 5;
    }
    if (nA != nB) {
        reject("SHAPE_MISMATCH", "n_a=" + std::to_string(nA) + " n_b=" + std::to_string(nB)
               + "（规格 v1：不广播，必须同 shape）");
        return 3;
    }
    if (nA < N_MIN || nA > N_MAX) {
        reject("N_OUT_OF_RANGE", "n=" + std::to_string(nA) + "（合法范围 ["
               + std::to_string(N_MIN) + ", " + std::to_string(N_MAX) + "]）");
        return 4;
    }

    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return 1;
    }

    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return 1;
    }

    uint32_t totalLength = static_cast<uint32_t>(nA);
    size_t inputByteSize = static_cast<size_t>(totalLength) * sizeof(float);
    size_t outputByteSize = inputByteSize;

    SubTilingData tiling;
    // 分核逻辑统一在 op_kernel/elementwise_sub_tiling.h，可执行文件与共享库共用（避免两份漂移）
    BuildTiling(totalLength, OP_MODE_SUB, 1.0f, static_cast<uint32_t>(availableCoreNum), &tiling);

    // 证明跑的是候选算子路径（用例执行器要求这一行；缺了会被判 INVALID，而不是「过了」）
    std::cout << "EXEC op=elementwise_sub kernel=elementwise_sub_kernel arch=" << NPU_ARCH
              << " impl=ascendc-direct-invoke" << std::endl;

    std::vector<ArgInfo> inputsInfo = {
        {inA, inputByteSize},
        {inB, inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {outFile, outputByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(tiling.blockNum, stream, inputsInfo, outputsInfo, tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    std::cout << "OK n=" << totalLength << " dtype=" << SUPPORTED_DTYPE
              << " blocks=" << tiling.blockNum << " cores=" << availableCoreNum << std::endl;
    return 0;
}
