// ============================================================================
// elementwise_sub · Python 调用接口的 C ABI
// ============================================================================
// 供 ops/elementwise_sub/python/elementwise_sub.py 用 ctypes 加载（libelementwise_sub_host.so）。
//
// ABI（与 docs/reference/deliverable-standards.md 一致）：
//   int  elementwise_sub_run(const void *a_dev, const void *b_dev, void *out_dev,
//                            int64_t n, int dtype_code, int device_id);
//       y = a - b；dtype_code: 0 = float32
//   int  elementwise_sub_scale_run(const void *x_dev, void *out_dev,
//                                  int64_t n, float alpha, int device_id);
//       out = x * alpha（fp32 单次乘；保留的辅助入口，**不是** alpha≠1 的实现路径）
//   int  elementwise_sub_alpha_run(const void *a_dev, const void *b_dev, void *out_dev,
//                                  int64_t n, float alpha, int device_id);
//       y = a - alpha*b，**单次求值**：fp64 中间量算完再舍入到 fp32（规格 oracle 口径）
//   const char *elementwise_sub_abi_version(void);   // "opx-python-abi/1"
//
// alpha≠1 的实现：**一次** alpha_run 调用，kernel 内部按 fp64 中间量求 a - alpha*b 后单次舍入。
// 早期版本用「scale_run（m = alpha*b）+ run（y = a - m）」两次调用去模仿 torch 的舍入点，已废弃：
// 那样会在 alpha*b 处多一次 fp32 舍入，与 oracle 不一致，且 alpha*b 溢出时得到 inf/-inf
// （实测 a=b=FLT_MAX、alpha=2：torch NPU 给 -inf，torch CPU / oracle 给 -3.4e38，判据要求后者）。
// 包装层仍然不做任何数值计算（编码规则 A1）。
//
// 约束：不 aclInit / 不 aclrtResetDevice / 不 aclFinalize —— Python 进程里 torch_npu 可能已初始化
// ACL 上下文，生命周期交给调用方；本库只 aclrtSetDevice + 建流 + 同步。
// 返回码与可执行文件一致：0 成功 / 1 运行失败 / 2 REJECT_BAD_ARGS / 4 REJECT_N_OUT_OF_RANGE /
// 5 REJECT_UNSUPPORTED_DTYPE。
// ============================================================================

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "../op_kernel/elementwise_sub_tiling.h"

// 与可执行文件共用同一份 kernel（device 侧代码在共享库里同样打进去）
#include "../op_kernel/elementwise_sub_kernel.asc"

namespace {

constexpr int64_t N_MIN = 1;
constexpr int64_t N_MAX = 1048576;
constexpr int DTYPE_CODE_FLOAT32 = 0;

int launch(const void *aDev, const void *bDev, void *outDev, int64_t n,
           uint32_t opMode, float alpha, int deviceId)
{
    // 分核逻辑与可执行文件共用 tiling.h 的 BuildTiling；核数用常量 DEFAULT_CORE_NUM
    // （910B1 AIV=48），不再每次调用走 aclrtGetDeviceInfo —— 小 shape 每次调用省一次设备查询。
    SubTilingData tiling{};
    BuildTiling(static_cast<uint64_t>(n), opMode, alpha, DEFAULT_CORE_NUM, &tiling);
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        return 1;
    }
    uint8_t *tilingDevice = nullptr;
    int rc = 1;
    if (aclrtMalloc(reinterpret_cast<void **>(&tilingDevice), sizeof(SubTilingData),
                    ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
        aclrtMemcpy(tilingDevice, sizeof(SubTilingData), &tiling, sizeof(SubTilingData),
                    ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS) {
        elementwise_sub_kernel<<<tiling.blockNum, nullptr, stream>>>(
            reinterpret_cast<uint8_t *>(const_cast<void *>(aDev)),
            reinterpret_cast<uint8_t *>(const_cast<void *>(bDev)),
            reinterpret_cast<uint8_t *>(outDev), tilingDevice);
        rc = (aclrtSynchronizeStream(stream) == ACL_SUCCESS) ? 0 : 1;
    }
    if (tilingDevice != nullptr) {
        aclrtFree(tilingDevice);
    }
    aclrtDestroyStream(stream);
    return rc;
}

}  // namespace

extern "C" {

int elementwise_sub_run(const void *aDev, const void *bDev, void *outDev,
                        int64_t n, int dtypeCode, int deviceId)
{
    if (aDev == nullptr || bDev == nullptr || outDev == nullptr) {
        return 2;  // REJECT_BAD_ARGS
    }
    if (dtypeCode != DTYPE_CODE_FLOAT32) {
        return 5;  // REJECT_UNSUPPORTED_DTYPE
    }
    if (n < N_MIN || n > N_MAX) {
        return 4;  // REJECT_N_OUT_OF_RANGE
    }
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        return 1;
    }
    return launch(aDev, bDev, outDev, n, OP_MODE_SUB, 1.0f, deviceId);
}

int elementwise_sub_scale_run(const void *xDev, void *outDev, int64_t n, float alpha, int deviceId)
{
    if (xDev == nullptr || outDev == nullptr) {
        return 2;  // REJECT_BAD_ARGS
    }
    if (n < N_MIN || n > N_MAX) {
        return 4;  // REJECT_N_OUT_OF_RANGE
    }
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        return 1;
    }
    // scale 路径只读 x；b 指针传 nullptr，kernel 在该模式下不解引用第二个输入
    return launch(xDev, nullptr, outDev, n, OP_MODE_SCALE, alpha, deviceId);
}

int elementwise_sub_alpha_run(const void *aDev, const void *bDev, void *outDev,
                              int64_t n, float alpha, int deviceId)
{
    if (aDev == nullptr || bDev == nullptr || outDev == nullptr) {
        return 2;  // REJECT_BAD_ARGS
    }
    if (n < N_MIN || n > N_MAX) {
        return 4;  // REJECT_N_OUT_OF_RANGE
    }
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        return 1;
    }
    // 单次求值：kernel 内部按 fp64 中间量算 a - alpha*b 再舍入（等价 oracle 单次舍入）
    return launch(aDev, bDev, outDev, n, OP_MODE_FMASUB, alpha, deviceId);
}

const char *elementwise_sub_abi_version(void)
{
    return "opx-python-abi/1";
}

}  // extern "C"
