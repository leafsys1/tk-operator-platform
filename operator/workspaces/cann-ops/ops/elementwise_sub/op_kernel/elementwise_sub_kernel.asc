/* Generated By CANNBot */

// ============================================================================
// Ascend C Kernel 实现 - elementwise_sub（纯 kernel，不含 host 代码）
// ============================================================================
// 语义：y = a - b（opMode=SUB）；辅助路径 y = a * alpha（opMode=SCALE，供 alpha≠1 的
//       y = a - alpha*b 使用，见 op_host/elementwise_sub_pyapi.asc 顶部说明）。
//
// 结构沿用 elementwise_add 已验证的三段式 + DoubleBuffer + DataCopyPad 尾块处理，
// 关键修正是「每块都推进 GM 偏移」（add 的 add_edge_006 曾暴露不推进的缺陷）。
//
// P0 分摊式 tiling（2026-10-28）：核 i 处理 [i × tileLength, totalLength)，每核 1 个 tile
// （小 shape 单核多轮），搬运量从「整 tile 循环」降到「均摊到每核」；尾块不再依赖
// 非 64 对齐的 DataCopyPad 写回（那会回落到 Scalar 格式），而是「向量化部分 + < 8 个标量零头」。
// ============================================================================

#include "kernel_operator.h"
#include "elementwise_sub_tiling.h"

class KernelSub {
public:
    __aicore__ inline KernelSub(AscendC::TPipe *pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const __gm__ SubTilingData *tilingData)
    {
        tiling = tilingData;
        tileLength = tiling->tileLength;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx >= tiling->blockNum) {
            // Core Shrink 后的多余核：直接退出，不做任何搬运
            workLength = 0;
            tileNum = 0;
            return;
        }
        // 每个核的处理长度独立算：blockIdx × tileLength 到下一个核的起点，最后一个 core 到 N。
        // 这样「tile 封顶 MAX_TILE_LENGTH、尾核吃掉剩余」与「均分、尾核只处理 tailTileLength」
        // 两种情况用同一套逻辑；尾核的中间轮仍是满 tileLength，只有最后一轮是零头。
        uint64_t start = static_cast<uint64_t>(blockIdx) * tileLength;
        uint64_t end = static_cast<uint64_t>(blockIdx + 1) * tileLength;
        if (blockIdx == tiling->blockNum - 1) {
            end = tiling->totalLength;   // 尾核兜到 N（单核时 start=0，即整个 [0,N)）
        }
        workLength = static_cast<uint32_t>(end - start);
        tileNum = (workLength + tileLength - 1) / tileLength;
        tailTileElementNum = workLength - tileLength * (tileNum - 1);

        uint64_t blockOffset = start;
        xGm.SetGlobalBuffer((__gm__ float *)x + blockOffset, workLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockOffset, workLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockOffset, workLength);

        // UB buffer 按最大 tile 分配：tileLength 运行时可调（8 ~ 4096）
        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER, MAX_TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(inQueueY, DOUBLE_BUFFER, MAX_TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(outQueueZ, DOUBLE_BUFFER, MAX_TILE_LENGTH * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t offset = i * tileLength;
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : tileLength;
            CopyIn(offset, count);
            Compute(count, offset);
            CopyOut(offset, count);
        }
    }

    // 搬运长度：最后一轮（尾块）且 count 不是 8 的整数倍时，向上对齐到 8 元素（32B）。
    //   多余读：GM 侧最多多读 7 个元素（输入缓冲由调用方按 32B 对齐分配，不越界）；
    //   多余写：写回 z 的尾块最多多写 7 个元素，仅覆盖对齐填充位（同一函数传入的 out 缓冲
    //           由调用方按「N × 4B 向上对齐 32B」分配，见 ops/elementwise_sub/python/elementwise_sub.py）。
    __aicore__ inline uint32_t CopyLength(uint32_t count, bool isLast) const
    {
        if (!isLast || (count % VEC_ALIGN_LENGTH) == 0) {
            return count;
        }
        return (count + VEC_ALIGN_LENGTH - 1) / VEC_ALIGN_LENGTH * VEC_ALIGN_LENGTH;
    }

    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        uint32_t copyLen = CopyLength(count, offset + count == workLength);
        uint32_t bytes = copyLen * sizeof(float);
        // DataCopyPad 的 blockLen 是 uint16：最大 65535 字节 = 16383 元素，tileLength ≤ 4096 天然满足
        AscendC::DataCopyPad(xLocal, xGm[offset],
            {1, static_cast<uint16_t>(bytes), 0, 0},
            {false, 0, 0, 0});
        // scale 模式下 b 指针是 nullptr（调用方只传一个输入）：绝不能对 nullptr 发 MTE2 搬运。
        // 实测缺陷：对 nullptr 发 DataCopyPad 时本次 kernel 仍“成功”，但**下一次** kernel launch
        // 会报 507057（SUSPECT REMOTE ERROR / "Launch kernel failure"），把后续用例一起带崩。
        if (tiling->opMode != OP_MODE_SCALE) {
            AscendC::DataCopyPad(yLocal, yGm[offset],
                {1, static_cast<uint16_t>(bytes), 0, 0},
                {false, 0, 0, 0});
        }

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count, uint32_t offset)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        // 尾块 count 不是 8 的倍数时，只对前 vecCount 个元素做向量运算，
        // 末尾 count - vecCount（< 8）个元素逐元素标量收尾。
        uint32_t vecCount = count / VEC_ALIGN_LENGTH * VEC_ALIGN_LENGTH;

        if (vecCount > 0) {
            if (tiling->opMode == OP_MODE_FMASUB) {
                // alpha≠1：y = a - alpha*b（fp32 先乘后减，与 torch 的求值顺序一致）。
                // 不用 fp64：DaVinci vector 核不支持 double（实测编译报错
                // "cast to/from double precision floating variable is not allowed in aicore function"）。
                float alpha = tiling->alpha;
                AscendC::Muls(zLocal, yLocal, alpha, vecCount);
                AscendC::Sub(zLocal, xLocal, zLocal, vecCount);
            } else if (tiling->opMode == OP_MODE_SCALE) {
                // 辅助路径：只取第一个输入，y = x1 * alpha（fp32 单次乘）。
                // 必须先把 alpha 读进标量局部变量再传 —— 直接传 `tiling->alpha` 会让
                // `__gm__ float&` 参与 Muls 的模板推导（实测编译失败）。
                float alpha = tiling->alpha;
                AscendC::Muls(zLocal, xLocal, alpha, vecCount);
            } else {
                AscendC::Sub(zLocal, xLocal, yLocal, vecCount);
            }
        }
        for (uint32_t j = vecCount; j < count; j++) {
            float xv = xLocal.GetValue(j);
            float z = 0.0f;
            if (tiling->opMode == OP_MODE_FMASUB) {
                z = xv - tiling->alpha * yLocal.GetValue(j);
            } else if (tiling->opMode == OP_MODE_SCALE) {
                z = xv * tiling->alpha;
            } else {
                z = xv - yLocal.GetValue(j);
            }
            zLocal.SetValue(j, z);
        }
        // 尾块写回长度按 32B 对齐（见 CopyLength）：第 count..copyLen-1 个槽位是填充位，
        // 显式写 0，保证「多写的尾巴」是确定的 0 而不是 UB 残留（对外语义仍只覆盖 [0, N)）。
        uint32_t copyLen = CopyLength(count, offset + count == workLength);
        for (uint32_t j = count; j < copyLen; j++) {
            zLocal.SetValue(j, 0.0f);
        }

        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        uint32_t copyLen = CopyLength(count, offset + count == workLength);
        AscendC::DataCopyPad(zGm[offset], zLocal,
            {1, static_cast<uint16_t>(copyLen * sizeof(float)), 0, 0});
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe *pipe_;
    const __gm__ SubTilingData *tiling;

    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;

    uint32_t workLength;
    uint32_t tileLength;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口（可执行文件与共享库共用；名字进 EXEC 标记行）
extern "C" __global__ __vector__ void elementwise_sub_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelSub op(&pipe);
    op.Init(x, y, z, (__gm__ SubTilingData *)tiling);
    op.Process();
}
