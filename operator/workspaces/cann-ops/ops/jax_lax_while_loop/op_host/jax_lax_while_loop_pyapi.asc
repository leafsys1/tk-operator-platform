// ============================================================================
// jax_lax_while_loop · Python 调用接口的 C ABI 实现（libjax_lax_while_loop_host.so）
// ============================================================================
// 供 ops/jax_lax_while_loop/python/jax_lax_while_loop.py 用 ctypes 加载。
//
// 分工（编码规则 A1）：本层只做参数校验 + Tiling + kernel launch + 证据 D2H，
// **不做任何数值计算**；body/cond/JVP 的全部数值在
// op_kernel/jax_lax_while_loop_kernel.asc 里按实际 carry 计算。
//
// 一次 step 只推进一个阶段（cond-only 或 body+cond），设备计数写在 seq 的
// 设备缓冲区里，本层在 stream 同步后 D2H 读回；abi_calls 是本层按实际 launch
// 次数累加的原始整数，不是测试侧推算。
//
// 返回码：0 成功 / 1 运行失败 / 2 参数错误。
// 约束：不 aclFinalize —— 进程内其它 ACL 使用者（PJRT/xla-npu）的生命周期由调用方管理。
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <new>

#include "acl/acl.h"
#include "../op_kernel/jax_lax_while_loop_tiling.h"
// 与可执行文件共用同一份 device 侧实现（kernel 代码在共享库里同样打进去）
#include "../op_kernel/jax_lax_while_loop_kernel.asc"
#include "jax_lax_while_loop_abi.h"

namespace {

constexpr int WHILE_RC_OK = 0;
constexpr int WHILE_RC_RUN_FAILED = 1;
constexpr int WHILE_RC_BAD_ARGS = 2;

struct WhileSeq {
    void *counters = nullptr;        // device int32[8]
    void *tiling = nullptr;          // device WhileTilingData
    int32_t device_id = 0;
    int64_t calls = 0;
};

const char *CodeName(int rc)
{
    switch (rc) {
        case WHILE_RC_BAD_ARGS: return "invalid_argument";
        case WHILE_RC_RUN_FAILED: return "device_error";
        default: return "error";
    }
}

void WriteErr(const jax_lax_while_loop_args_t *args, int rc, const char *detail)
{
    if (args == nullptr || args->err == nullptr || args->err_len <= 0) {
        return;
    }
    char *buf = static_cast<char *>(const_cast<void *>(args->err));
    (void)snprintf(buf, static_cast<size_t>(args->err_len), "%s: %s", CodeName(rc),
                   (detail == nullptr) ? "" : detail);
}

bool KnownCondOp(int32_t op)
{
    return op >= WHILE_CMP_LT && op <= WHILE_CMP_ALWAYS_TRUE;
}

bool IsAllCondOp(int32_t op)
{
    return op >= WHILE_CMP_ALL_GT && op <= WHILE_CMP_ALL_LE;
}

int Validate(const jax_lax_while_loop_args_t *args, char *detail, size_t detailLen)
{
    if (args == nullptr) {
        return WHILE_RC_BAD_ARGS;
    }
    if (args->abi_version != JAX_LAX_WHILE_LOOP_ABI_VERSION) {
        (void)snprintf(detail, detailLen, "abi_version=%d（期望 %d）", args->abi_version,
                       JAX_LAX_WHILE_LOOP_ABI_VERSION);
        return WHILE_RC_BAD_ARGS;
    }
    if (args->seq == nullptr || args->counters_host == nullptr) {
        (void)snprintf(detail, detailLen, "seq/counters_host 不能为空");
        return WHILE_RC_BAD_ARGS;
    }
    if (args->stage != WHILE_STAGE_COND_ONLY && args->stage != WHILE_STAGE_BODY_COND) {
        (void)snprintf(detail, detailLen, "stage=%d 只能是 0/1", args->stage);
        return WHILE_RC_BAD_ARGS;
    }
    if (args->n_leaves < 1 || args->n_leaves > JAX_LAX_WHILE_LOOP_MAX_LEAVES) {
        (void)snprintf(detail, detailLen, "n_leaves=%d 超出 [1, %d]", args->n_leaves,
                       JAX_LAX_WHILE_LOOP_MAX_LEAVES);
        return WHILE_RC_BAD_ARGS;
    }
    if (args->safety_limit < 1) {
        (void)snprintf(detail, detailLen, "safety_limit=%d 必须 >= 1", args->safety_limit);
        return WHILE_RC_BAD_ARGS;
    }
    for (int32_t i = 0; i < args->n_leaves; ++i) {
        if (args->dtype[i] != WHILE_DTYPE_F32 && args->dtype[i] != WHILE_DTYPE_I32) {
            (void)snprintf(detail, detailLen, "dtype[%d]=%d 不是 f32/i32", i, args->dtype[i]);
            return WHILE_RC_BAD_ARGS;
        }
        if (args->in[i] == nullptr || args->in_numel[i] <= 0) {
            (void)snprintf(detail, detailLen, "输入叶子 %d 地址/元素数非法", i);
            return WHILE_RC_BAD_ARGS;
        }
        if (args->out[i] == nullptr || args->out_numel[i] <= 0) {
            (void)snprintf(detail, detailLen, "输出叶子 %d 地址/元素数非法", i);
            return WHILE_RC_BAD_ARGS;
        }
        if (args->in_numel[i] != args->out_numel[i]) {
            (void)snprintf(detail, detailLen,
                           "叶子 %d in_numel=%lld != out_numel=%lld（结构必须固定）", i,
                           static_cast<long long>(args->in_numel[i]),
                           static_cast<long long>(args->out_numel[i]));
            return WHILE_RC_BAD_ARGS;
        }
        const int32_t nTerms = args->n_terms[i];
        if (nTerms < 0 || nTerms > 2) {
            (void)snprintf(detail, detailLen, "n_terms[%d]=%d 超出 [0,2]", i, nTerms);
            return WHILE_RC_BAD_ARGS;
        }
        const int32_t srcs[2] = {args->out_src1[i], args->out_src2[i]};
        const int32_t reds[2] = {args->out_red1[i], args->out_red2[i]};
        for (int32_t t = 0; t < nTerms; ++t) {
            if (srcs[t] < 0 || srcs[t] >= args->n_leaves) {
                (void)snprintf(detail, detailLen, "叶子 %d 的项 %d 源下标 %d 越界", i, t,
                               srcs[t]);
                return WHILE_RC_BAD_ARGS;
            }
            if (reds[t] != 0) {
                if (args->in_numel[srcs[t]] > WHILE_SCAN_MAX) {
                    (void)snprintf(detail, detailLen,
                                   "叶子 %d 项 %d 的归约源 numel=%lld 超过上限 %lld", i, t,
                                   static_cast<long long>(args->in_numel[srcs[t]]),
                                   static_cast<long long>(WHILE_SCAN_MAX));
                    return WHILE_RC_BAD_ARGS;
                }
            } else if (args->in_numel[srcs[t]] != args->out_numel[i]) {
                (void)snprintf(detail, detailLen,
                               "叶子 %d 项 %d 逐元素源 numel=%lld != 输出 numel=%lld", i, t,
                               static_cast<long long>(args->in_numel[srcs[t]]),
                               static_cast<long long>(args->out_numel[i]));
                return WHILE_RC_BAD_ARGS;
            }
        }
        if (args->out_dtype[i] != WHILE_DTYPE_F32 && args->out_dtype[i] != WHILE_DTYPE_I32) {
            (void)snprintf(detail, detailLen, "out_dtype[%d]=%d 不是 f32/i32", i,
                           args->out_dtype[i]);
            return WHILE_RC_BAD_ARGS;
        }
        if (args->has_tangent != 0 && args->tan_out_flag[i] != 0) {
            if (args->tan_in[i] == nullptr || args->tan_out[i] == nullptr) {
                (void)snprintf(detail, detailLen, "叶子 %d 的切线地址为空", i);
                return WHILE_RC_BAD_ARGS;
            }
        }
    }
    if (!KnownCondOp(args->cond_op)) {
        (void)snprintf(detail, detailLen, "cond_op=%d 不是已注册条件算子", args->cond_op);
        return WHILE_RC_BAD_ARGS;
    }
    if (args->cond_op != WHILE_CMP_ALWAYS_TRUE) {
        if (args->cond_leaf < 0 || args->cond_leaf >= args->n_leaves) {
            (void)snprintf(detail, detailLen, "cond_leaf=%d 越界", args->cond_leaf);
            return WHILE_RC_BAD_ARGS;
        }
        if (args->cond_rhs_leaf >= args->n_leaves) {
            (void)snprintf(detail, detailLen, "cond_rhs_leaf=%d 越界", args->cond_rhs_leaf);
            return WHILE_RC_BAD_ARGS;
        }
        if (IsAllCondOp(args->cond_op)) {
            if (args->in_numel[args->cond_leaf] > WHILE_SCAN_MAX) {
                (void)snprintf(detail, detailLen,
                               "all() 条件叶子 numel=%lld 超过上限 %lld",
                               static_cast<long long>(args->in_numel[args->cond_leaf]),
                               static_cast<long long>(WHILE_SCAN_MAX));
                return WHILE_RC_BAD_ARGS;
            }
        } else if (args->in_numel[args->cond_leaf] != 1) {
            (void)snprintf(detail, detailLen, "标量条件叶子 %d 的 numel=%lld != 1",
                           args->cond_leaf,
                           static_cast<long long>(args->in_numel[args->cond_leaf]));
            return WHILE_RC_BAD_ARGS;
        }
    }
    return WHILE_RC_OK;
}

void FillTiling(const jax_lax_while_loop_args_t *args, WhileTilingData *tiling)
{
    std::memset(tiling, 0, sizeof(WhileTilingData));
    tiling->stage = args->stage;
    tiling->nLeaves = args->n_leaves;
    tiling->hasTangent = args->has_tangent;
    tiling->condOp = args->cond_op;
    tiling->condLeaf = args->cond_leaf;
    tiling->condRhsLeaf = args->cond_rhs_leaf;
    tiling->condIsInt = args->cond_is_int;
    tiling->safetyLimit = args->safety_limit;
    tiling->planSeed = args->plan_seed;
    tiling->condConst = args->cond_const;
    for (int32_t i = 0; i < JAX_LAX_WHILE_LOOP_MAX_LEAVES; ++i) {
        tiling->inNumel[i] = args->in_numel[i];
        tiling->outNumel[i] = args->out_numel[i];
        tiling->outDtype[i] = args->out_dtype[i];
        tiling->nTerms[i] = args->n_terms[i];
        tiling->outSrc1[i] = args->out_src1[i];
        tiling->outScale1[i] = args->out_scale1[i];
        tiling->outRed1[i] = args->out_red1[i];
        tiling->outSrc2[i] = args->out_src2[i];
        tiling->outScale2[i] = args->out_scale2[i];
        tiling->outRed2[i] = args->out_red2[i];
        tiling->outConst[i] = args->out_const[i];
        tiling->tanOut[i] = args->tan_out_flag[i];
    }
}

bool g_aclInited = false;

int EnsureAcl(int32_t deviceId)
{
    if (!g_aclInited) {
        aclError initRet = aclInit(nullptr);
        if (initRet != ACL_SUCCESS) {
            uint32_t deviceCount = 0;
            if (aclrtGetDeviceCount(&deviceCount) != ACL_SUCCESS || deviceCount <= 0) {
                return WHILE_RC_RUN_FAILED;
            }
        }
        g_aclInited = true;
    }
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        return WHILE_RC_RUN_FAILED;
    }
    return WHILE_RC_OK;
}

}  // namespace

extern "C" {

int jax_lax_while_loop_seq_begin(void **handle, int32_t device_id)
{
    if (handle == nullptr) {
        return WHILE_RC_BAD_ARGS;
    }
    *handle = nullptr;
    if (EnsureAcl(device_id) != WHILE_RC_OK) {
        return WHILE_RC_RUN_FAILED;
    }
    WhileSeq *seq = new (std::nothrow) WhileSeq();
    if (seq == nullptr) {
        return WHILE_RC_RUN_FAILED;
    }
    seq->device_id = device_id;
    const bool allocOk =
        aclrtMalloc(&seq->counters, JAX_LAX_WHILE_LOOP_COUNTER_SLOTS * sizeof(int32_t),
                    ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
        aclrtMalloc(&seq->tiling, sizeof(WhileTilingData), ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    if (!allocOk) {
        if (seq->counters != nullptr) {
            (void)aclrtFree(seq->counters);
        }
        if (seq->tiling != nullptr) {
            (void)aclrtFree(seq->tiling);
        }
        delete seq;
        return WHILE_RC_RUN_FAILED;
    }
    if (aclrtMemset(seq->counters, JAX_LAX_WHILE_LOOP_COUNTER_SLOTS * sizeof(int32_t), 0,
                    JAX_LAX_WHILE_LOOP_COUNTER_SLOTS * sizeof(int32_t)) != ACL_SUCCESS) {
        (void)aclrtFree(seq->counters);
        (void)aclrtFree(seq->tiling);
        delete seq;
        return WHILE_RC_RUN_FAILED;
    }
    *handle = seq;
    return WHILE_RC_OK;
}

int jax_lax_while_loop_step(const jax_lax_while_loop_args_t *args)
{
    if (args == nullptr) {
        return WHILE_RC_BAD_ARGS;
    }
    char detail[256] = {0};
    int rc = Validate(args, detail, sizeof(detail));
    if (rc != WHILE_RC_OK) {
        WriteErr(args, rc, detail);
        return rc;
    }
    WhileSeq *seq = static_cast<WhileSeq *>(args->seq);
    if (EnsureAcl(args->device_id) != WHILE_RC_OK) {
        WriteErr(args, WHILE_RC_RUN_FAILED, "aclInit/aclrtSetDevice 失败");
        return WHILE_RC_RUN_FAILED;
    }
    WhileTilingData tiling;
    FillTiling(args, &tiling);
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        WriteErr(args, WHILE_RC_RUN_FAILED, "aclrtCreateStream 失败");
        return WHILE_RC_RUN_FAILED;
    }
    rc = WHILE_RC_RUN_FAILED;
    if (aclrtMemcpy(seq->tiling, sizeof(WhileTilingData), &tiling, sizeof(WhileTilingData),
                    ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        (void)snprintf(detail, sizeof(detail), "aclrtMemcpy(tiling) 失败");
    } else {
        jax_lax_while_loop_kernel<<<1, nullptr, stream>>>(
            static_cast<uint8_t *>(args->in[0]), static_cast<uint8_t *>(args->in[1]),
            static_cast<uint8_t *>(args->in[2]), static_cast<uint8_t *>(args->in[3]),
            static_cast<uint8_t *>(args->in[4]), static_cast<uint8_t *>(args->in[5]),
            static_cast<uint8_t *>(args->in[6]), static_cast<uint8_t *>(args->in[7]),
            static_cast<uint8_t *>(args->out[0]), static_cast<uint8_t *>(args->out[1]),
            static_cast<uint8_t *>(args->out[2]), static_cast<uint8_t *>(args->out[3]),
            static_cast<uint8_t *>(args->out[4]), static_cast<uint8_t *>(args->out[5]),
            static_cast<uint8_t *>(args->out[6]), static_cast<uint8_t *>(args->out[7]),
            static_cast<uint8_t *>(args->tan_in[0]), static_cast<uint8_t *>(args->tan_in[1]),
            static_cast<uint8_t *>(args->tan_in[2]), static_cast<uint8_t *>(args->tan_in[3]),
            static_cast<uint8_t *>(args->tan_in[4]), static_cast<uint8_t *>(args->tan_in[5]),
            static_cast<uint8_t *>(args->tan_in[6]), static_cast<uint8_t *>(args->tan_in[7]),
            static_cast<uint8_t *>(args->tan_out[0]), static_cast<uint8_t *>(args->tan_out[1]),
            static_cast<uint8_t *>(args->tan_out[2]), static_cast<uint8_t *>(args->tan_out[3]),
            static_cast<uint8_t *>(args->tan_out[4]), static_cast<uint8_t *>(args->tan_out[5]),
            static_cast<uint8_t *>(args->tan_out[6]), static_cast<uint8_t *>(args->tan_out[7]),
            static_cast<uint8_t *>(seq->counters), static_cast<uint8_t *>(seq->tiling));
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
            (void)snprintf(detail, sizeof(detail),
                           "kernel 执行失败（aclrtSynchronizeStream 非 0）");
        } else if (aclrtMemcpy(args->counters_host,
                               JAX_LAX_WHILE_LOOP_COUNTER_SLOTS * sizeof(int32_t),
                               seq->counters, JAX_LAX_WHILE_LOOP_COUNTER_SLOTS * sizeof(int32_t),
                               ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            (void)snprintf(detail, sizeof(detail), "证据 D2H 读回失败");
        } else {
            seq->calls += 1;
            rc = WHILE_RC_OK;
        }
    }
    (void)aclrtDestroyStream(stream);
    if (rc != WHILE_RC_OK) {
        WriteErr(args, rc, detail);
    }
    return rc;
}

int jax_lax_while_loop_seq_end(void *handle, int32_t *counters_out, int64_t *abi_calls_out)
{
    if (handle == nullptr) {
        return WHILE_RC_BAD_ARGS;
    }
    WhileSeq *seq = static_cast<WhileSeq *>(handle);
    int rc = WHILE_RC_OK;
    if (counters_out != nullptr) {
        if (aclrtMemcpy(counters_out, JAX_LAX_WHILE_LOOP_COUNTER_SLOTS * sizeof(int32_t),
                        seq->counters, JAX_LAX_WHILE_LOOP_COUNTER_SLOTS * sizeof(int32_t),
                        ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            rc = WHILE_RC_RUN_FAILED;
        }
    }
    if (abi_calls_out != nullptr) {
        *abi_calls_out = seq->calls;
    }
    if (seq->counters != nullptr) {
        (void)aclrtFree(seq->counters);
    }
    if (seq->tiling != nullptr) {
        (void)aclrtFree(seq->tiling);
    }
    delete seq;
    return rc;
}

int jax_lax_while_loop_seq_free(void *handle)
{
    if (handle == nullptr) {
        return WHILE_RC_OK;
    }
    WhileSeq *seq = static_cast<WhileSeq *>(handle);
    if (seq->counters != nullptr) {
        (void)aclrtFree(seq->counters);
    }
    if (seq->tiling != nullptr) {
        (void)aclrtFree(seq->tiling);
    }
    delete seq;
    return WHILE_RC_OK;
}

const char *jax_lax_while_loop_abi_version(void)
{
    return "opx-while-loop-python-abi/1";
}

int jax_lax_while_loop_acl_init(void)
{
    return EnsureAcl(0);
}

int jax_lax_while_loop_malloc(void **devPtr, int64_t bytes)
{
    if (devPtr == nullptr || bytes <= 0) {
        return WHILE_RC_BAD_ARGS;
    }
    return (aclrtMalloc(devPtr, static_cast<size_t>(bytes), ACL_MEM_MALLOC_HUGE_FIRST) ==
            ACL_SUCCESS)
               ? WHILE_RC_OK
               : WHILE_RC_RUN_FAILED;
}

int jax_lax_while_loop_free(void *devPtr)
{
    if (devPtr == nullptr) {
        return WHILE_RC_OK;
    }
    return (aclrtFree(devPtr) == ACL_SUCCESS) ? WHILE_RC_OK : WHILE_RC_RUN_FAILED;
}

int jax_lax_while_loop_h2d(void *devPtr, const void *hostPtr, int64_t bytes)
{
    if (devPtr == nullptr || hostPtr == nullptr || bytes <= 0) {
        return WHILE_RC_BAD_ARGS;
    }
    return (aclrtMemcpy(devPtr, static_cast<size_t>(bytes), hostPtr, static_cast<size_t>(bytes),
                        ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS)
               ? WHILE_RC_OK
               : WHILE_RC_RUN_FAILED;
}

int jax_lax_while_loop_d2h(void *hostPtr, const void *devPtr, int64_t bytes)
{
    if (hostPtr == nullptr || devPtr == nullptr || bytes <= 0) {
        return WHILE_RC_BAD_ARGS;
    }
    return (aclrtMemcpy(hostPtr, static_cast<size_t>(bytes), devPtr, static_cast<size_t>(bytes),
                        ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS)
               ? WHILE_RC_OK
               : WHILE_RC_RUN_FAILED;
}

}  // extern "C"
