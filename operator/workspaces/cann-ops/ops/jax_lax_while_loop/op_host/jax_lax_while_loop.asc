// ============================================================================
// jax_lax_while_loop · 四动作可执行入口（ops/jax_lax_while_loop/build/jax_lax_while_loop）
// ============================================================================
// 调用契约（0-黑盒测试设计.md §5.5 / 0-测试工程说明.md §5.5，共享 runner 的 while 分支）：
//   jax_lax_while_loop --case-json <case.json> --inputs <inputs.npz> \
//                      --mode <eager|jit|jvp_eager|jvp_jit> [--variant <name>] --outdir <dir>
//   → rc=0 + <outdir>/outputs.npz + <outdir>/meta.json + stdout 含 `EXEC ...`
//   → 参数校验拒绝（c13–c15）rc=3；设备安全阀拒绝（c16）rc=3；其它非 0 = ERROR
//
// 为什么 host 入口只做协议解析与转交：
//   while_loop 的输入是 **pytree + .npz + case.json**，cond_fun/body_fun 是 Python callable
//   （C ABI 无法接收 PyObject）。因此本入口负责：
//     1) 校验 argv 协议（未知参数/缺值直接 rc=2，不进入算子路径）；
//     2) 定位交付目录下的 host driver `python/jax_lax_while_loop_cli.py` 并转交；
//     3) 数值全部在 `libjax_lax_while_loop_host.so` → `op_kernel/jax_lax_while_loop_kernel.asc`
//        的 AscendC kernel 上执行；本文件不含任何数值计算（编码规则 A1/A2）。
//   `--self-check` 用于构建后自检：只校验交付布局与 `.so` 是否可加载、ABI 是否一致，不跑用例。
// ============================================================================

#include <cerrno>
#include <climits>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <unistd.h>
#include <vector>

#include <dlfcn.h>

namespace {

const char *kExpectedFlags[] = {"--case-json", "--inputs", "--mode", "--variant", "--outdir"};

bool HasFlag(const std::string &key)
{
    for (const char *flag : kExpectedFlags) {
        if (key == flag) {
            return true;
        }
    }
    return false;
}

std::string SelfDir()
{
    char buffer[PATH_MAX] = {0};
    ssize_t len = readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
    if (len <= 0) {
        return std::string();
    }
    buffer[len] = '\0';
    std::string path(buffer);
    std::size_t pos = path.find_last_of('/');
    return (pos == std::string::npos) ? std::string(".") : path.substr(0, pos);
}

}  // namespace

int main(int argc, char *argv[])
{
    std::string selfDir = SelfDir();
    if (selfDir.empty()) {
        std::fprintf(stderr, "jax_lax_while_loop: 无法定位自身路径（/proc/self/exe）\n");
        return 1;
    }
    std::string opRoot = selfDir + "/..";
    std::string cliPath = opRoot + "/python/jax_lax_while_loop_cli.py";
    std::string soPath = selfDir + "/libjax_lax_while_loop_host.so";

    if (argc == 2 && std::strcmp(argv[1], "--self-check") == 0) {
        std::printf("SELF_CHECK op=jax_lax_while_loop exe=%s\n",
                    (selfDir + "/jax_lax_while_loop").c_str());
        std::fflush(stdout);
        std::printf("SELF_CHECK cli=%s exists=%d\n", cliPath.c_str(),
                    access(cliPath.c_str(), R_OK) == 0 ? 1 : 0);
        std::fflush(stdout);
        void *handle = dlopen(soPath.c_str(), RTLD_NOW);
        std::printf("SELF_CHECK so=%s loadable=%d\n", soPath.c_str(),
                    handle != nullptr ? 1 : 0);
        std::fflush(stdout);
        if (handle != nullptr) {
            using VersionFn = const char *(*)();
            auto versionFn =
                reinterpret_cast<VersionFn>(dlsym(handle, "jax_lax_while_loop_abi_version"));
            std::printf("SELF_CHECK dlsym=%d\n", versionFn != nullptr ? 1 : 0);
            std::fflush(stdout);
            const char *abi = (versionFn != nullptr) ? versionFn() : "UNKNOWN";
            std::printf("SELF_CHECK abi=%s\n", abi);
            std::fflush(stdout);
            // 不 dlclose：一次性的自检进程直接退出，避免卸载含设备注册静态对象的库。
            return (std::strcmp(abi, "opx-while-loop-python-abi/1") == 0) ? 0 : 1;
        }
        return 1;
    }

    if (argc < 2) {
        std::fprintf(stderr,
                     "用法：jax_lax_while_loop --case-json <case.json> --inputs <inputs.npz> "
                     "--mode <eager|jit|jvp_eager|jvp_jit> [--variant <name>] --outdir <dir>\n");
        return 2;
    }

    // 协议校验放在 host 入口：未知参数/配对的缺失值直接 rc=2，不进入算子路径。
    for (int i = 1; i < argc; i += 2) {
        std::string key = argv[i];
        if (!HasFlag(key)) {
            std::printf("REJECT_BAD_ARGS unknown key %s\n", key.c_str());
            return 2;
        }
        if (i + 1 >= argc) {
            std::printf("REJECT_BAD_ARGS missing value for %s\n", key.c_str());
            return 2;
        }
    }

    if (access(cliPath.c_str(), R_OK) != 0) {
        std::fprintf(stderr, "jax_lax_while_loop: host driver 不存在：%s\n", cliPath.c_str());
        return 1;
    }

    std::vector<std::string> owned;
    owned.emplace_back("python3");
    owned.emplace_back(cliPath);
    for (int i = 1; i < argc; ++i) {
        owned.emplace_back(argv[i]);
    }
    std::vector<char *> child;
    child.reserve(owned.size() + 1);
    for (auto &item : owned) {
        child.push_back(const_cast<char *>(item.c_str()));
    }
    child.push_back(nullptr);

    execvp("python3", child.data());
    std::fprintf(stderr, "jax_lax_while_loop: execvp python3 失败：%s\n", std::strerror(errno));
    return 127;
}
