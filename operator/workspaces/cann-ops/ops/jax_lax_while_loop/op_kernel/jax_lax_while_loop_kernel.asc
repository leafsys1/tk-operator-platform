// ============================================================================
// Ascend C Kernel 实现 - jax_lax_while_loop（纯 kernel，不含 host 代码）
// ============================================================================
// host_step 路由：每次 host 入口推进“一次 cond”（stage=0）或“一次 body + 一次 cond”
// （stage=1）。kernel 在 NPU 上对实际 carry 求值：
//   * body：每个输出叶子 = 1~2 个线性项 + 常量；项可为逐元素（同 numel）或整叶求和
//     （用于 `a + mean(b)` 的 mean 项，求和后广播到输出 numel）；
//   * cond：`leaf < leaf|const`（int32 / float32）或 `all(leaf > const)`；恒真直接返回 1；
//   * JVP：同一仿射映射作用在切向量上（不含常量项），与 primal 在同一 kernel 内完成；
//   * 证据：body_hits / cond_hits / limit_flag / token 由本 kernel 写设备内存，
//     host 只做 D2H 读回，Python 不自报计数。
//
// 单核执行（blockNum=1）：cond 是数据相关标量分支，且计数需要读改写；单核可避免
// 跨核同步与原子操作，语义最直接。性能只记基线，不设阈值。
// ============================================================================

#include "kernel_operator.h"
#include "jax_lax_while_loop_tiling.h"

class KernelWhileLoop {
public:
    __aicore__ inline KernelWhileLoop(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR in0, GM_ADDR in1, GM_ADDR in2, GM_ADDR in3,
                                GM_ADDR in4, GM_ADDR in5, GM_ADDR in6, GM_ADDR in7,
                                GM_ADDR out0, GM_ADDR out1, GM_ADDR out2, GM_ADDR out3,
                                GM_ADDR out4, GM_ADDR out5, GM_ADDR out6, GM_ADDR out7,
                                GM_ADDR tin0, GM_ADDR tin1, GM_ADDR tin2, GM_ADDR tin3,
                                GM_ADDR tin4, GM_ADDR tin5, GM_ADDR tin6, GM_ADDR tin7,
                                GM_ADDR tout0, GM_ADDR tout1, GM_ADDR tout2, GM_ADDR tout3,
                                GM_ADDR tout4, GM_ADDR tout5, GM_ADDR tout6, GM_ADDR tout7,
                                GM_ADDR counters, GM_ADDR tilingData)
    {
        tiling_ = (__gm__ WhileTilingData *)tilingData;
        GM_ADDR ins[WHILE_MAX_LEAVES] = {in0, in1, in2, in3, in4, in5, in6, in7};
        GM_ADDR outs[WHILE_MAX_LEAVES] = {out0, out1, out2, out3, out4, out5, out6, out7};
        GM_ADDR tins[WHILE_MAX_LEAVES] = {tin0, tin1, tin2, tin3, tin4, tin5, tin6, tin7};
        GM_ADDR touts[WHILE_MAX_LEAVES] = {tout0, tout1, tout2, tout3, tout4, tout5, tout6,
                                           tout7};
        for (int32_t i = 0; i < WHILE_MAX_LEAVES; ++i) {
            if (i < tiling_->nLeaves && ins[i] != nullptr) {
                inF_[i].SetGlobalBuffer((__gm__ float *)ins[i], tiling_->inNumel[i]);
                inI_[i].SetGlobalBuffer((__gm__ int32_t *)ins[i], tiling_->inNumel[i]);
            }
            if (i < tiling_->nLeaves && outs[i] != nullptr) {
                outF_[i].SetGlobalBuffer((__gm__ float *)outs[i], tiling_->outNumel[i]);
                outI_[i].SetGlobalBuffer((__gm__ int32_t *)outs[i], tiling_->outNumel[i]);
            }
            if (i < tiling_->nLeaves && tins[i] != nullptr) {
                tanInF_[i].SetGlobalBuffer((__gm__ float *)tins[i], tiling_->inNumel[i]);
            }
            if (i < tiling_->nLeaves && touts[i] != nullptr) {
                tanOutF_[i].SetGlobalBuffer((__gm__ float *)touts[i], tiling_->outNumel[i]);
            }
        }
        counterGm_.SetGlobalBuffer((__gm__ int32_t *)counters, WHILE_COUNTER_SLOTS);

        // in1/in2/out 各 32KB，scan 1KB，evi 32B → 约 97KB < 192KB。
        pipe_->InitBuffer(inQ1_, 1, WHILE_TILE_ELEMS * sizeof(float));
        pipe_->InitBuffer(inQ2_, 1, WHILE_TILE_ELEMS * sizeof(float));
        pipe_->InitBuffer(outQ_, 1, WHILE_TILE_ELEMS * sizeof(float));
        pipe_->InitBuffer(scanQ_, 1, WHILE_SCAN_MAX * sizeof(float));
        pipe_->InitBuffer(eviQ_, 1, WHILE_COUNTER_SLOTS * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        int32_t bodyHits = 0;
        int32_t condHits = 0;
        int32_t limitFlag = 0;
        ReadCounters(bodyHits, condHits, limitFlag);

        int32_t condResult = 1;
        if (tiling_->stage == WHILE_STAGE_COND_ONLY) {
            condHits += 1;
            condResult = EvalCond(false);
        } else {
            if (bodyHits >= tiling_->safetyLimit) {
                limitFlag = 1;  // 达到安全上限：不再执行 body、也不再求值 cond
            } else {
                ComputeBody();
                bodyHits += 1;
                if (bodyHits >= tiling_->safetyLimit) {
                    limitFlag = 1;  // iter < limit 先短路：达到上限后不再求值 cond
                } else {
                    condHits += 1;
                    condResult = EvalCond(true);
                }
            }
        }

        uint32_t token = tiling_->planSeed ^ (uint32_t)((uint32_t)bodyHits * 2654435761u);
        token ^= ((uint32_t)condHits << 8);
        token ^= ((uint32_t)limitFlag << 31);
        WriteCounters(bodyHits, condHits, limitFlag, (int32_t)token, condResult);
    }

private:
    // ------------------------------------------------------------------
    // 证据读写
    // ------------------------------------------------------------------
    __aicore__ inline void ReadCounters(int32_t &bodyHits, int32_t &condHits, int32_t &limitFlag)
    {
        AscendC::LocalTensor<int32_t> ev = eviQ_.AllocTensor<int32_t>();
        AscendC::DataCopyPad(ev, counterGm_,
            {1, static_cast<uint16_t>(WHILE_COUNTER_SLOTS * sizeof(int32_t)), 0, 0},
            {false, 0, 0, 0});
        eviQ_.EnQue(ev);
        ev = eviQ_.DeQue<int32_t>();
        AscendC::PipeBarrier<PIPE_ALL>();
        bodyHits = ev.GetValue(WHILE_SLOT_BODY_HITS);
        condHits = ev.GetValue(WHILE_SLOT_COND_HITS);
        limitFlag = ev.GetValue(WHILE_SLOT_LIMIT_FLAG);
        eviQ_.FreeTensor(ev);
    }

    __aicore__ inline void WriteCounters(int32_t bodyHits, int32_t condHits, int32_t limitFlag,
                                         int32_t token, int32_t condResult)
    {
        AscendC::LocalTensor<int32_t> ev = eviQ_.AllocTensor<int32_t>();
        // [6]/[7] 保留：SetValue 只在 LocalTensor 上做（GlobalTensor::SetValue 在黑名单）。
        for (int32_t i = 0; i < WHILE_COUNTER_SLOTS; ++i) {
            ev.SetValue(i, 0);
        }
        ev.SetValue(WHILE_SLOT_BODY_HITS, bodyHits);
        ev.SetValue(WHILE_SLOT_COND_HITS, condHits);
        ev.SetValue(WHILE_SLOT_LIMIT_FLAG, limitFlag);
        ev.SetValue(WHILE_SLOT_TOKEN, token);
        ev.SetValue(WHILE_SLOT_COND_RESULT, condResult);
        ev.SetValue(WHILE_SLOT_ITERATIONS, bodyHits);
        AscendC::PipeBarrier<PIPE_ALL>();
        eviQ_.EnQue(ev);
        ev = eviQ_.DeQue<int32_t>();
        AscendC::DataCopyPad(counterGm_, ev,
            {1, static_cast<uint16_t>(WHILE_COUNTER_SLOTS * sizeof(int32_t)), 0, 0});
        eviQ_.FreeTensor(ev);
    }

    // ------------------------------------------------------------------
    // 标量读（只从 LocalTensor 读，避免 GlobalTensor::GetValue 黑名单）
    // ------------------------------------------------------------------
    __aicore__ inline int32_t ReadScalarInt(int32_t leaf, bool useOut)
    {
        AscendC::LocalTensor<int32_t> s = scanQ_.AllocTensor<int32_t>();
        if (useOut) {
            AscendC::DataCopyPad(s, outI_[leaf], {1, static_cast<uint16_t>(sizeof(int32_t)), 0, 0}, {false, 0, 0, 0});
        } else {
            AscendC::DataCopyPad(s, inI_[leaf], {1, static_cast<uint16_t>(sizeof(int32_t)), 0, 0}, {false, 0, 0, 0});
        }
        scanQ_.EnQue(s);
        s = scanQ_.DeQue<int32_t>();
        AscendC::PipeBarrier<PIPE_ALL>();
        int32_t value = s.GetValue(0);
        scanQ_.FreeTensor(s);
        return value;
    }

    __aicore__ inline float ReadScalarFloat(int32_t leaf, bool useOut)
    {
        AscendC::LocalTensor<float> s = scanQ_.AllocTensor<float>();
        if (useOut) {
            AscendC::DataCopyPad(s, outF_[leaf], {1, static_cast<uint16_t>(sizeof(float)), 0, 0}, {false, 0, 0, 0});
        } else {
            AscendC::DataCopyPad(s, inF_[leaf], {1, static_cast<uint16_t>(sizeof(float)), 0, 0}, {false, 0, 0, 0});
        }
        scanQ_.EnQue(s);
        s = scanQ_.DeQue<float>();
        AscendC::PipeBarrier<PIPE_ALL>();
        float value = s.GetValue(0);
        scanQ_.FreeTensor(s);
        return value;
    }

    __aicore__ inline float SumFloatLeaf(int32_t src, bool tangent)
    {
        const int64_t n = tiling_->inNumel[src];
        AscendC::LocalTensor<float> s = scanQ_.AllocTensor<float>();
        if (tangent) {
            AscendC::DataCopyPad(s, tanInF_[src],
                {1, static_cast<uint16_t>(n * sizeof(float)), 0, 0}, {false, 0, 0, 0});
        } else {
            AscendC::DataCopyPad(s, inF_[src],
                {1, static_cast<uint16_t>(n * sizeof(float)), 0, 0}, {false, 0, 0, 0});
        }
        scanQ_.EnQue(s);
        s = scanQ_.DeQue<float>();
        AscendC::PipeBarrier<PIPE_ALL>();
        float acc = 0.0f;
        for (int64_t i = 0; i < n; ++i) {
            acc += s.GetValue(static_cast<int32_t>(i));
        }
        scanQ_.FreeTensor(s);
        return acc;
    }

    __aicore__ inline int64_t SumIntLeaf(int32_t src)
    {
        const int64_t n = tiling_->inNumel[src];
        AscendC::LocalTensor<int32_t> s = scanQ_.AllocTensor<int32_t>();
        AscendC::DataCopyPad(s, inI_[src],
            {1, static_cast<uint16_t>(n * sizeof(int32_t)), 0, 0}, {false, 0, 0, 0});
        scanQ_.EnQue(s);
        s = scanQ_.DeQue<int32_t>();
        AscendC::PipeBarrier<PIPE_ALL>();
        int64_t acc = 0;
        for (int64_t i = 0; i < n; ++i) {
            acc += static_cast<int64_t>(s.GetValue(static_cast<int32_t>(i)));
        }
        scanQ_.FreeTensor(s);
        return acc;
    }

    // ------------------------------------------------------------------
    // 条件求值
    // ------------------------------------------------------------------
    __aicore__ inline int32_t EvalCond(bool useOut)
    {
        const int32_t op = tiling_->condOp;
        if (op == WHILE_CMP_ALWAYS_TRUE) {
            return 1;
        }
        const int32_t leaf = tiling_->condLeaf;
        if (op >= WHILE_CMP_ALL_GT) {
            const int64_t n = tiling_->inNumel[leaf];
            AscendC::LocalTensor<float> s = scanQ_.AllocTensor<float>();
            if (useOut) {
                AscendC::DataCopyPad(s, outF_[leaf],
                    {1, static_cast<uint16_t>(n * sizeof(float)), 0, 0}, {false, 0, 0, 0});
            } else {
                AscendC::DataCopyPad(s, inF_[leaf],
                    {1, static_cast<uint16_t>(n * sizeof(float)), 0, 0}, {false, 0, 0, 0});
            }
            scanQ_.EnQue(s);
            s = scanQ_.DeQue<float>();
            AscendC::PipeBarrier<PIPE_ALL>();
            const float c = tiling_->condConst;
            int32_t all = 1;
            for (int64_t i = 0; i < n; ++i) {
                const float v = s.GetValue(static_cast<int32_t>(i));
                bool hit = false;
                switch (op) {
                    case WHILE_CMP_ALL_GT: hit = (v > c); break;
                    case WHILE_CMP_ALL_GE: hit = (v >= c); break;
                    case WHILE_CMP_ALL_LT: hit = (v < c); break;
                    default: hit = (v <= c); break;
                }
                if (!hit) {
                    all = 0;
                    break;
                }
            }
            scanQ_.FreeTensor(s);
            return all;
        }
        if (tiling_->condIsInt != 0) {
            const int32_t x = ReadScalarInt(leaf, useOut);
            const int32_t r = (tiling_->condRhsLeaf >= 0)
                                  ? ReadScalarInt(tiling_->condRhsLeaf, useOut)
                                  : static_cast<int32_t>(tiling_->condConst);
            switch (op) {
                case WHILE_CMP_LT: return (x < r) ? 1 : 0;
                case WHILE_CMP_LE: return (x <= r) ? 1 : 0;
                case WHILE_CMP_GT: return (x > r) ? 1 : 0;
                case WHILE_CMP_GE: return (x >= r) ? 1 : 0;
                case WHILE_CMP_EQ: return (x == r) ? 1 : 0;
                default: return (x != r) ? 1 : 0;
            }
        }
        const float x = ReadScalarFloat(leaf, useOut);
        const float r = (tiling_->condRhsLeaf >= 0)
                            ? ReadScalarFloat(tiling_->condRhsLeaf, useOut)
                            : tiling_->condConst;
        switch (op) {
            case WHILE_CMP_LT: return (x < r) ? 1 : 0;
            case WHILE_CMP_LE: return (x <= r) ? 1 : 0;
            case WHILE_CMP_GT: return (x > r) ? 1 : 0;
            case WHILE_CMP_GE: return (x >= r) ? 1 : 0;
            case WHILE_CMP_EQ: return (x == r) ? 1 : 0;
            default: return (x != r) ? 1 : 0;
        }
    }

    // ------------------------------------------------------------------
    // body 求值
    // ------------------------------------------------------------------
    __aicore__ inline void ComputeBody()
    {
        for (int32_t j = 0; j < tiling_->nLeaves; ++j) {
            const int32_t dtype = tiling_->outDtype[j];
            if (dtype == WHILE_DTYPE_I32) {
                ComputeIntLeaf(j);
            } else {
                ComputeFloatLeaf(j, false);
                if (tiling_->hasTangent != 0 && tiling_->tanOut[j] != 0) {
                    ComputeFloatLeaf(j, true);
                }
            }
        }
    }

    __aicore__ inline int32_t ElemSrcA(int32_t j, float &scale)
    {
        if (tiling_->outRed1[j] == 0) {
            scale = tiling_->outScale1[j];
            return tiling_->outSrc1[j];
        }
        if (tiling_->nTerms[j] >= 2 && tiling_->outRed2[j] == 0) {
            scale = tiling_->outScale2[j];
            return tiling_->outSrc2[j];
        }
        return -1;
    }

    __aicore__ inline int32_t ElemSrcB(int32_t j, float &scale)
    {
        // 两个逐元素项都存在时才返回第二个
        if (tiling_->outRed1[j] == 0 && tiling_->nTerms[j] >= 2 &&
            tiling_->outRed2[j] == 0) {
            scale = tiling_->outScale2[j];
            return tiling_->outSrc2[j];
        }
        return -1;
    }

    __aicore__ inline void ComputeFloatLeaf(int32_t j, bool tangent)
    {
        const int64_t numel = tiling_->outNumel[j];
        float cEff = tangent ? 0.0f : tiling_->outConst[j];
        if (tiling_->outRed1[j] != 0) {
            cEff += tiling_->outScale1[j] * SumFloatLeaf(tiling_->outSrc1[j], tangent);
        }
        if (tiling_->nTerms[j] >= 2 && tiling_->outRed2[j] != 0) {
            cEff += tiling_->outScale2[j] * SumFloatLeaf(tiling_->outSrc2[j], tangent);
        }
        float scaleA = 1.0f;
        float scaleB = 1.0f;
        const int32_t srcA = ElemSrcA(j, scaleA);
        const int32_t srcB = ElemSrcB(j, scaleB);

        for (int64_t off = 0; off < numel; off += WHILE_TILE_ELEMS) {
            const int64_t remain = numel - off;
            const uint32_t count = static_cast<uint32_t>(
                (remain < WHILE_TILE_ELEMS) ? remain : WHILE_TILE_ELEMS);
            AscendC::LocalTensor<float> y = outQ_.AllocTensor<float>();
            if (srcA < 0) {
                // 只有归约项/常量：整块广播
                AscendC::Duplicate(y, cEff, count);
            } else {
                AscendC::LocalTensor<float> x1 = inQ1_.AllocTensor<float>();
                if (tangent) {
                    AscendC::DataCopyPad(x1, tanInF_[srcA][off],
                        {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                        {false, 0, 0, 0});
                } else {
                    AscendC::DataCopyPad(x1, inF_[srcA][off],
                        {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                        {false, 0, 0, 0});
                }
                inQ1_.EnQue(x1);
                x1 = inQ1_.DeQue<float>();
                AscendC::Muls(y, x1, scaleA, count);
                inQ1_.FreeTensor(x1);
                if (srcB >= 0) {
                    AscendC::LocalTensor<float> x2 = inQ2_.AllocTensor<float>();
                    if (tangent) {
                        AscendC::DataCopyPad(x2, tanInF_[srcB][off],
                            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                            {false, 0, 0, 0});
                    } else {
                        AscendC::DataCopyPad(x2, inF_[srcB][off],
                            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                            {false, 0, 0, 0});
                    }
                    inQ2_.EnQue(x2);
                    x2 = inQ2_.DeQue<float>();
                    AscendC::Muls(x2, x2, scaleB, count);
                    AscendC::Add(y, y, x2, count);
                    inQ2_.FreeTensor(x2);
                }
                if (cEff != 0.0f) {
                    AscendC::Adds(y, y, cEff, count);
                }
            }
            outQ_.EnQue(y);
            y = outQ_.DeQue<float>();
            if (tangent) {
                AscendC::DataCopyPad(tanOutF_[j][off], y,
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
            } else {
                AscendC::DataCopyPad(outF_[j][off], y,
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
            }
            outQ_.FreeTensor(y);
        }
    }

    __aicore__ inline int64_t RoundToInt(float value)
    {
        return static_cast<int64_t>(value >= 0.0f ? (value + 0.5f) : (value - 0.5f));
    }

    __aicore__ inline void ComputeIntLeaf(int32_t j)
    {
        const int64_t numel = tiling_->outNumel[j];
        int64_t cEff = RoundToInt(tiling_->outConst[j]);
        if (tiling_->outRed1[j] != 0) {
            cEff += RoundToInt(tiling_->outScale1[j] *
                               static_cast<float>(SumIntLeaf(tiling_->outSrc1[j])));
        }
        if (tiling_->nTerms[j] >= 2 && tiling_->outRed2[j] != 0) {
            cEff += RoundToInt(tiling_->outScale2[j] *
                               static_cast<float>(SumIntLeaf(tiling_->outSrc2[j])));
        }
        float scaleA = 1.0f;
        float scaleB = 1.0f;
        const int32_t srcA = ElemSrcA(j, scaleA);
        const int32_t srcB = ElemSrcB(j, scaleB);

        for (int64_t off = 0; off < numel; off += WHILE_TILE_ELEMS) {
            const int64_t remain = numel - off;
            const uint32_t count = static_cast<uint32_t>(
                (remain < WHILE_TILE_ELEMS) ? remain : WHILE_TILE_ELEMS);
            AscendC::LocalTensor<int32_t> y = outQ_.AllocTensor<int32_t>();
            if (srcA < 0) {
                // 只有归约项/常量：整块广播 cEff
                for (uint32_t i = 0; i < count; ++i) {
                    y.SetValue(static_cast<int32_t>(i), static_cast<int32_t>(cEff));
                }
            } else {
                AscendC::LocalTensor<int32_t> x1 = inQ1_.AllocTensor<int32_t>();
                AscendC::DataCopyPad(x1, inI_[srcA][off],
                    {1, static_cast<uint16_t>(count * sizeof(int32_t)), 0, 0},
                    {false, 0, 0, 0});
                inQ1_.EnQue(x1);
                x1 = inQ1_.DeQue<int32_t>();
                if (srcB >= 0) {
                    AscendC::LocalTensor<int32_t> x2 = inQ2_.AllocTensor<int32_t>();
                    AscendC::DataCopyPad(x2, inI_[srcB][off],
                        {1, static_cast<uint16_t>(count * sizeof(int32_t)), 0, 0},
                        {false, 0, 0, 0});
                    inQ2_.EnQue(x2);
                    x2 = inQ2_.DeQue<int32_t>();
                    AscendC::PipeBarrier<PIPE_ALL>();
                    for (uint32_t i = 0; i < count; ++i) {
                        int64_t val = cEff;
                        val += RoundToInt(scaleA * static_cast<float>(
                            x1.GetValue(static_cast<int32_t>(i))));
                        val += RoundToInt(scaleB * static_cast<float>(
                            x2.GetValue(static_cast<int32_t>(i))));
                        y.SetValue(static_cast<int32_t>(i), static_cast<int32_t>(val));
                    }
                    inQ2_.FreeTensor(x2);
                } else {
                    AscendC::PipeBarrier<PIPE_ALL>();
                    for (uint32_t i = 0; i < count; ++i) {
                        int64_t val = cEff;
                        val += RoundToInt(scaleA * static_cast<float>(
                            x1.GetValue(static_cast<int32_t>(i))));
                        y.SetValue(static_cast<int32_t>(i), static_cast<int32_t>(val));
                    }
                }
                inQ1_.FreeTensor(x1);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            outQ_.EnQue(y);
            y = outQ_.DeQue<int32_t>();
            AscendC::DataCopyPad(outI_[j][off], y,
                {1, static_cast<uint16_t>(count * sizeof(int32_t)), 0, 0});
            outQ_.FreeTensor(y);
        }
    }

    AscendC::TPipe *pipe_;
    const __gm__ WhileTilingData *tiling_;

    AscendC::GlobalTensor<float> inF_[WHILE_MAX_LEAVES];
    AscendC::GlobalTensor<int32_t> inI_[WHILE_MAX_LEAVES];
    AscendC::GlobalTensor<float> outF_[WHILE_MAX_LEAVES];
    AscendC::GlobalTensor<int32_t> outI_[WHILE_MAX_LEAVES];
    AscendC::GlobalTensor<float> tanInF_[WHILE_MAX_LEAVES];
    AscendC::GlobalTensor<float> tanOutF_[WHILE_MAX_LEAVES];
    AscendC::GlobalTensor<int32_t> counterGm_;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ1_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ2_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> scanQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> eviQ_;
};

// 核函数入口（可执行文件自检与共享库共用；blockNum=1，数据相关 cond 在单核内串行求值）
extern "C" __global__ __vector__ void jax_lax_while_loop_kernel(
    GM_ADDR in0, GM_ADDR in1, GM_ADDR in2, GM_ADDR in3,
    GM_ADDR in4, GM_ADDR in5, GM_ADDR in6, GM_ADDR in7,
    GM_ADDR out0, GM_ADDR out1, GM_ADDR out2, GM_ADDR out3,
    GM_ADDR out4, GM_ADDR out5, GM_ADDR out6, GM_ADDR out7,
    GM_ADDR tin0, GM_ADDR tin1, GM_ADDR tin2, GM_ADDR tin3,
    GM_ADDR tin4, GM_ADDR tin5, GM_ADDR tin6, GM_ADDR tin7,
    GM_ADDR tout0, GM_ADDR tout1, GM_ADDR tout2, GM_ADDR tout3,
    GM_ADDR tout4, GM_ADDR tout5, GM_ADDR tout6, GM_ADDR tout7,
    GM_ADDR counters, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelWhileLoop op(&pipe);
    op.Init(in0, in1, in2, in3, in4, in5, in6, in7,
            out0, out1, out2, out3, out4, out5, out6, out7,
            tin0, tin1, tin2, tin3, tin4, tin5, tin6, tin7,
            tout0, tout1, tout2, tout3, tout4, tout5, tout6, tout7,
            counters, tiling);
    op.Process();
}
