// ============================================================================
// Ascend C Kernel 实现 - jax_lax_scan（纯 kernel，不含 host 代码）
// ============================================================================
// 语义：JAX lax.scan 静态循环。给定 init carry（pytree）、xs（pytree / None）与静态 length，
//       逐步算 body(carry, x_t) -> (new_carry, y)，写回 final_carry 与 ys[t]。
//
// 计算分工（编码规则 A1：包装层不得代算）：
//   * 单核（blockNum=1）在 UB 里持有 carry，按 t 顺序遍历 [start, start+count)；
//   * 每一步从 GM 取 x_t（reverse 时取逻辑步 t 对应的原始索引 length-1-t），
//     用 AscendC 向量原语算 new_carry / y，再把 y 写回 ys 的**原始索引**位置；
//   * 整循环（compiled_whole_loop）一次 launch 走完 L 步；逐步（stepwise）每次 launch 走 1 步，
//     carry 在两次 launch 之间由调用方通过 carry_in/carry_out 缓冲轮换传递。
//
// body 分派见 op_kernel/jax_lax_scan_tiling.h 的 SCAN_BODY_* 常量；
// 非法改变 carry 的 body（4/5/6）在 Python trace 期就被拒绝，永不进入本 kernel。
// ============================================================================

#include "kernel_operator.h"
#include "jax_lax_scan_tiling.h"

class KernelScan {
public:
    __aicore__ inline KernelScan(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR c0In, GM_ADDR c1In, GM_ADDR x0In, GM_ADDR x1In,
                                GM_ADDR c0Out, GM_ADDR c1Out, GM_ADDR ysOut,
                                const __gm__ ScanTilingData *tilingData)
    {
        tiling = tilingData;
        width = tiling->width;
        int64_t aligned = ((width + SCAN_UB_ALIGN_ELEMS - 1) / SCAN_UB_ALIGN_ELEMS) * SCAN_UB_ALIGN_ELEMS;
        alignedWidth = static_cast<uint32_t>(aligned);

        c0InGm.SetGlobalBuffer((__gm__ float *)c0In, width);
        c0OutGm.SetGlobalBuffer((__gm__ float *)c0Out, width);
        ysGm.SetGlobalBuffer((__gm__ float *)ysOut, tiling->length * width);
        if (tiling->nXs >= 1) {
            x0Gm.SetGlobalBuffer((__gm__ float *)x0In, tiling->length * width);
        }
        if (tiling->nXs >= 2) {
            x1Gm.SetGlobalBuffer((__gm__ float *)x1In, tiling->length * width);
        }
        if (tiling->nCarry >= 2) {
            c1InGm.SetGlobalBuffer((__gm__ int32_t *)c1In, 1);
            c1OutGm.SetGlobalBuffer((__gm__ int32_t *)c1Out, 1);
        }

        // [CONFIG] UB 按 32B 对齐分配（W 可能小于 8 个 float，不能直接 width*sizeof(float)）
        pipe_->InitBuffer(carryBuf, alignedWidth * sizeof(float));
        pipe_->InitBuffer(inQ0, 1, alignedWidth * sizeof(float));
        pipe_->InitBuffer(inQ1, 1, alignedWidth * sizeof(float));
        pipe_->InitBuffer(outQ, 1, alignedWidth * sizeof(float));
        pipe_->InitBuffer(inQI, 1, SCAN_UB_ALIGN_ELEMS * sizeof(int32_t));
        pipe_->InitBuffer(outQI, 1, SCAN_UB_ALIGN_ELEMS * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> carry = carryBuf.Get<float>();

        // ---- 初始 carry：GM → UB（TQue 的 EnQue/DeQue 负责 MTE2 → V 同步）----
        AscendC::LocalTensor<float> init0 = inQ0.AllocTensor<float>();
        AscendC::DataCopyPad(init0, c0InGm,
            {1, static_cast<uint16_t>(width * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        inQ0.EnQue(init0);
        init0 = inQ0.DeQue<float>();
        AscendC::Adds(carry, init0, 0.0f, static_cast<uint32_t>(width));
        inQ0.FreeTensor(init0);

        // ---- 初始 counter（pytree carry 的 int32 叶子；单元素）----
        int32_t counter = 0;
        if (tiling->nCarry >= 2) {
            AscendC::LocalTensor<int32_t> ci = inQI.AllocTensor<int32_t>();
            AscendC::DataCopyPad(ci, c1InGm,
                {1, static_cast<uint16_t>(sizeof(int32_t)), 0, 0},
                {false, 0, 0, 0});
            inQI.EnQue(ci);
            ci = inQI.DeQue<int32_t>();
            counter = static_cast<int32_t>(ci.GetValue(0));
            inQI.FreeTensor(ci);
        }

        for (int64_t i = 0; i < tiling->count; ++i) {
            int64_t step = tiling->start + i;
            // reverse：逻辑步 t 消费原始索引 length-1-t，ys 仍按原始索引写回
            int64_t idx = (tiling->reverse != 0) ? (tiling->length - 1 - step) : step;
            StepOnce(idx, carry, counter);
        }

        WriteBackCarry(carry, counter);
    }

private:
    __aicore__ inline void StepOnce(int64_t idx,
                                    AscendC::LocalTensor<float> &carry, int32_t &counter)
    {
        uint32_t count = static_cast<uint32_t>(width);
        AscendC::LocalTensor<float> x0;
        AscendC::LocalTensor<float> x1;

        if (tiling->nXs >= 1) {
            x0 = inQ0.AllocTensor<float>();
            AscendC::DataCopyPad(x0, x0Gm[idx * width],
                {1, static_cast<uint16_t>(width * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQ0.EnQue(x0);
            x0 = inQ0.DeQue<float>();
        }
        if (tiling->nXs >= 2) {
            x1 = inQ1.AllocTensor<float>();
            AscendC::DataCopyPad(x1, x1Gm[idx * width],
                {1, static_cast<uint16_t>(width * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            inQ1.EnQue(x1);
            x1 = inQ1.DeQue<float>();
        }

        AscendC::LocalTensor<float> y = outQ.AllocTensor<float>();
        if (tiling->bodyId == SCAN_BODY_ADD) {
            // new = carry + x；y = new
            AscendC::Add(y, carry, x0, count);
            AscendC::Adds(carry, y, 0.0f, count);
        } else if (tiling->bodyId == SCAN_BODY_PYTREE) {
            // new = (counter+1, acc+x)；y = acc+x
            AscendC::Add(y, carry, x0, count);
            AscendC::Adds(carry, y, 0.0f, count);
            counter += 1;
        } else if (tiling->bodyId == SCAN_BODY_QUAD) {
            // new = 0.5*carry + x；y = new*new
            AscendC::Muls(y, carry, 0.5f, count);
            AscendC::Add(y, y, x0, count);
            AscendC::Adds(carry, y, 0.0f, count);
            AscendC::Mul(y, y, y, count);
        } else if (tiling->bodyId == SCAN_BODY_PYTREE_XS) {
            // new = carry + add*scale；y = new
            AscendC::Mul(y, x0, x1, count);
            AscendC::Add(y, y, carry, count);
            AscendC::Adds(carry, y, 0.0f, count);
        } else {
            // SCAN_BODY_XS_NONE：new = carry + 1.0；y = new
            AscendC::Adds(y, carry, 1.0f, count);
            AscendC::Adds(carry, y, 0.0f, count);
        }
        outQ.EnQue<float>(y);
        y = outQ.DeQue<float>();
        // ys 按**原始索引**写回：reverse 时逻辑步 t 消费的是 x[length-1-t]，
        // 该步结果属于原始位置 idx（JAX 语义：先反转 xs，扫描后再把 ys 反转回来）。
        AscendC::DataCopyPad(ysGm[idx * width], y,
            {1, static_cast<uint16_t>(width * sizeof(float)), 0, 0});
        outQ.FreeTensor(y);

        if (tiling->nXs >= 1) {
            inQ0.FreeTensor(x0);
        }
        if (tiling->nXs >= 2) {
            inQ1.FreeTensor(x1);
        }
    }

    __aicore__ inline void WriteBackCarry(AscendC::LocalTensor<float> &carry, int32_t counter)
    {
        AscendC::LocalTensor<float> co = outQ.AllocTensor<float>();
        AscendC::Adds(co, carry, 0.0f, static_cast<uint32_t>(width));
        outQ.EnQue<float>(co);
        co = outQ.DeQue<float>();
        AscendC::DataCopyPad(c0OutGm, co,
            {1, static_cast<uint16_t>(width * sizeof(float)), 0, 0});
        outQ.FreeTensor(co);

        if (tiling->nCarry >= 2) {
            AscendC::LocalTensor<int32_t> ci = outQI.AllocTensor<int32_t>();
            AscendC::Duplicate(ci, counter, static_cast<int32_t>(SCAN_UB_ALIGN_ELEMS));
            outQI.EnQue(ci);
            ci = outQI.DeQue<int32_t>();
            AscendC::DataCopyPad(c1OutGm, ci,
                {1, static_cast<uint16_t>(sizeof(int32_t)), 0, 0});
            outQI.FreeTensor(ci);
        }
    }

    AscendC::TPipe *pipe_;
    const __gm__ ScanTilingData *tiling;

    AscendC::GlobalTensor<float> c0InGm;
    AscendC::GlobalTensor<float> c0OutGm;
    AscendC::GlobalTensor<float> ysGm;
    AscendC::GlobalTensor<float> x0Gm;
    AscendC::GlobalTensor<float> x1Gm;
    AscendC::GlobalTensor<int32_t> c1InGm;
    AscendC::GlobalTensor<int32_t> c1OutGm;

    AscendC::TBuf<AscendC::TPosition::VECCALC> carryBuf;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ0;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ1;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQI;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQI;

    uint32_t alignedWidth;
    int64_t width;
};

// 核函数入口（可执行文件与共享库共用；blockNum 恒为 1：carry 必须跨步保持在 UB 内）
extern "C" __global__ __vector__ void jax_lax_scan_kernel(
    GM_ADDR c0In, GM_ADDR c1In, GM_ADDR x0In, GM_ADDR x1In,
    GM_ADDR c0Out, GM_ADDR c1Out, GM_ADDR ysOut, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelScan op(&pipe);
    op.Init(c0In, c1In, x0In, x1In, c0Out, c1Out, ysOut, (__gm__ ScanTilingData *)tiling);
    op.Process();
}
