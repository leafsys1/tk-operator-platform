// ============================================================================
// jax_lax_scan · Python 调用接口的 C ABI 实现（libjax_lax_scan_host.so）
// ============================================================================
// 供 ops/jax_lax_scan/python/jax_lax_scan.py 用 ctypes 加载。
//
// 分工（编码规则 A1）：本层只做参数校验 + Tiling + kernel launch，**不做任何数值计算**；
// 全部 body 语义在 op_kernel/jax_lax_scan_kernel.asc 里用 AscendC 向量原语实现。
//
// 与 elementwise_sub_pyapi.asc 的差异：本算子支持一次 launch 走完整循环（compiled_whole_loop）
// 或每次 launch 走 1 步（stepwise）；carry 通过 carry_in/carry_out 设备缓冲在两次 launch 之间传递，
// 两次 launch 的时序同步由调用方负责（Python 层在同一 stream 语义下串行调用；本层每次 launch 结束
// 都 aclrtSynchronizeStream，保证 carry_out 可被下一次 launch 读到）。
//
// 返回码：0 成功 / 1 运行失败 / 2 参数错误 / 3 carry 不变式拒绝 / 4 显式 unsupported。
// unsupported（4）不在本层产生：AD 在 Python 层走 JAX trace，`.so` 没有自动微分。
//
// 约束：不 aclFinalize —— Python 进程可能的其它 ACL 使用者（torch_npu / PJRT）由调用方管理生命周期；
// 本库只做一次 aclInit（明确失败才报错）+ aclrtSetDevice + 建流 + 同步。
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <cstring>

#include "acl/acl.h"
#include "../op_kernel/jax_lax_scan_tiling.h"
// 与可执行文件共用同一份 device 侧实现（kernel 代码在共享库里同样打进去）
#include "../op_kernel/jax_lax_scan_kernel.asc"
#include "jax_lax_scan_abi.h"

namespace {

const char *CodeName(int rc)
{
    switch (rc) {
        case SCAN_RC_BAD_ARGS: return "invalid_argument";
        case SCAN_RC_CARRY_SHAPE_MISMATCH: return "carry_shape_mismatch";
        case SCAN_RC_UNSUPPORTED: return "autodiff_unsupported";
        case SCAN_RC_RUN_FAILED: return "device_error";
        default: return "error";
    }
}

// err 由调用方提供；args 是 const，但 err 指向的缓冲区是调用方的可写内存。
void WriteErr(const jax_lax_scan_args_t *args, int rc, const char *detail)
{
    if (args == nullptr || args->err == nullptr || args->err_len <= 0) {
        return;
    }
    char *buf = static_cast<char *>(const_cast<void *>(args->err));
    (void)snprintf(buf, static_cast<size_t>(args->err_len), "%s: %s", CodeName(rc),
                   (detail == nullptr) ? "" : detail);
}

int Validate(const jax_lax_scan_args_t *args, char *detail, size_t detailLen)
{
    if (args->abi_version != JAX_LAX_SCAN_ABI_VERSION) {
        (void)snprintf(detail, detailLen, "abi_version=%d（期望 %d）", args->abi_version,
                       JAX_LAX_SCAN_ABI_VERSION);
        return SCAN_RC_BAD_ARGS;
    }
    const int32_t body = args->body_id;
    const bool knownBody = (body == SCAN_BODY_ADD) || (body == SCAN_BODY_PYTREE) ||
                           (body == SCAN_BODY_QUAD) || (body == SCAN_BODY_PYTREE_XS) ||
                           (body == SCAN_BODY_XS_NONE);
    if (!knownBody) {
        (void)snprintf(detail, detailLen, "body_id=%d 不是已注册的可执行 body", body);
        return SCAN_RC_BAD_ARGS;
    }
    if (args->reverse != 0 && args->reverse != 1) {
        (void)snprintf(detail, detailLen, "reverse=%d 只能是 0/1", args->reverse);
        return SCAN_RC_BAD_ARGS;
    }
    if (args->length < 1) {
        (void)snprintf(detail, detailLen, "length=%lld 必须 >= 1", static_cast<long long>(args->length));
        return SCAN_RC_BAD_ARGS;
    }
    // carry 浮点累加器叶子：pytree carry 的叶子顺序由调用方 flatten 顺序决定（counter 可能在前），
    // 因此先按 dtype 找 float32 叶子，width 取它的元素数（不能盲取下标 0）。
    int32_t floatIdx = 0;
    int32_t intIdx = 1;
    if (args->n_carry >= 2 && args->carry_dtype[0] == SCAN_DTYPE_I32) {
        floatIdx = 1;
        intIdx = 0;
    }
    const int64_t width = args->carry_numel[floatIdx];
    if (width < 1 || width > SCAN_MAX_WIDTH) {
        (void)snprintf(detail, detailLen, "carry_numel[float]=%lld 超出 [1, %lld]",
                       static_cast<long long>(width), static_cast<long long>(SCAN_MAX_WIDTH));
        return SCAN_RC_BAD_ARGS;
    }
    // ---- carry 不变式（必须在任何 device kernel 启动前拒绝，ABI 不变量 3）----
    const int32_t wantCarry = (body == SCAN_BODY_PYTREE) ? 2 : 1;
    if (args->n_carry != wantCarry) {
        (void)snprintf(detail, detailLen, "body=%d 需要 %d 个 carry 叶子，收到 n_carry=%d",
                       body, wantCarry, args->n_carry);
        return SCAN_RC_CARRY_SHAPE_MISMATCH;
    }
    if (wantCarry == 1 && args->carry_dtype[floatIdx] != SCAN_DTYPE_F32) {
        (void)snprintf(detail, detailLen, "body=%d 的单叶子 carry 必须是 float32（收到 dtype=%d）",
                       body, args->carry_dtype[floatIdx]);
        return SCAN_RC_CARRY_SHAPE_MISMATCH;
    }
    if (wantCarry == 2) {
        // pytree carry 的叶子顺序由调用方的 pytree flatten 顺序决定（fixtures 的 tuple 是
        // (int32 counter, f32 acc)，即 counter 在前），因此这里按 dtype 校验集合，不假定下标：
        //   - 恰好 1 个 float32 叶子（accumulator，元素数 = width）
        //   - 恰好 1 个 int32 叶子（counter，元素数 = 1）
        const int32_t dtypeA = args->carry_dtype[0];
        const int32_t dtypeB = args->carry_dtype[1];
        const bool pairOk = ((dtypeA == SCAN_DTYPE_F32 && dtypeB == SCAN_DTYPE_I32) ||
                             (dtypeA == SCAN_DTYPE_I32 && dtypeB == SCAN_DTYPE_F32));
        if (!pairOk) {
            (void)snprintf(detail, detailLen,
                           "pytree carry 必须是 (float32 acc, int32 counter)，收到 dtype=(%d, %d)",
                           dtypeA, dtypeB);
            return SCAN_RC_CARRY_SHAPE_MISMATCH;
        }
        if (args->carry_numel[intIdx] != 1) {
            (void)snprintf(detail, detailLen, "pytree carry 的 int32 counter 必须是 1 个元素（numel=%lld）",
                           static_cast<long long>(args->carry_numel[intIdx]));
            return SCAN_RC_CARRY_SHAPE_MISMATCH;
        }
    }
    const int64_t totalLength = (args->total_length > 0) ? args->total_length : args->length;
    if (args->ys_numel != totalLength * width) {
        (void)snprintf(detail, detailLen, "ys_numel=%lld != total_length*width=%lld",
                       static_cast<long long>(args->ys_numel),
                       static_cast<long long>(totalLength * width));
        return SCAN_RC_CARRY_SHAPE_MISMATCH;
    }
    // ---- xs 形态 ----
    const int32_t wantXs = (body == SCAN_BODY_XS_NONE) ? 0 : ((body == SCAN_BODY_PYTREE_XS) ? 2 : 1);
    if (args->n_xs != wantXs) {
        (void)snprintf(detail, detailLen, "body=%d 需要 %d 个 xs 叶子，收到 n_xs=%d",
                       body, wantXs, args->n_xs);
        return SCAN_RC_BAD_ARGS;
    }
    for (int32_t i = 0; i < args->n_xs; ++i) {
        if (args->xs_numel[i] != totalLength * width) {
            (void)snprintf(detail, detailLen, "xs_numel[%d]=%lld != total_length*width=%lld",
                           i, static_cast<long long>(args->xs_numel[i]),
                           static_cast<long long>(totalLength * width));
            return SCAN_RC_BAD_ARGS;
        }
    }
    const int64_t stepCount = (args->step_count > 0) ? args->step_count : totalLength;
    if (args->step_start < 0 || stepCount < 1 || args->step_start + stepCount > totalLength) {
        (void)snprintf(detail, detailLen, "step 区间非法：start=%lld count=%lld total=%lld",
                       static_cast<long long>(args->step_start), static_cast<long long>(stepCount),
                       static_cast<long long>(totalLength));
        return SCAN_RC_BAD_ARGS;
    }
    if (args->carry_in[0] == nullptr || args->carry_out[0] == nullptr || args->ys_out == nullptr) {
        (void)snprintf(detail, detailLen, "carry_in/carry_out/ys 设备地址不能为空");
        return SCAN_RC_BAD_ARGS;
    }
    return SCAN_RC_OK;
}

int Launch(const jax_lax_scan_args_t *args, char *detail, size_t detailLen)
{
    // kernel 的槽位固定为：carry 浮点累加器 / int32 counter。调用方的叶子顺序可能相反
    // （fixtures 的 tuple carry 是 counter 在前），因此按 dtype 映射到固定槽位。
    int32_t floatIdx = 0;
    int32_t intIdx = 1;
    if (args->n_carry >= 2 && args->carry_dtype[0] == SCAN_DTYPE_I32) {
        floatIdx = 1;
        intIdx = 0;
    }

    ScanTilingData tiling{};
    tiling.bodyId = args->body_id;
    tiling.reverse = args->reverse;
    tiling.nCarry = args->n_carry;
    tiling.nXs = args->n_xs;
    tiling.length = (args->total_length > 0) ? args->total_length : args->length;
    tiling.width = args->carry_numel[floatIdx];
    tiling.start = args->step_start;
    tiling.count = (args->step_count > 0) ? args->step_count : tiling.length;

    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtCreateStream 失败");
        return SCAN_RC_RUN_FAILED;
    }
    void *tilingDevice = nullptr;
    int rc = SCAN_RC_RUN_FAILED;
    if (aclrtMalloc(&tilingDevice, sizeof(ScanTilingData), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtMalloc(tiling) 失败");
    } else if (aclrtMemcpy(tilingDevice, sizeof(ScanTilingData), &tiling, sizeof(ScanTilingData),
                           ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtMemcpy(tiling) 失败");
    } else {
        jax_lax_scan_kernel<<<1, nullptr, stream>>>(
            reinterpret_cast<uint8_t *>(args->carry_in[floatIdx]),
            reinterpret_cast<uint8_t *>((args->n_carry >= 2) ? args->carry_in[intIdx] : nullptr),
            reinterpret_cast<uint8_t *>((args->n_xs >= 1) ? args->xs[0] : nullptr),
            reinterpret_cast<uint8_t *>((args->n_xs >= 2) ? args->xs[1] : nullptr),
            reinterpret_cast<uint8_t *>(args->carry_out[floatIdx]),
            reinterpret_cast<uint8_t *>((args->n_carry >= 2) ? args->carry_out[intIdx] : nullptr),
            reinterpret_cast<uint8_t *>(args->ys_out),
            reinterpret_cast<uint8_t *>(tilingDevice));
        if (aclrtSynchronizeStream(stream) == ACL_SUCCESS) {
            rc = SCAN_RC_OK;
        } else {
            (void)snprintf(detail, detailLen, "kernel 执行失败（aclrtSynchronizeStream 非 0）");
        }
    }
    if (tilingDevice != nullptr) {
        (void)aclrtFree(tilingDevice);
    }
    (void)aclrtDestroyStream(stream);
    return rc;
}

bool g_aclInited = false;

}  // namespace

extern "C" {

int jax_lax_scan_run(const jax_lax_scan_args_t *args)
{
    if (args == nullptr) {
        return SCAN_RC_BAD_ARGS;
    }
    char detail[256] = {0};
    int rc = Validate(args, detail, sizeof(detail));
    if (rc != SCAN_RC_OK) {
        WriteErr(args, rc, detail);
        return rc;
    }
    if (!g_aclInited) {
        aclError initRet = aclInit(nullptr);
        // 已经初始化（例如 torch_npu / PJRT 先初始化过）也视为可用：用 aclrtGetDeviceCount
        // 探测运行时上下文是否真的可用，避免依赖特定版本的重复初始化错误码。
        if (initRet != ACL_SUCCESS) {
            uint32_t deviceCount = 0;
            if (aclrtGetDeviceCount(&deviceCount) != ACL_SUCCESS || deviceCount <= 0) {
                WriteErr(args, SCAN_RC_RUN_FAILED, "aclInit 失败且 ACL 上下文不可用");
                return SCAN_RC_RUN_FAILED;
            }
        }
        g_aclInited = true;
    }
    if (aclrtSetDevice(args->device_id) != ACL_SUCCESS) {
        WriteErr(args, SCAN_RC_RUN_FAILED, "aclrtSetDevice 失败");
        return SCAN_RC_RUN_FAILED;
    }
    rc = Launch(args, detail, sizeof(detail));
    if (rc != SCAN_RC_OK) {
        WriteErr(args, rc, detail);
    }
    return rc;
}

const char *jax_lax_scan_abi_version(void)
{
    return "opx-scan-python-abi/2";
}

int jax_lax_scan_acl_init(void)
{
    if (g_aclInited) {
        return SCAN_RC_OK;
    }
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        uint32_t deviceCount = 0;
        if (aclrtGetDeviceCount(&deviceCount) != ACL_SUCCESS || deviceCount <= 0) {
            return SCAN_RC_RUN_FAILED;
        }
    }
    // 显式绑定 device 0：CLI 的第一次设备操作是 jax_lax_scan_malloc（aclrtMalloc），
    // 它发生在 jax_lax_scan_run 的 aclrtSetDevice 之前。若 ACL 要求先有 device 上下文，
    // 未绑定时首个 malloc 会失败（与 elementwise_sub 的 host 入口顺序保持一致）。
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        return SCAN_RC_RUN_FAILED;
    }
    g_aclInited = true;
    return SCAN_RC_OK;
}

int jax_lax_scan_malloc(void **devPtr, int64_t bytes)
{
    if (devPtr == nullptr || bytes <= 0) {
        return SCAN_RC_BAD_ARGS;
    }
    if (aclrtMalloc(devPtr, static_cast<size_t>(bytes), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return SCAN_RC_RUN_FAILED;
    }
    return SCAN_RC_OK;
}

int jax_lax_scan_free(void *devPtr)
{
    if (devPtr == nullptr) {
        return SCAN_RC_OK;
    }
    return (aclrtFree(devPtr) == ACL_SUCCESS) ? SCAN_RC_OK : SCAN_RC_RUN_FAILED;
}

int jax_lax_scan_h2d(void *devPtr, const void *hostPtr, int64_t bytes)
{
    if (devPtr == nullptr || hostPtr == nullptr || bytes <= 0) {
        return SCAN_RC_BAD_ARGS;
    }
    return (aclrtMemcpy(devPtr, static_cast<size_t>(bytes), hostPtr, static_cast<size_t>(bytes),
                        ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS)
               ? SCAN_RC_OK
               : SCAN_RC_RUN_FAILED;
}

int jax_lax_scan_d2h(void *hostPtr, const void *devPtr, int64_t bytes)
{
    if (hostPtr == nullptr || devPtr == nullptr || bytes <= 0) {
        return SCAN_RC_BAD_ARGS;
    }
    return (aclrtMemcpy(hostPtr, static_cast<size_t>(bytes), devPtr, static_cast<size_t>(bytes),
                        ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS)
               ? SCAN_RC_OK
               : SCAN_RC_RUN_FAILED;
}

}  // extern "C"
