// [MODIFY] Kernel 类 - 封装 NPU 上的计算逻辑
class KernelAdd {
public:
    __aicore__ inline KernelAdd(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    // [MODIFY] 根据你的算子修改 Init 参数和 Global Tensor
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const __gm__ AddTilingData* tiling)
    {
        this->tiling = tiling;
        tileLength = tiling->tileLength;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / tileLength;
            tailTileElementNum = tileLength;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + (tileLength - 1)) / tileLength;
            tailTileElementNum = total - tileLength * (tileNum - 1);
        }

        // [MODIFY] 根据你的输入/输出数量调整 Global Tensor
        xGm.SetGlobalBuffer((__gm__ float *)x + blockIdx * tiling->numPerCore, total);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockIdx * tiling->numPerCore, total);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockIdx * tiling->numPerCore, total);

        // UB buffer 按最大 tile 分配：tileLength 运行时可调（小 shape 512 / 大 shape 4096）
        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER, MAX_TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(inQueueY, DOUBLE_BUFFER, MAX_TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(outQueueZ, DOUBLE_BUFFER, MAX_TILE_LENGTH * sizeof(float));
    }

    // 分块循环：**每块都要推进 GM 偏移**。
    // ⚠️ 这是相对 CANNBot 样例（add_custom）的一处**必要修正**：样例里的 CopyIn/CopyOut 一直用
    //    xGm/yGm/zGm 的基址、不按 TILE 推进，只有「每核恰好 1 个 TILE」时才正确 ——
    //    样例 host 的 tiling 刚好让它成立（totalTiles ≤ 核数），所以这个洞一直没暴露。
    //    2026-10-15 实测：N=1048576/1048575（每核 6 个 TILE）时，每核只有第一个 TILE 有结果、
    //    其余为 0（matched_ratio 0.168）。用例矩阵 add_edge_006 就是为锁住这条路加的。
    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t offset = i * tileLength;
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : tileLength;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        AscendC::DataCopyPad(xLocal, xGm[offset],
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(yLocal, yGm[offset],
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
            {false, 0, 0, 0});

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        AscendC::Add(zLocal, xLocal, yLocal, count);

        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopyPad(zGm[offset], zLocal,
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ AddTilingData* tiling;

    // [MODIFY] 根据你的输入/输出数量调整
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;

    uint32_t total;
    uint32_t tileLength;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// [MODIFY] 核函数入口 - elementwise_add → <your_op>（保持 _kernel 后缀）
extern "C" __global__ __vector__ void elementwise_add_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelAdd op(&pipe);
    op.Init(x, y, z, (__gm__ AddTilingData*)tiling);
