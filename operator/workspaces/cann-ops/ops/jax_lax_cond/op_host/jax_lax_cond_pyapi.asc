// ============================================================================
// jax_lax_cond · Python 调用接口的 C ABI 实现（libjax_lax_cond_host.so）
// ============================================================================
// 供 ops/jax_lax_cond/python/jax_lax_cond.py 用 ctypes 加载。
//
// 分工（编码规则 A1）：本层只做参数校验 + Tiling + kernel launch + 证据 D2H，
// **不做任何数值计算**；全部逐叶语义在 op_kernel/jax_lax_cond_kernel.asc 里用
// AscendC 向量原语实现。
//
// 一次调用只启动被 pred 选中的那一支（branch_id），因此运行期执行计数天然只有一支；
// token/counters 由 kernel 写入设备内存，本层在 stream 同步后读回 host，Python 不自报。
//
// 返回码：0 成功 / 1 运行失败 / 2 参数错误；拒绝（3）在 Python 层设备操作前完成。
// 约束：不 aclFinalize —— 进程内其它 ACL 使用者（PJRT/xla-npu）的生命周期由调用方管理。
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <cstring>

#include "acl/acl.h"
#include "../op_kernel/jax_lax_cond_tiling.h"
// 与可执行文件共用同一份 device 侧实现（kernel 代码在共享库里同样打进去）
#include "../op_kernel/jax_lax_cond_kernel.asc"
#include "jax_lax_cond_abi.h"

namespace {

const char *CodeName(int rc)
{
    switch (rc) {
        case COND_RC_BAD_ARGS: return "invalid_argument";
        case COND_RC_RUN_FAILED: return "device_error";
        case COND_RC_REJECT: return "reject";
        default: return "error";
    }
}

// err 由调用方提供；args 是 const，但 err 指向的缓冲区是调用方的可写内存。
void WriteErr(const jax_lax_cond_args_t *args, int rc, const char *detail)
{
    if (args == nullptr || args->err == nullptr || args->err_len <= 0) {
        return;
    }
    char *buf = static_cast<char *>(const_cast<void *>(args->err));
    (void)snprintf(buf, static_cast<size_t>(args->err_len), "%s: %s", CodeName(rc),
                   (detail == nullptr) ? "" : detail);
}

bool KnownOp(int32_t op)
{
    return op == COND_OP_ADD1 || op == COND_OP_SUB1 || op == COND_OP_MUL2 ||
           op == COND_OP_HALF || op == COND_OP_AFFINE_TRUE || op == COND_OP_AFFINE_FALSE;
}

int Validate(const jax_lax_cond_args_t *args, char *detail, size_t detailLen)
{
    if (args == nullptr) {
        return COND_RC_BAD_ARGS;
    }
    if (args->abi_version != JAX_LAX_COND_ABI_VERSION) {
        (void)snprintf(detail, detailLen, "abi_version=%d（期望 %d）", args->abi_version,
                       JAX_LAX_COND_ABI_VERSION);
        return COND_RC_BAD_ARGS;
    }
    if (args->branch_id != 1 && args->branch_id != 2) {
        (void)snprintf(detail, detailLen, "branch_id=%d 只能是 1/2", args->branch_id);
        return COND_RC_BAD_ARGS;
    }
    if (args->n_inputs < 1 || args->n_inputs > COND_MAX_LEAVES) {
        (void)snprintf(detail, detailLen, "n_inputs=%d 超出 [1, %d]", args->n_inputs,
                       COND_MAX_LEAVES);
        return COND_RC_BAD_ARGS;
    }
    if (args->n_outputs < 1 || args->n_outputs > COND_MAX_LEAVES) {
        (void)snprintf(detail, detailLen, "n_outputs=%d 超出 [1, %d]", args->n_outputs,
                       COND_MAX_LEAVES);
        return COND_RC_BAD_ARGS;
    }
    if (args->token == nullptr || args->counters == nullptr) {
        (void)snprintf(detail, detailLen, "token/counters host 缓冲区不能为空");
        return COND_RC_BAD_ARGS;
    }
    for (int32_t i = 0; i < args->n_inputs; ++i) {
        if (args->dtype[i] != COND_DTYPE_F32) {
            (void)snprintf(detail, detailLen, "dtype[%d]=%d 不是 float32", i, args->dtype[i]);
            return COND_RC_BAD_ARGS;
        }
        if (args->in[i] == nullptr || args->in_numel[i] <= 0) {
            (void)snprintf(detail, detailLen, "输入叶子 %d 地址/元素数非法", i);
            return COND_RC_BAD_ARGS;
        }
    }
    for (int32_t j = 0; j < args->n_outputs; ++j) {
        if (args->out[j] == nullptr || args->out_numel[j] <= 0) {
            (void)snprintf(detail, detailLen, "输出叶子 %d 地址/元素数非法", j);
            return COND_RC_BAD_ARGS;
        }
        if (args->out_src[j] < 0 || args->out_src[j] >= args->n_inputs) {
            (void)snprintf(detail, detailLen, "out_src[%d]=%d 超出输入叶子范围", j,
                           args->out_src[j]);
            return COND_RC_BAD_ARGS;
        }
        if (!KnownOp(args->out_op[j])) {
            (void)snprintf(detail, detailLen, "out_op[%d]=%d 不是已注册原语", j,
                           args->out_op[j]);
            return COND_RC_BAD_ARGS;
        }
        const int64_t stride = (args->out_stride[j] > 0) ? args->out_stride[j] : 1;
        if (stride > 1 && args->out_numel[j] > COND_MAX_STRIDED_ELEMS) {
            (void)snprintf(detail, detailLen,
                           "跨步叶子 %d 的 out_numel=%lld 超过 DataCopy blockCount 上限 %lld",
                           j, static_cast<long long>(args->out_numel[j]),
                           static_cast<long long>(COND_MAX_STRIDED_ELEMS));
            return COND_RC_BAD_ARGS;
        }
        if (stride > 1 && args->in_numel[args->out_src[j]] > COND_TILE_ELEMS) {
            (void)snprintf(detail, detailLen,
                           "跨步叶子 %d 的源输入 numel=%lld 超过单个 UB tile %lld",
                           j, static_cast<long long>(args->in_numel[args->out_src[j]]),
                           static_cast<long long>(COND_TILE_ELEMS));
            return COND_RC_BAD_ARGS;
        }
        const int64_t last = (args->out_numel[j] - 1) * stride;
        if (last >= args->in_numel[args->out_src[j]]) {
            (void)snprintf(detail, detailLen,
                           "输出叶子 %d 的取数范围 [0,%lld] 超出输入叶子 %d 的 numel=%lld",
                           j, static_cast<long long>(last), args->out_src[j],
                           static_cast<long long>(args->in_numel[args->out_src[j]]));
            return COND_RC_BAD_ARGS;
        }
    }
    return COND_RC_OK;
}

int Launch(const jax_lax_cond_args_t *args, char *detail, size_t detailLen)
{
    CondTilingData tiling{};
    tiling.branchId = args->branch_id;
    tiling.nInputs = args->n_inputs;
    tiling.nOutputs = args->n_outputs;
    int64_t totalTiles = 0;
    for (int32_t i = 0; i < COND_MAX_LEAVES; ++i) {
        tiling.inNumel[i] = args->in_numel[i];
        tiling.outNumel[i] = args->out_numel[i];
        tiling.outSrc[i] = args->out_src[i];
        tiling.outOp[i] = args->out_op[i];
        tiling.outStride[i] = (args->out_stride[i] > 0) ? args->out_stride[i] : 1;
        if (i < args->n_outputs && tiling.outStride[i] == 1) {
            totalTiles += (tiling.outNumel[i] + COND_TILE_ELEMS - 1) / COND_TILE_ELEMS;
        }
    }

    int64_t cores = 0;
    if (aclrtGetDeviceInfo(args->device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores) != ACL_SUCCESS ||
        cores <= 0) {
        (void)snprintf(detail, detailLen, "aclrtGetDeviceInfo(VECTOR_CORE_NUM) 失败");
        return COND_RC_RUN_FAILED;
    }
    int64_t blockNum = (totalTiles < cores) ? totalTiles : cores;
    if (blockNum < 1) {
        blockNum = 1;
    }

    aclrtStream stream = nullptr;
    void *tilingDevice = nullptr;
    void *tokenDevice = nullptr;
    void *counterDevice = nullptr;
    int rc = COND_RC_RUN_FAILED;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtCreateStream 失败");
        return COND_RC_RUN_FAILED;
    }
    const bool allocOk =
        aclrtMalloc(&tilingDevice, sizeof(CondTilingData), ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
        aclrtMalloc(&tokenDevice, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
        aclrtMalloc(&counterDevice, 2 * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    if (!allocOk) {
        (void)snprintf(detail, detailLen, "aclrtMalloc(tiling/evidence) 失败");
    } else if (aclrtMemcpy(tilingDevice, sizeof(CondTilingData), &tiling, sizeof(CondTilingData),
                           ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtMemcpy(tiling) 失败");
    } else if (aclrtMemset(tokenDevice, sizeof(int32_t), 0, sizeof(int32_t)) != ACL_SUCCESS ||
               aclrtMemset(counterDevice, 2 * sizeof(int32_t), 0, 2 * sizeof(int32_t)) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtMemset(token/counters) 失败");
    } else {
        jax_lax_cond_kernel<<<blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(args->in[0]), static_cast<uint8_t *>(args->in[1]),
            static_cast<uint8_t *>(args->in[2]), static_cast<uint8_t *>(args->in[3]),
            static_cast<uint8_t *>(args->in[4]), static_cast<uint8_t *>(args->in[5]),
            static_cast<uint8_t *>(args->in[6]), static_cast<uint8_t *>(args->in[7]),
            static_cast<uint8_t *>(args->out[0]), static_cast<uint8_t *>(args->out[1]),
            static_cast<uint8_t *>(args->out[2]), static_cast<uint8_t *>(args->out[3]),
            static_cast<uint8_t *>(args->out[4]), static_cast<uint8_t *>(args->out[5]),
            static_cast<uint8_t *>(args->out[6]), static_cast<uint8_t *>(args->out[7]),
            static_cast<uint8_t *>(tokenDevice), static_cast<uint8_t *>(counterDevice),
            static_cast<uint8_t *>(tilingDevice));
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
            (void)snprintf(detail, detailLen, "kernel 执行失败（aclrtSynchronizeStream 非 0）");
        } else if (aclrtMemcpy(args->token, sizeof(int32_t), tokenDevice, sizeof(int32_t),
                               ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS ||
                   aclrtMemcpy(args->counters, 2 * sizeof(int32_t), counterDevice,
                               2 * sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            (void)snprintf(detail, detailLen, "证据 D2H 读回失败");
        } else {
            rc = COND_RC_OK;
        }
    }
    if (tilingDevice != nullptr) {
        (void)aclrtFree(tilingDevice);
    }
    if (tokenDevice != nullptr) {
        (void)aclrtFree(tokenDevice);
    }
    if (counterDevice != nullptr) {
        (void)aclrtFree(counterDevice);
    }
    (void)aclrtDestroyStream(stream);
    return rc;
}

bool g_aclInited = false;

}  // namespace

extern "C" {

int jax_lax_cond_run(const jax_lax_cond_args_t *args)
{
    if (args == nullptr) {
        return COND_RC_BAD_ARGS;
    }
    char detail[256] = {0};
    int rc = Validate(args, detail, sizeof(detail));
    if (rc != COND_RC_OK) {
        WriteErr(args, rc, detail);
        return rc;
    }
    if (!g_aclInited) {
        aclError initRet = aclInit(nullptr);
        // 已经初始化（PJRT / 其它 ACL 使用者先初始化过）也视为可用。
        if (initRet != ACL_SUCCESS) {
            uint32_t deviceCount = 0;
            if (aclrtGetDeviceCount(&deviceCount) != ACL_SUCCESS || deviceCount <= 0) {
                WriteErr(args, COND_RC_RUN_FAILED, "aclInit 失败且 ACL 上下文不可用");
                return COND_RC_RUN_FAILED;
            }
        }
        g_aclInited = true;
    }
    if (aclrtSetDevice(args->device_id) != ACL_SUCCESS) {
        WriteErr(args, COND_RC_RUN_FAILED, "aclrtSetDevice 失败");
        return COND_RC_RUN_FAILED;
    }
    rc = Launch(args, detail, sizeof(detail));
    if (rc != COND_RC_OK) {
        WriteErr(args, rc, detail);
    }
    return rc;
}

const char *jax_lax_cond_abi_version(void)
{
    return "opx-cond-python-abi/1";
}

int jax_lax_cond_acl_init(void)
{
    if (g_aclInited) {
        return COND_RC_OK;
    }
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        uint32_t deviceCount = 0;
        if (aclrtGetDeviceCount(&deviceCount) != ACL_SUCCESS || deviceCount <= 0) {
            return COND_RC_RUN_FAILED;
        }
    }
    // CLI 的第一次设备操作是 malloc（aclrtMalloc），发生在 run() 的 aclrtSetDevice 之前；
    // 先绑定 device 0，保证首个 malloc 有上下文（与 scan/sub 的 host 入口顺序一致）。
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        return COND_RC_RUN_FAILED;
    }
    g_aclInited = true;
    return COND_RC_OK;
}

int jax_lax_cond_malloc(void **devPtr, int64_t bytes)
{
    if (devPtr == nullptr || bytes <= 0) {
        return COND_RC_BAD_ARGS;
    }
    return (aclrtMalloc(devPtr, static_cast<size_t>(bytes), ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS)
               ? COND_RC_OK
               : COND_RC_RUN_FAILED;
}

int jax_lax_cond_free(void *devPtr)
{
    if (devPtr == nullptr) {
        return COND_RC_OK;
    }
    return (aclrtFree(devPtr) == ACL_SUCCESS) ? COND_RC_OK : COND_RC_RUN_FAILED;
}

int jax_lax_cond_h2d(void *devPtr, const void *hostPtr, int64_t bytes)
{
    if (devPtr == nullptr || hostPtr == nullptr || bytes <= 0) {
        return COND_RC_BAD_ARGS;
    }
    return (aclrtMemcpy(devPtr, static_cast<size_t>(bytes), hostPtr, static_cast<size_t>(bytes),
                        ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS)
               ? COND_RC_OK
               : COND_RC_RUN_FAILED;
}

int jax_lax_cond_d2h(void *hostPtr, const void *devPtr, int64_t bytes)
{
    if (hostPtr == nullptr || devPtr == nullptr || bytes <= 0) {
        return COND_RC_BAD_ARGS;
    }
    return (aclrtMemcpy(hostPtr, static_cast<size_t>(bytes), devPtr, static_cast<size_t>(bytes),
                        ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS)
               ? COND_RC_OK
               : COND_RC_RUN_FAILED;
}

}  // extern "C"
