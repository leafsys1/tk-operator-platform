// ============================================================================
// Ascend C Kernel 实现 - jax_lax_cond（纯 kernel，不含 host 代码）
// ============================================================================
// 语义：JAX lax.cond 在设备侧的“已选分支执行”。Python 层完成两分支 trace、
// 结构/shape/dtype 校验后，只把被选中分支（branch_id）的逐叶原语交给本 kernel；
// kernel 在 NPU 上对每个输出叶子做一次真实向量计算，并把 branch_id 写进设备侧
// token / counters，供 host 读回作为“运行期只执行选中分支”的原始证据。
//
// 计算分工（编码规则 A1：包装层不得代算）：
//   * 每个输出叶子按 [src 输入叶子, 原语, 元素步长] 描述；
//   * 连续叶子按 COND_TILE_ELEMS 分块，多核 grid-stride 并行；
//   * 跨步叶子（如 x[:,0]）由 0 号核用 strided DataCopyPad 整段搬入 UB 后计算；
//   * 只有 0 号核写 token/counters（每核只写自己的输出，不需要跨核同步）。
//
// 原语表见 jax_lax_cond_tiling.h 的 COND_OP_*；branch 选择只影响写回证据。
// ============================================================================

#include "kernel_operator.h"
#include "jax_lax_cond_tiling.h"

class KernelCond {
public:
    __aicore__ inline KernelCond(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR in0, GM_ADDR in1, GM_ADDR in2, GM_ADDR in3,
                                GM_ADDR in4, GM_ADDR in5, GM_ADDR in6, GM_ADDR in7,
                                GM_ADDR out0, GM_ADDR out1, GM_ADDR out2, GM_ADDR out3,
                                GM_ADDR out4, GM_ADDR out5, GM_ADDR out6, GM_ADDR out7,
                                GM_ADDR token, GM_ADDR counters, GM_ADDR tilingData)
    {
        tiling = (__gm__ CondTilingData *)tilingData;
        GM_ADDR ins[COND_MAX_LEAVES] = {in0, in1, in2, in3, in4, in5, in6, in7};
        GM_ADDR outs[COND_MAX_LEAVES] = {out0, out1, out2, out3, out4, out5, out6, out7};
        for (int32_t i = 0; i < COND_MAX_LEAVES; ++i) {
            if (i < tiling->nInputs && ins[i] != nullptr) {
                inGm[i].SetGlobalBuffer((__gm__ float *)ins[i], tiling->inNumel[i]);
            }
            if (i < tiling->nOutputs && outs[i] != nullptr) {
                outGm[i].SetGlobalBuffer((__gm__ float *)outs[i], tiling->outNumel[i]);
            }
        }
        tokenGm.SetGlobalBuffer((__gm__ int32_t *)token, 1);
        counterGm.SetGlobalBuffer((__gm__ int32_t *)counters, 2);

        // 32KB + 32KB = 64KB UB，远小于 192KB；证据缓冲 32B。
        pipe_->InitBuffer(inQ, 1, COND_TILE_ELEMS * sizeof(float));
        pipe_->InitBuffer(outQ, 1, COND_TILE_ELEMS * sizeof(float));
        pipe_->InitBuffer(eviQ, 1, COND_MAX_LEAVES * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t blockNum = AscendC::GetBlockNum();
        if (blockNum < 1) {
            blockNum = 1;
        }
        for (int32_t j = 0; j < tiling->nOutputs; ++j) {
            const int64_t numel = tiling->outNumel[j];
            int64_t stride = tiling->outStride[j];
            if (stride <= 0) {
                stride = 1;
            }
            if (stride == 1) {
                const int64_t tiles = (numel + COND_TILE_ELEMS - 1) / COND_TILE_ELEMS;
                for (int64_t t = static_cast<int64_t>(blockIdx); t < tiles;
                     t += static_cast<int64_t>(blockNum)) {
                    const int64_t offset = t * COND_TILE_ELEMS;
                    const int64_t remain = numel - offset;
                    const uint32_t count = static_cast<uint32_t>(
                        (remain < COND_TILE_ELEMS) ? remain : COND_TILE_ELEMS);
                    CopyInContig(j, offset, count);
                    Compute(j, count);
                    CopyOut(j, offset, count);
                }
            } else if (blockIdx == 0) {
                // 跨步叶子（x[:,0] ± 1）：单核把整个源叶子搬进 UB，再用 LocalTensor 标量
                // 读/写抽取。仅用于 c06 的 aux（7 个元素），host 侧已限制源叶子 <= 一个 tile；
                // 不使用 GlobalTensor::GetValue（黑名单）。
                const uint32_t count = static_cast<uint32_t>(numel);
                CopyInStrided(j);
                ComputeStrided(j, count, stride);
                CopyOut(j, 0, count);
            }
        }
        if (blockIdx == 0) {
            WriteEvidence();
        }
    }

private:
    __aicore__ inline void CopyInContig(int32_t j, int64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> x = inQ.AllocTensor<float>();
        AscendC::DataCopyPad(x, inGm[tiling->outSrc[j]][offset],
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        inQ.EnQue(x);
    }

    __aicore__ inline void CopyInStrided(int32_t j)
    {
        const int32_t src = tiling->outSrc[j];
        AscendC::LocalTensor<float> x = inQ.AllocTensor<float>();
        // 整块（源叶子的全部元素）连续搬入；blockCount=1 保证 UB 内是连续布局。
        AscendC::DataCopyPad(x, inGm[src],
            {1, static_cast<uint16_t>(tiling->inNumel[src] * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        inQ.EnQue(x);
    }

    __aicore__ inline float ApplyScalar(int32_t op, float value)
    {
        switch (op) {
            case COND_OP_ADD1: return value + 1.0f;
            case COND_OP_SUB1: return value - 1.0f;
            case COND_OP_MUL2: return value * 2.0f;
            case COND_OP_HALF: return value * 0.5f;
            case COND_OP_AFFINE_TRUE: return value * 1.125f + 0.5f;
            case COND_OP_AFFINE_FALSE: return value * 0.875f - 0.5f;
            default: return value;
        }
    }

    __aicore__ inline void ComputeStrided(int32_t j, uint32_t count, int64_t stride)
    {
        AscendC::LocalTensor<float> x = inQ.DeQue<float>();
        AscendC::LocalTensor<float> y = outQ.AllocTensor<float>();
        // 标量读 UB 前必须跨 pipe 同步（MTE2 -> S）；标量写 UB 后再同步给 MTE3。
        AscendC::PipeBarrier<PIPE_ALL>();
        const int32_t op = tiling->outOp[j];
        for (uint32_t i = 0; i < count; ++i) {
            const float value = x.GetValue(static_cast<int32_t>(i * stride));
            y.SetValue(static_cast<int32_t>(i), ApplyScalar(op, value));
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        outQ.EnQue(y);
        inQ.FreeTensor(x);
    }

    __aicore__ inline void Compute(int32_t j, uint32_t count)
    {
        AscendC::LocalTensor<float> x = inQ.DeQue<float>();
        AscendC::LocalTensor<float> y = outQ.AllocTensor<float>();
        switch (tiling->outOp[j]) {
            case COND_OP_ADD1:
                AscendC::Adds(y, x, 1.0f, count);
                break;
            case COND_OP_SUB1:
                AscendC::Adds(y, x, -1.0f, count);
                break;
            case COND_OP_MUL2:
                AscendC::Muls(y, x, 2.0f, count);
                break;
            case COND_OP_HALF:
                // x/2 在二进制浮点下等于 x*0.5（无额外舍入），与 CPU golden 逐位一致。
                AscendC::Muls(y, x, 0.5f, count);
                break;
            case COND_OP_AFFINE_TRUE:
                AscendC::Muls(y, x, 1.125f, count);
                AscendC::Adds(y, y, 0.5f, count);
                break;
            case COND_OP_AFFINE_FALSE:
                AscendC::Muls(y, x, 0.875f, count);
                AscendC::Adds(y, y, -0.5f, count);
                break;
            default:
                // host 侧已拒绝未知 outOp；这里保持 UB 输出已分配，写回时不越界。
                AscendC::Adds(y, x, 0.0f, count);
                break;
        }
        outQ.EnQue(y);
        inQ.FreeTensor(x);
    }

    __aicore__ inline void CopyOut(int32_t j, int64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> y = outQ.DeQue<float>();
        AscendC::DataCopyPad(outGm[j][offset], y,
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
        outQ.FreeTensor(y);
    }

    // 设备侧证据：token 由 kernel 按实际 branch_id 写；counters 只有被选中一支为 1。
    // 这两块内存随后由 host 用 aclrtMemcpy(D2H) 读回，Python 不自报。
    __aicore__ inline void WriteEvidence()
    {
        const int32_t branch = tiling->branchId;
        const int32_t hitsTrue = (branch == 1) ? 1 : 0;
        const int32_t hitsFalse = (branch == 2) ? 1 : 0;

        AscendC::LocalTensor<int32_t> tok = eviQ.AllocTensor<int32_t>();
        AscendC::Duplicate(tok, branch, COND_MAX_LEAVES);
        eviQ.EnQue(tok);
        tok = eviQ.DeQue<int32_t>();
        AscendC::DataCopyPad(tokenGm, tok, {1, static_cast<uint16_t>(sizeof(int32_t)), 0, 0});
        eviQ.FreeTensor(tok);

        AscendC::LocalTensor<int32_t> ct = eviQ.AllocTensor<int32_t>();
        AscendC::Duplicate(ct, hitsTrue, COND_MAX_LEAVES);
        eviQ.EnQue(ct);
        ct = eviQ.DeQue<int32_t>();
        AscendC::DataCopyPad(counterGm[0], ct, {1, static_cast<uint16_t>(sizeof(int32_t)), 0, 0});
        eviQ.FreeTensor(ct);

        AscendC::LocalTensor<int32_t> cf = eviQ.AllocTensor<int32_t>();
        AscendC::Duplicate(cf, hitsFalse, COND_MAX_LEAVES);
        eviQ.EnQue(cf);
        cf = eviQ.DeQue<int32_t>();
        AscendC::DataCopyPad(counterGm[1], cf, {1, static_cast<uint16_t>(sizeof(int32_t)), 0, 0});
        eviQ.FreeTensor(cf);
    }

    AscendC::TPipe *pipe_;
    const __gm__ CondTilingData *tiling;

    AscendC::GlobalTensor<float> inGm[COND_MAX_LEAVES];
    AscendC::GlobalTensor<float> outGm[COND_MAX_LEAVES];
    AscendC::GlobalTensor<int32_t> tokenGm;
    AscendC::GlobalTensor<int32_t> counterGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> eviQ;
};

// 核函数入口（可执行文件自检与共享库共用；blockNum 由 .so 按输出 tile 数与设备核数决定）
extern "C" __global__ __vector__ void jax_lax_cond_kernel(
    GM_ADDR in0, GM_ADDR in1, GM_ADDR in2, GM_ADDR in3,
    GM_ADDR in4, GM_ADDR in5, GM_ADDR in6, GM_ADDR in7,
    GM_ADDR out0, GM_ADDR out1, GM_ADDR out2, GM_ADDR out3,
    GM_ADDR out4, GM_ADDR out5, GM_ADDR out6, GM_ADDR out7,
    GM_ADDR token, GM_ADDR counters, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelCond op(&pipe);
    op.Init(in0, in1, in2, in3, in4, in5, in6, in7,
            out0, out1, out2, out3, out4, out5, out6, out7,
            token, counters, tiling);
    op.Process();
}
