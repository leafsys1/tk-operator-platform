// ============================================================================
// Ascend C Kernel 实现 - jax_lax_associative_scan（纯 kernel，不含 host 代码）
// ============================================================================
// 语义：JAX lax.associative_scan。elems 按静态 axis 展成 [outer, length, inner]，
//       对每条 (outer, inner) 链按结合律二元函数做前缀（reverse=false）或后缀
//       （reverse=true）扫描，结果写回与输入同 shape 的输出缓冲。
//
// 计算分工（编码规则 A1：包装层不得代算）：
//   * 单核（blockNum=1）在 UB 里持有长度为 chunk 的 carry 向量；
//   * 按 outer → inner-chunk → 扫描步 t 的顺序，从 GM 取一行（chunk 个元素），
//     用 AscendC 向量原语与 carry 结合，再把结果按**原始索引**写回；
//   * whole_tree（jit）一次 launch 覆盖 nLeaves 个叶子；per_leaf（eager）每次 launch
//     只带 1 个叶子。叶子间几何独立，串行处理；
//   * inner 很大时按 ASSOC_MAX_INNER_CHUNK 切块：不同 inner 下标是独立链，
//     chunk 之间不需要跨块 carry。
//
// combine 分派见 op_kernel/jax_lax_associative_scan_tiling.h 的 ASSOC_COMBINE_* 常量。
// ============================================================================

#include "kernel_operator.h"
#include "jax_lax_associative_scan_tiling.h"

class KernelAssocScan {
public:
    __aicore__ inline explicit KernelAssocScan(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR in0, GM_ADDR in1, GM_ADDR in2, GM_ADDR in3,
                                GM_ADDR in4, GM_ADDR in5, GM_ADDR in6, GM_ADDR in7,
                                GM_ADDR out0, GM_ADDR out1, GM_ADDR out2, GM_ADDR out3,
                                GM_ADDR out4, GM_ADDR out5, GM_ADDR out6, GM_ADDR out7,
                                const __gm__ AssocTilingData *tilingData)
    {
        tiling = tilingData;
        inAddr[0] = in0;
        inAddr[1] = in1;
        inAddr[2] = in2;
        inAddr[3] = in3;
        inAddr[4] = in4;
        inAddr[5] = in5;
        inAddr[6] = in6;
        inAddr[7] = in7;
        outAddr[0] = out0;
        outAddr[1] = out1;
        outAddr[2] = out2;
        outAddr[3] = out3;
        outAddr[4] = out4;
        outAddr[5] = out5;
        outAddr[6] = out6;
        outAddr[7] = out7;

        // [CONFIG] maxInner 由 host 取本次 launch 所有叶子的最大值；超过单次向量迭代
        // 上限时按 ASSOC_MAX_INNER_CHUNK 切块，UB 只按该上限分配。
        int64_t alloc = tiling->maxInner;
        if (alloc > ASSOC_MAX_INNER_CHUNK) {
            alloc = ASSOC_MAX_INNER_CHUNK;
        }
        if (alloc < 1) {
            alloc = 1;
        }
        chunkCap = alloc;
        int64_t aligned = ((alloc + ASSOC_UB_ALIGN_ELEMS - 1) / ASSOC_UB_ALIGN_ELEMS) * ASSOC_UB_ALIGN_ELEMS;
        uint32_t alignedBytes = static_cast<uint32_t>(aligned * sizeof(float));

        pipe_->InitBuffer(carryBuf, alignedBytes);
        pipe_->InitBuffer(inQ, 1, alignedBytes);
        pipe_->InitBuffer(outQ, 1, alignedBytes);
    }

    __aicore__ inline void Process()
    {
        for (int32_t leaf = 0; leaf < tiling->nLeaves; ++leaf) {
            const int64_t outer = tiling->outer[leaf];
            const int64_t length = tiling->length[leaf];
            const int64_t inner = tiling->inner[leaf];
            AscendC::GlobalTensor<float> inGm;
            AscendC::GlobalTensor<float> outGm;
            inGm.SetGlobalBuffer((__gm__ float *)inAddr[leaf], outer * length * inner);
            outGm.SetGlobalBuffer((__gm__ float *)outAddr[leaf], outer * length * inner);

            for (int64_t chunkStart = 0; chunkStart < inner; chunkStart += chunkCap) {
                const int64_t chunk = (inner - chunkStart < chunkCap) ? (inner - chunkStart) : chunkCap;
                for (int64_t o = 0; o < outer; ++o) {
                    const int64_t base = o * length * inner + chunkStart;
                    ScanChain(inGm, outGm, base, length, inner, chunk);
                }
            }
        }
    }

private:
    // 对一条 [length] 链（宽度 chunk）做前缀/后缀扫描并写回。
    __aicore__ inline void ScanChain(AscendC::GlobalTensor<float> &inGm,
                                     AscendC::GlobalTensor<float> &outGm,
                                     int64_t base, int64_t length, int64_t inner, int64_t chunk)
    {
        const uint32_t count = static_cast<uint32_t>(chunk);
        AscendC::LocalTensor<float> carry = carryBuf.Get<float>();

        for (int64_t t = 0; t < length; ++t) {
            // reverse：逻辑步 t 消费原始索引 length-1-t；结果仍按原始索引写回
            // （JAX 语义：先反转 elems，扫描后再把结果反转回来）。
            const int64_t idx = (tiling->reverse != 0) ? (length - 1 - t) : t;
            const int64_t offset = base + idx * inner;

            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(chunk * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0.0f};

            AscendC::LocalTensor<float> x = inQ.AllocTensor<float>();
            AscendC::DataCopyPad(x, inGm[offset], copyParams, padParams);
            inQ.EnQue(x);
            x = inQ.DeQue<float>();

            AscendC::LocalTensor<float> y = outQ.AllocTensor<float>();
            if (t == 0) {
                // 首步：carry = x，输出也是 x（不依赖 combine 的单位元）。
                AscendC::Adds(y, x, 0.0f, count);
            } else if (tiling->combineId == ASSOC_COMBINE_SUM ||
                       tiling->combineId == ASSOC_COMBINE_TREE_ADD) {
                AscendC::Add(y, carry, x, count);
            } else {
                AscendC::Max(y, carry, x, count);
            }
            // carry 跨步保存在 UB 内；y 同时作为本次输出。
            AscendC::Adds(carry, y, 0.0f, count);
            outQ.EnQue<float>(y);
            y = outQ.DeQue<float>();
            AscendC::DataCopyPad(outGm[offset], y, copyParams);
            outQ.FreeTensor(y);
            inQ.FreeTensor(x);
        }
    }

    AscendC::TPipe *pipe_;
    const __gm__ AssocTilingData *tiling;
    GM_ADDR inAddr[ASSOC_MAX_LEAVES];
    GM_ADDR outAddr[ASSOC_MAX_LEAVES];

    AscendC::TBuf<AscendC::TPosition::VECCALC> carryBuf;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;

    int64_t chunkCap;
};

// 核函数入口（可执行文件与共享库共用；blockNum 恒为 1：carry 跨扫描步保持在 UB 内）。
extern "C" __global__ __vector__ void jax_lax_associative_scan_kernel(
    GM_ADDR in0, GM_ADDR in1, GM_ADDR in2, GM_ADDR in3,
    GM_ADDR in4, GM_ADDR in5, GM_ADDR in6, GM_ADDR in7,
    GM_ADDR out0, GM_ADDR out1, GM_ADDR out2, GM_ADDR out3,
    GM_ADDR out4, GM_ADDR out5, GM_ADDR out6, GM_ADDR out7,
    GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelAssocScan op(&pipe);
    op.Init(in0, in1, in2, in3, in4, in5, in6, in7,
            out0, out1, out2, out3, out4, out5, out6, out7,
            (__gm__ AssocTilingData *)tiling);
    op.Process();
}
