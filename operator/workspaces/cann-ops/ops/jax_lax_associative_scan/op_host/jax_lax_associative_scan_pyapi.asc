// ============================================================================
// jax_lax_associative_scan · Python 调用接口的 C ABI 实现
//                              （libjax_lax_associative_scan_host.so）
// ============================================================================
// 供 ops/jax_lax_associative_scan/python/jax_lax_associative_scan.py 用 ctypes 加载。
//
// 分工（编码规则 A1）：本层只做参数校验 + Tiling + kernel launch，**不做任何数值计算**；
// 全部扫描语义在 op_kernel/jax_lax_associative_scan_kernel.asc 里用 AscendC 向量原语实现。
//
// 一次 jax_lax_associative_scan_run 对应一次 launch：
//   * eager（per_leaf）：Python 层每叶子调用一次，n_leaves == 1；
//   * jit（whole_tree）：Python 层整树调用一次，n_leaves == 叶子数，一次 launch 覆盖全部叶子。
//
// 返回码：0 成功 / 1 运行失败 / 2 参数错误。3（拒绝）与 4（显式 unsupported）在 Python
// 预校验 / trace 路径产生，不在本层伪造。
//
// 约束：不 aclFinalize —— Python 进程可能的其它 ACL 使用者（PJRT 等）由调用方管理生命周期；
// 本库只做一次 aclInit（明确失败才报错）+ aclrtSetDevice + 建流 + 同步。
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <cstring>

#include "acl/acl.h"

#include "../op_kernel/jax_lax_associative_scan_tiling.h"
// 与可执行文件共用同一份 device 侧实现（kernel 代码在共享库里同样打进去）
#include "../op_kernel/jax_lax_associative_scan_kernel.asc"
#include "jax_lax_associative_scan_abi.h"

namespace {

const char *CodeName(int rc)
{
    switch (rc) {
        case ASSOC_RC_BAD_ARGS: return "invalid_argument";
        case ASSOC_RC_REJECT: return "rejected";
        case ASSOC_RC_UNSUPPORTED: return "autodiff_unsupported";
        case ASSOC_RC_RUN_FAILED: return "device_error";
        default: return "error";
    }
}

// err 由调用方提供；args 是 const，但 err 指向的缓冲区是调用方的可写内存。
void WriteErr(const jax_lax_associative_scan_args_t *args, int rc, const char *detail)
{
    if (args == nullptr || args->err == nullptr || args->err_len <= 0) {
        return;
    }
    char *buf = const_cast<char *>(args->err);
    (void)snprintf(buf, static_cast<size_t>(args->err_len), "%s: %s", CodeName(rc),
                   (detail == nullptr) ? "" : detail);
}

int Validate(const jax_lax_associative_scan_args_t *args, char *detail, size_t detailLen)
{
    if (args->abi_version != JAX_LAX_ASSOC_SCAN_ABI_VERSION) {
        (void)snprintf(detail, detailLen, "abi_version=%d（期望 %d）", args->abi_version,
                       JAX_LAX_ASSOC_SCAN_ABI_VERSION);
        return ASSOC_RC_BAD_ARGS;
    }
    const int32_t combine = args->combine_id;
    if (combine != ASSOC_COMBINE_SUM && combine != ASSOC_COMBINE_MAX &&
        combine != ASSOC_COMBINE_TREE_ADD) {
        (void)snprintf(detail, detailLen, "combine_id=%d 不是已注册的 combine", combine);
        return ASSOC_RC_BAD_ARGS;
    }
    if (args->reverse != 0 && args->reverse != 1) {
        (void)snprintf(detail, detailLen, "reverse=%d 只能是 0/1", args->reverse);
        return ASSOC_RC_BAD_ARGS;
    }
    if (args->n_leaves < 1 || args->n_leaves > ASSOC_MAX_LEAVES) {
        (void)snprintf(detail, detailLen, "n_leaves=%d 超出 [1, %d]", args->n_leaves,
                       ASSOC_MAX_LEAVES);
        return ASSOC_RC_BAD_ARGS;
    }
    if (args->device_id < 0) {
        (void)snprintf(detail, detailLen, "device_id=%d 非法", args->device_id);
        return ASSOC_RC_BAD_ARGS;
    }
    for (int32_t i = 0; i < args->n_leaves; ++i) {
        if (args->dtype[i] != 0) {
            (void)snprintf(detail, detailLen, "叶 %d dtype=%d 不是 float32", i, args->dtype[i]);
            return ASSOC_RC_BAD_ARGS;
        }
        const int64_t outer = args->outer[i];
        const int64_t length = args->length[i];
        const int64_t inner = args->inner[i];
        if (outer < 1 || length < 1 || inner < 1) {
            (void)snprintf(detail, detailLen, "叶 %d 几何非法：outer=%lld length=%lld inner=%lld",
                           i, static_cast<long long>(outer), static_cast<long long>(length),
                           static_cast<long long>(inner));
            return ASSOC_RC_BAD_ARGS;
        }
        const int64_t expected = outer * length * inner;
        if (args->numel[i] != expected) {
            (void)snprintf(detail, detailLen, "叶 %d numel=%lld != outer*length*inner=%lld", i,
                           static_cast<long long>(args->numel[i]),
                           static_cast<long long>(expected));
            return ASSOC_RC_BAD_ARGS;
        }
        if (args->in[i] == nullptr || args->out[i] == nullptr) {
            (void)snprintf(detail, detailLen, "叶 %d 的输入/输出设备地址为空", i);
            return ASSOC_RC_BAD_ARGS;
        }
    }
    return ASSOC_RC_OK;
}

int Launch(const jax_lax_associative_scan_args_t *args, char *detail, size_t detailLen)
{
    AssocTilingData tiling{};
    tiling.combineId = args->combine_id;
    tiling.reverse = args->reverse;
    tiling.nLeaves = args->n_leaves;
    tiling.reserved = 0;
    tiling.maxInner = 1;
    for (int32_t i = 0; i < args->n_leaves; ++i) {
        tiling.outer[i] = args->outer[i];
        tiling.length[i] = args->length[i];
        tiling.inner[i] = args->inner[i];
        if (args->inner[i] > tiling.maxInner) {
            tiling.maxInner = args->inner[i];
        }
    }

    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtCreateStream 失败");
        return ASSOC_RC_RUN_FAILED;
    }
    void *tilingDevice = nullptr;
    int rc = ASSOC_RC_RUN_FAILED;
    if (aclrtMalloc(&tilingDevice, sizeof(AssocTilingData), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtMalloc(tiling) 失败");
    } else if (aclrtMemcpy(tilingDevice, sizeof(AssocTilingData), &tiling, sizeof(AssocTilingData),
                           ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        (void)snprintf(detail, detailLen, "aclrtMemcpy(tiling) 失败");
    } else {
        jax_lax_associative_scan_kernel<<<1, nullptr, stream>>>(
            reinterpret_cast<uint8_t *>(args->in[0]),
            reinterpret_cast<uint8_t *>(args->in[1]),
            reinterpret_cast<uint8_t *>(args->in[2]),
            reinterpret_cast<uint8_t *>(args->in[3]),
            reinterpret_cast<uint8_t *>(args->in[4]),
            reinterpret_cast<uint8_t *>(args->in[5]),
            reinterpret_cast<uint8_t *>(args->in[6]),
            reinterpret_cast<uint8_t *>(args->in[7]),
            reinterpret_cast<uint8_t *>(args->out[0]),
            reinterpret_cast<uint8_t *>(args->out[1]),
            reinterpret_cast<uint8_t *>(args->out[2]),
            reinterpret_cast<uint8_t *>(args->out[3]),
            reinterpret_cast<uint8_t *>(args->out[4]),
            reinterpret_cast<uint8_t *>(args->out[5]),
            reinterpret_cast<uint8_t *>(args->out[6]),
            reinterpret_cast<uint8_t *>(args->out[7]),
            reinterpret_cast<uint8_t *>(tilingDevice));
        if (aclrtSynchronizeStream(stream) == ACL_SUCCESS) {
            rc = ASSOC_RC_OK;
        } else {
            (void)snprintf(detail, detailLen, "kernel 执行失败（aclrtSynchronizeStream 非 0）");
        }
    }
    if (tilingDevice != nullptr) {
        (void)aclrtFree(tilingDevice);
    }
    (void)aclrtDestroyStream(stream);
    return rc;
}

bool g_aclInited = false;

}  // namespace

extern "C" {

int jax_lax_associative_scan_run(const jax_lax_associative_scan_args_t *args)
{
    if (args == nullptr) {
        return ASSOC_RC_BAD_ARGS;
    }
    char detail[256] = {0};
    int rc = Validate(args, detail, sizeof(detail));
    if (rc != ASSOC_RC_OK) {
        WriteErr(args, rc, detail);
        return rc;
    }
    if (!g_aclInited) {
        aclError initRet = aclInit(nullptr);
        // 已经初始化（例如 PJRT 先初始化过）也视为可用：用 aclrtGetDeviceCount
        // 探测运行时上下文是否真的可用，避免依赖特定版本的重复初始化错误码。
        if (initRet != ACL_SUCCESS) {
            uint32_t deviceCount = 0;
            if (aclrtGetDeviceCount(&deviceCount) != ACL_SUCCESS || deviceCount <= 0) {
                WriteErr(args, ASSOC_RC_RUN_FAILED, "aclInit 失败且 ACL 上下文不可用");
                return ASSOC_RC_RUN_FAILED;
            }
        }
        g_aclInited = true;
    }
    if (aclrtSetDevice(args->device_id) != ACL_SUCCESS) {
        WriteErr(args, ASSOC_RC_RUN_FAILED, "aclrtSetDevice 失败");
        return ASSOC_RC_RUN_FAILED;
    }
    rc = Launch(args, detail, sizeof(detail));
    if (rc != ASSOC_RC_OK) {
        WriteErr(args, rc, detail);
    }
    return rc;
}

const char *jax_lax_associative_scan_abi_version(void)
{
    return "opx-assoc-scan-host-abi/1";
}

int jax_lax_associative_scan_acl_init(void)
{
    if (g_aclInited) {
        return ASSOC_RC_OK;
    }
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        uint32_t deviceCount = 0;
        if (aclrtGetDeviceCount(&deviceCount) != ACL_SUCCESS || deviceCount <= 0) {
            return ASSOC_RC_RUN_FAILED;
        }
    }
    // 显式绑定 device 0：CLI 的第一次设备操作是 malloc（aclrtMalloc），
    // 它发生在 run 的 aclrtSetDevice 之前；未绑定时首个 malloc 可能失败。
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        return ASSOC_RC_RUN_FAILED;
    }
    g_aclInited = true;
    return ASSOC_RC_OK;
}

int jax_lax_associative_scan_malloc(void **devPtr, int64_t bytes)
{
    if (devPtr == nullptr || bytes <= 0) {
        return ASSOC_RC_BAD_ARGS;
    }
    if (aclrtMalloc(devPtr, static_cast<size_t>(bytes), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return ASSOC_RC_RUN_FAILED;
    }
    return ASSOC_RC_OK;
}

int jax_lax_associative_scan_free(void *devPtr)
{
    if (devPtr == nullptr) {
        return ASSOC_RC_OK;
    }
    return (aclrtFree(devPtr) == ACL_SUCCESS) ? ASSOC_RC_OK : ASSOC_RC_RUN_FAILED;
}

int jax_lax_associative_scan_h2d(void *devPtr, const void *hostPtr, int64_t bytes)
{
    if (devPtr == nullptr || hostPtr == nullptr || bytes <= 0) {
        return ASSOC_RC_BAD_ARGS;
    }
    return (aclrtMemcpy(devPtr, static_cast<size_t>(bytes), hostPtr, static_cast<size_t>(bytes),
                        ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS)
               ? ASSOC_RC_OK
               : ASSOC_RC_RUN_FAILED;
}

int jax_lax_associative_scan_d2h(void *hostPtr, const void *devPtr, int64_t bytes)
{
    if (hostPtr == nullptr || devPtr == nullptr || bytes <= 0) {
        return ASSOC_RC_BAD_ARGS;
    }
    return (aclrtMemcpy(hostPtr, static_cast<size_t>(bytes), devPtr, static_cast<size_t>(bytes),
                        ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS)
               ? ASSOC_RC_OK
               : ASSOC_RC_RUN_FAILED;
}

}  // extern "C"
