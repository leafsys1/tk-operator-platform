      "cond": "jnp.all(v > 0.125)",
      "body": "v * 0.5",
      "dtype": "float32",
      "seed": 20261029,
      "mode": ["eager", "jit"],
      "expected": "match_cpu",
      "note": "裸张量 carry；数据相关 cond；精确二进制值，2 次迭代"
