# =============================================================================
# 部署唯一需要修改的文件 —— 复制成 site.env 后按下面注释改 5 个值即可
#
#   cp deploy/site.env.example deploy/site.env
#   vi deploy/site.env
#
# site.env 不进版本库（.gitignore 已排除），因为每台机器的路径/账号不同。
# 本文件里凡是标「现场真值」的，都是 172.16.111.102 那台机器的实际值，
# **换机器时不能照抄**，必须改成新机器的实际值。
# =============================================================================

# ---- 1. 落地在哪台机器（本仓库脚本全部在这台机器上以 RUN_USER 身份执行）----
# 现场真值：公司通算机 ubuntu-zg，私网 172.16.111.102
TARGET_HOST=172.16.111.102
RUN_USER=hzzg
# 目标机 sudo 是否需要密码（1=需要，脚本会用 sudo -S 从 SUDO_PASS 读）
SUDO_NEEDS_PASS=1
# 只在需要无人值守安装 unit 时填；平时留空，脚本会交互提示
SUDO_PASS=

# ---- 2. 三个组件的安装根目录（换机器时改这三行）----
# 算子开发平台：代码 + 数据库 + runs + 密钥目录都在这下面
OPERATOR_ROOT=/data/lfx/op-agent-console-20261101
# 模型迁移工作台：代码与语料索引在本机，权重在算力机
MODEL_ROOT=/home/hzzg/workspace/model-corpus
# 统一外壳（网关）
SHELL_ROOT=/data/lfx/op-agent-console-20261101/preview-gateway

# ---- 3. 端口（三个都要空闲；改端口要同步改 systemd 单元与 site.env）----
OPERATOR_PORT=18078
MODEL_PORT=8090
GATEWAY_PORT=18080

# ---- 4. 算力服务器（昇腾 910B 那台，只做算力，不跑 Web）----
# 现场真值：bms-fae，公网 61.241.77.3:31236
COMPUTE_SSH=root@61.241.77.3
COMPUTE_PORT=31236
# 登录算力机的私钥（放本机，0600）。脚本会把它拷进 OPERATOR_ROOT/keys/
COMPUTE_KEY=/home/hzzg/.ssh/KeyPair-fae2027.pem
# 算力机上两个数据根（**路径必须两机一致**：容器内挂载用的是同一路径）
COMPUTE_MODEL_ROOT=/data/model_corpus
COMPUTE_OPAGENT_ROOT=/data/lfx/op-agent

# ---- 5. 大模型端点（只有算子平台的 agent 用得到；模型平台不用 LLM）----
# 现场真值：天宽自建网关
LLM_BASE_URL=https://tokens.tiankuan.com/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_CONTEXT_WINDOW=131072
# API Key 不要写在这里！部署时由脚本交互读入并写入
#   $OPERATOR_ROOT/secrets/values/server-active-endpoint.key  （0600）
# 或事后在网页「API 管理」页填写。

# ---- 6. 访问来源白名单（网关唯一的安全边界，务必收紧）----
ALLOWED_CIDRS=127.0.0.0/8,172.16.111.0/24
# 反代/域名上线后把域名写进来，例：portal.example.com,172.16.111.102
ALLOWED_HOSTS=*
