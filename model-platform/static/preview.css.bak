@charset "UTF-8";
:root{--green:#176348;--green-dark:#124e39;--green-soft:#edf5ef;--ink:#202a26;--muted:#7b857f;--line:#e6eae6;--canvas:#f6f8f6;--white:#fff;--amber:#a57120;--radius:16px;--sidebar:230px;--sans:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;--mono:"SFMono-Regular",Consolas,"Liberation Mono",monospace}
*{box-sizing:border-box}body{margin:0;background:var(--canvas);color:var(--ink);font:14px/1.6 var(--sans);-webkit-font-smoothing:antialiased}button,input,select{font:inherit}button,a,input,select{ -webkit-tap-highlight-color:transparent}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.5}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #69ab8c;outline-offset:3px}button{color:inherit}h1,h2,h3,p{margin:0}svg{width:20px;height:20px;flex-shrink:0;vertical-align:middle}button svg,a svg{pointer-events:none}.muted{color:var(--muted)}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip-link{position:fixed;left:20px;top:-70px;z-index:100;background:var(--green);color:#fff;padding:12px 20px;border-radius:8px}.skip-link:focus{top:12px}
.sidebar{width:var(--sidebar);position:fixed;inset:0 auto 0 0;background:#fff;border-right:1px solid var(--line);padding:29px 19px 16px;display:flex;flex-direction:column;z-index:30}.brand{display:flex;align-items:center;gap:11px;padding:0 7px;font-size:18px;font-weight:750;letter-spacing:-.6px;line-height:1.3}.brand small{display:block;font-size:10px;letter-spacing:1.8px;font-weight:400;color:#8b948e;margin-top:7px}.brand-symbol{width:36px;height:39px;border-radius:10px;color:var(--green);display:grid;place-items:center;background:var(--green-soft)}.brand-symbol svg{width:30px;height:30px}.workspace-picker{display:flex;gap:10px;align-items:center;margin:32px 0 28px;padding:11px 10px;border:1px solid var(--line);border-radius:10px;font-size:12px;font-weight:600}.workspace-initial{width:29px;height:29px;border:1px solid #dfe5de;background:#f4f6f2;border-radius:7px;display:grid;place-items:center;font:600 13px var(--mono);color:#747d6c}.workspace-picker small{display:block;color:#8c948f;font-size:10px;font-weight:400;margin-top:2px}.picker-mark{margin-left:auto;font-size:17px;color:#919a93}.nav-label{padding:0 11px;margin-bottom:10px;font-size:10px;letter-spacing:1px;color:#9aa29c;display:flex;justify-content:space-between}.nav-label a{font-size:13px}.main-nav,.category-nav{display:grid;gap:5px}.nav-item{border:0;background:none;border-radius:8px;width:100%;padding:11px 12px;display:flex;align-items:center;gap:11px;text-align:left;color:#707b73;font-size:12px;transition:background .15s,color .15s}.nav-item svg{width:17px;height:17px}.nav-item:hover{background:#f6f8f5;color:var(--green)}.nav-item.active{background:var(--green-soft);color:var(--green);font-weight:650}.nav-item .nav-count{font-size:10px;margin-left:auto;color:#9aa29b;font-variant-numeric:tabular-nums}.nav-item.active .nav-count{color:var(--green)}.nav-divider{height:1px;background:var(--line);margin:24px 11px}.category-nav .nav-item{padding-top:9px;padding-bottom:9px}.sidebar-bottom{margin-top:auto;padding-top:28px}.environment-mini{padding:13px 10px;display:flex;gap:9px;align-items:center;background:#f7f9f6;border:1px solid #ebeeea;border-radius:10px;font:600 11px var(--sans)}.environment-icon{color:#7d8e7b}.environment-mini small{display:block;color:#8b958e;font-size:10px;font-weight:400;margin-top:3px}.offline-dot{height:6px;width:6px;border-radius:50%;background:#b8c1b7;margin-left:auto}.sidebar-help{border:0;background:none;width:100%;display:flex;gap:10px;align-items:center;text-align:left;padding:20px 10px 14px;font-size:11px;color:#748078}.sidebar-help span:last-child{margin-left:auto}.sidebar-help svg{width:16px;height:16px}.sidebar-version{padding:12px 10px 0;border-top:1px solid var(--line);font:9px var(--mono);color:#a1aaa3;display:flex;justify-content:space-between}
.app-shell{margin-left:var(--sidebar);min-height:100vh;display:flex;flex-direction:column}.topbar{height:73px;border-bottom:1px solid var(--line);background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 36px;gap:10px}.breadcrumb{display:flex;align-items:center;gap:14px;color:#9aa29c;font-size:11px}.breadcrumb-slash{color:#c7cec8}.breadcrumb strong{font-weight:500;color:#5f6b63}.topbar-actions{display:flex;align-items:center;gap:18px}.mode-pill{padding:4px 10px;border:1px solid #e4e9e1;border-radius:5px;background:#fafbf8;font-size:10px;color:#7a876e}.mode-pill:before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:#97ab84;margin-right:6px;vertical-align:middle}.mode-pill.live{color:var(--green);background:var(--green-soft)}.icon-button{height:32px;min-width:32px;display:inline-grid;place-items:center;background:transparent;border:0;border-radius:6px;color:#758078;font-size:24px;line-height:1}.icon-button:hover{background:#eef3ed}.icon-button svg{width:18px;height:18px}.topbar-separator{height:20px;border-left:1px solid var(--line)}.avatar{display:grid;place-items:center;width:29px;height:29px;background:#edf1e9;color:#6a7c57;border:1px solid #e1e6db;border-radius:50%;font:600 11px var(--sans)}.mobile-menu{display:none}main{width:100%;max-width:1600px;margin:0 auto;padding:31px 36px 30px;flex:1;outline:none}.page-footer{padding:15px 36px 21px;font-size:10px;display:flex;justify-content:space-between;color:#a0aaa1;gap:10px}.page-footer>span:first-child{display:flex;gap:6px;align-items:center;font-size:10px;font-weight:600;color:#89968c}.footer-brand-dot{width:7px;height:7px;border:2px solid #8da58f;border-radius:2px}.eyebrow{font:9px var(--mono);letter-spacing:1.8px;color:#839688}.page-intro{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:25px;gap:16px}.page-intro h1{font-size:24px;font-weight:650;letter-spacing:-.8px;margin-bottom:5px;line-height:1.4}.page-intro p{font-size:11px;color:var(--muted)}.page-intro .intro-actions{display:flex;align-items:center;gap:9px;padding-top:5px}.button{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:8px;padding:9px 15px;font-size:11px;font-weight:500;white-space:nowrap;transition:background .15s,transform .15s;min-height:36px}.button svg{width:15px;height:15px}.button:hover:not(:disabled){transform:translateY(-1px)}.button-primary{background:var(--green);color:#fff;border-color:var(--green)}.button-primary:hover:not(:disabled){background:var(--green-dark)}.button-secondary{background:#fff;border-color:#dfe5dd;color:#5c6c5f}.button-soft{background:var(--green-soft);color:var(--green);border-color:transparent}.button-ghost{background:transparent;color:#7a897e;border-color:transparent}.button-small{padding:5px 10px;min-height:28px;font-size:10px;border-radius:6px}.text-button{padding:0;border:0;background:none;color:var(--green);font:500 11px var(--sans);display:inline-flex;align-items:center;gap:5px}.text-button svg{width:13px;height:13px}.text-button:hover{text-decoration:underline}.button-danger{background:#fff;border-color:#eedbd7;color:#a16152}
.migration-hero{position:relative;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:29px 31px 23px;overflow:hidden}.hero-top{display:flex;gap:25px;justify-content:space-between;position:relative;z-index:1}.hero-copy{padding-top:4px}.hero-copy h2{font-size:28px;line-height:1.55;font-weight:600;letter-spacing:-1.2px;margin:13px 0 9px}.hero-copy h2 em{font-style:normal;color:var(--green)}.hero-copy>p{font-size:11px;color:#8b938d}.hero-badge{display:inline-flex;align-items:center;gap:6px;background:#f0f5ec;color:#68845b;border:1px solid #e7ecdf;border-radius:5px;padding:3px 7px;font:8px var(--mono);letter-spacing:.7px;margin-left:8px}.migration-graphic{width:270px;height:140px;flex-shrink:0;position:relative;margin-top:-4px}.migration-graphic svg{width:100%;height:100%}.migration-hero:after{content:"";position:absolute;right:0;top:0;width:400px;height:200px;background:radial-gradient(ellipse at 75% 25%,#eef5e87a,transparent 70%);pointer-events:none}.migration-form{position:relative;margin-top:27px;z-index:2}.migration-input-wrap{display:flex;align-items:center;gap:10px;border:1px solid #dbe3d8;border-radius:9px;padding:7px;background:#fcfdfb;box-shadow:0 2px 4px #25321e03;transition:box-shadow .15s}.migration-input-wrap:focus-within{border-color:#8fac92;box-shadow:0 0 0 3px #dfeee360}.input-search-icon{margin-left:8px;color:#8b9b8c;display:flex}.input-search-icon svg{width:19px;height:19px}.migration-input-wrap input{background:transparent;min-width:0;flex:1;border:0;outline:none;font-size:12px;padding:8px 0;color:#344a3c}.migration-input-wrap input::placeholder{color:#a3ada3}.migration-input-wrap input:focus-visible{outline:none}.migration-input-wrap .button{min-height:39px;padding:9px 19px}.input-bottom{display:flex;justify-content:space-between;gap:12px;margin-top:11px;font-size:10px;color:#929b93;align-items:center}.examples{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.example-chip{border:0;background:#f4f6f1;padding:2px 7px;border-radius:4px;color:#798774;font:9px var(--mono);line-height:1.8}.example-chip:hover{background:#e9f0e5;color:var(--green)}.target-note{display:flex;align-items:center;gap:5px;white-space:nowrap;font:9px var(--mono);color:#8c9889}.target-note svg{height:12px;width:12px}.match-message{font-size:10px;color:#80907d;min-height:18px;margin-top:5px}.form-error{font-size:11px;min-height:18px;color:#ae5b4b}.suggestions{position:absolute;top:60px;left:0;width:calc(100% - 140px);background:white;box-shadow:0 12px 30px #213a2520;border:1px solid var(--line);border-radius:9px;max-height:280px;overflow:auto;z-index:12}.suggestion{width:100%;display:flex;justify-content:space-between;align-items:center;padding:11px 14px;text-align:left;background:white;border:0;border-bottom:1px solid #f0f3ee;gap:10px;font-size:11px}.suggestion:hover,.suggestion:focus{background:#f1f7ed}.suggestion small{color:#91a08e;font-size:9px}.suggestion span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.suggestion strong{font-weight:500}
.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin:19px 0 26px}.stat-card{padding:16px 18px;background:#fff;border:1px solid var(--line);border-radius:11px;display:flex;justify-content:space-between;gap:8px}.stat-label{font-size:10px;color:#7f8a80}.stat-number{font:500 25px/1.2 var(--sans);letter-spacing:-1px;margin:7px 0 4px}.stat-number small{font:10px var(--sans);letter-spacing:0;margin-left:7px;color:#a2aba0}.stat-description{font-size:9px;color:#9aa393}.stat-icon{height:30px;width:30px;display:grid;place-items:center;color:#8ea184;background:#f4f7f0;border:1px solid #edf1e6;border-radius:8px}.stat-icon svg{width:16px;height:16px}.workspace-grid{display:grid;grid-template-columns:minmax(0,1fr) 277px;gap:18px;margin-bottom:27px;align-items:stretch}.panel{background:#fff;border:1px solid var(--line);border-radius:var(--radius);min-width:0}.panel-header{padding:20px 22px 17px;display:flex;align-items:center;justify-content:space-between;gap:10px}.panel-title{display:flex;align-items:center;gap:8px}.panel-title h2{font-size:13px;font-weight:600;letter-spacing:-.2px}.panel-title svg{width:16px;height:16px;color:#7f937d}.mini-label{font-size:9px;color:#a1aa9d}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:14px}.section-head h2{font-size:15px;font-weight:600}.section-head p{font-size:10px;color:#97a18f;margin-top:2px}.guide-panel{padding:21px 21px 19px;background:#f0f5ed;border-color:#e1e8dc;position:relative;overflow:hidden}.guide-tag{font:8px var(--mono);color:#8b9b7d;letter-spacing:1.6px}.guide-panel h3{font-size:16px;font-weight:550;letter-spacing:-.4px;margin:13px 0 7px}.guide-panel>p{font-size:10px;color:#829077;line-height:1.9;max-width:215px}.guide-route{display:grid;gap:13px;margin:23px 0 21px}.route-item{display:flex;align-items:flex-start;gap:10px}.route-icon{height:27px;width:27px;flex-shrink:0;background:#fff8;border:1px solid #dce6d4;border-radius:7px;display:grid;place-items:center;color:#779167}.route-icon svg{height:14px;width:14px}.route-item strong{font-size:10px;display:block;font-weight:500;color:#526a46}.route-item p{font-size:9px;color:#97a18e;margin-top:2px}.guide-foot{border-top:1px solid #dce5d5;padding-top:14px;display:flex;gap:7px;align-items:flex-start;font-size:9px;color:#97a28c;line-height:1.8}.guide-foot svg{width:12px;height:12px;margin-top:2px}
.job-body{padding:0 22px 20px}.empty-job-top{display:flex;align-items:center;justify-content:space-between;padding:2px 0 17px;gap:14px}.empty-job-title{font-size:13px;font-weight:500}.empty-job-top p{font-size:10px;color:#99a292;margin-top:3px}.job-badge{display:inline-flex;gap:5px;align-items:center;font-size:9px;padding:3px 7px;background:#f5f7f1;border-radius:4px;color:#8d9884;white-space:nowrap}.job-badge.running{background:#edf5ed;color:#5e8753}.job-badge.succeeded{background:#eaf4ee;color:var(--green)}.job-badge.failed{background:#faeeea;color:#ae6953}.job-badge.cancelled{background:#f4f2ed;color:#968773}.job-badge.queued{background:#fcf7e9;color:var(--amber)}.job-badge .status-dot{width:4px;height:4px;background:currentColor;border-radius:50%}.process-preview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px 9px;padding:18px 0 4px;border-top:1px solid #f1f3ed}.preview-step{display:flex;align-items:center;gap:8px;font-size:10px;color:#a3ada0}.preview-step span{height:22px;width:22px;display:grid;place-items:center;border-radius:50%;border:1px solid #e2e8df;background:#fafbf8;font:9px var(--mono);color:#adb8a7;flex-shrink:0}.empty-progress{height:3px;background:#f0f3ec;border-radius:3px;margin-top:19px;position:relative}.empty-progress:before{content:"";width:9%;height:100%;background:#d7e3cf;position:absolute;left:0;top:0;border-radius:3px}.empty-job-foot{display:flex;align-items:center;justify-content:space-between;color:#a0aa99;font-size:9px;margin-top:12px}.job-model{font-size:17px;font-weight:550;letter-spacing:-.5px;overflow-wrap:anywhere}.job-meta{display:flex;gap:9px;align-items:center;flex-wrap:wrap;font-size:9px;color:#98a18f;margin:5px 0 15px}.mono{font-family:var(--mono)}.live-warning{font-size:10px;padding:9px 11px;border:1px solid #eee5d1;border-radius:7px;background:#fffbf0;color:#9a8050;margin-bottom:15px;line-height:1.8}.live-warning.error{border-color:#eeded8;background:#fff7f2;color:#a16e5a}.job-progress-head{display:flex;justify-content:space-between;gap:10px;font-size:10px;color:#8c9985;margin:10px 0 7px}.job-progress-head strong{color:var(--green);font-weight:500;font-family:var(--mono)}.progress-track{height:5px;border-radius:9px;background:#edf2e8;overflow:hidden}.progress-fill{height:100%;border-radius:9px;background:#5d9269;transition:width .6s}.progress-fill.failed{background:#b68a6b}.job-stages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px 9px;margin:20px 0 17px}.job-stage{display:flex;align-items:center;gap:7px;font-size:10px;color:#a4ada0}.stage-symbol{width:22px;height:22px;flex-shrink:0;border:1px solid #e6ece0;border-radius:50%;background:#fafcf7;color:#a1b09b;display:grid;place-items:center;font:9px var(--mono)}.stage-symbol svg{width:11px;height:11px}.job-stage.running{color:var(--green)}.job-stage.running .stage-symbol{background:#ecf5e9;color:#639455;border-color:#cbdcc4;box-shadow:0 0 0 3px #f5f9f0}.job-stage.succeeded{color:#6b8260}.job-stage.succeeded .stage-symbol{background:#eaf4e6;border-color:#dcead5;color:#6c965c}.job-stage.failed{color:#af6e58}.job-stage.failed .stage-symbol{border-color:#e9d8ce;background:#fff3eb;color:#af6e58}.log-console{background:#f7f9f4;border:1px solid #ebefe6;border-radius:8px;overflow:hidden;margin-top:16px}.log-heading{padding:8px 11px;display:flex;align-items:center;gap:7px;font-size:9px;color:#8c9a83;border-bottom:1px solid #e9eee3}.log-heading .console-dots{display:flex;gap:3px;margin-right:2px}.console-dots i{width:4px;height:4px;border-radius:50%;background:#c6d1bd}.log-heading .log-mode{margin-left:auto;font:8px var(--mono);letter-spacing:.6px}.log-lines{padding:9px 11px;max-height:140px;min-height:51px;overflow:auto;font:9px/1.9 var(--mono);color:#89987e;overflow-wrap:anywhere}.log-line time{color:#b0bba7;margin-right:9px}.log-line .level{color:#729169;margin-right:7px}.job-actions{display:flex;align-items:center;justify-content:flex-end;gap:7px;flex-wrap:wrap;margin-top:14px}.queue-notice{font-size:9px;color:#a08a5f;display:flex;align-items:center;gap:5px;margin-top:9px}.queue-notice svg{width:12px;height:12px}.queue-item{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px solid var(--line);gap:9px;font-size:10px}.queue-item span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.model-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.model-card{background:#fff;border:1px solid var(--line);border-radius:11px;padding:18px;position:relative;min-width:0;transition:border-color .2s,box-shadow .2s,transform .2s}.model-card:hover{border-color:#bcd0b7;box-shadow:0 5px 18px #24422a05;transform:translateY(-2px)}.model-card-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:13px}.model-avatar{width:29px;height:29px;border-radius:8px;display:grid;place-items:center;font:600 10px var(--mono);border:1px solid #e9ebdf;background:#f6f7ef;color:#7f865d}.model-avatar.audio{background:#edf4f6;color:#688790;border-color:#e3edf0}.model-avatar.cv{background:#f0eef6;color:#847592;border-color:#e9e4ef}.model-avatar.nlp{background:#edf5ed;color:#708b6b;border-color:#e0ecdf}.parameter-chip{font:9px var(--mono);color:#9aa28c;background:#f8f9f5;border:1px solid #ecefe5;padding:1px 6px;border-radius:4px}.model-name{font-size:12px;font-weight:600;letter-spacing:-.15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;max-width:100%;border:0;background:none;padding:0;text-align:left;color:#394536}.model-name:hover{color:var(--green)}.model-developer{font-size:9px;color:#9ca593;margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.model-tags{display:flex;align-items:center;gap:5px;margin-top:13px;flex-wrap:wrap;min-height:20px}.model-tag{font-size:8px;color:#89967f;background:#f3f6ee;padding:2px 6px;border-radius:4px;line-height:1.6}.model-tag.package{background:#f8f5e9;color:#9e8a58}.model-card-foot{border-top:1px solid #f0f3eb;margin-top:13px;padding-top:10px;display:flex;align-items:center;justify-content:space-between;gap:9px}.candidate-note{font-size:8px;color:#a2ab97;display:flex;align-items:center;gap:4px}.candidate-note:before{content:"";width:4px;height:4px;border-radius:50%;background:#bdc8ae}.model-card-foot .text-button{font-size:9px}.candidate-note:after{content:""}.catalog-toolbar{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:18px;flex-wrap:wrap}.filter-search{display:flex;align-items:center;gap:8px;border:1px solid #dfe5dc;background:white;border-radius:8px;padding:8px 12px;flex:1;min-width:180px;max-width:380px}.filter-search svg{width:15px;height:15px;color:#93a08d}.filter-search input{border:0;outline:0;width:100%;min-width:0;font-size:11px;background:transparent}.filter-controls{display:flex;gap:9px;flex-wrap:wrap}.select-control{border:1px solid #e0e6da;background:#fff;border-radius:7px;color:#7c8a72;padding:8px 27px 8px 10px;font-size:10px;max-width:260px}.catalog-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:10px;color:#99a58d;margin-bottom:14px}.category-tabs{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:21px}.category-tab{padding:7px 13px;font-size:10px;background:#fff;color:#859179;border:1px solid #e1e7db;border-radius:7px}.category-tab.active{background:var(--green);border-color:var(--green);color:#fff}.category-tab span{margin-left:7px;opacity:.6;font:9px var(--mono)}.pagination{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:24px;font-size:10px;color:#95a188}.pagination .page-number{padding:6px 10px;border:1px solid var(--line);background:#fff;border-radius:6px}.pagination .page-number.current{background:#edf4e9;color:var(--green);border-color:#d6e4ce}.empty-results{grid-column:1/-1;text-align:center;padding:65px 20px;border:1px dashed #d7e1ce;border-radius:12px;background:#f9fbf6;color:#91a084;font-size:12px}.empty-results svg{width:32px;height:32px;margin-bottom:12px;color:#acbaa1}.empty-results p{font-size:10px;margin-top:6px}.empty-results .button{margin-top:17px}.library-notice{display:flex;gap:8px;align-items:center;padding:11px 15px;border:1px solid #e4eadc;background:#f1f6eb;border-radius:8px;color:#8b9d79;font-size:10px;margin-bottom:23px}.library-notice svg{width:14px;height:14px}.library-notice strong{font-weight:500;color:#728a5e}.table-wrap{background:#fff;border:1px solid var(--line);border-radius:12px;overflow-x:auto}.jobs-table{width:100%;border-collapse:collapse;min-width:650px;font-size:11px;text-align:left}.jobs-table th{font-size:9px;font-weight:400;color:#9ca78f;background:#fafcf7;padding:13px 19px;border-bottom:1px solid var(--line);white-space:nowrap}.jobs-table td{padding:17px 19px;border-bottom:1px solid #eef2e8;color:#7c8d6d}.jobs-table tbody tr:last-child td{border-bottom:0}.jobs-table .history-model{font-weight:550;color:#4b6040}.history-model small{display:block;color:#a3ae98;font:8px var(--mono);margin-top:3px}.history-summary{display:flex;gap:10px;font-size:10px;color:#99a58d;margin-bottom:18px}.history-summary strong{color:var(--green);font-weight:550}.history-empty{padding:70px 20px;text-align:center;color:#93a183}.history-empty h2{font-size:16px;font-weight:500;margin:15px 0 7px}.history-empty p{font-size:11px}.history-empty .button{margin-top:21px}.history-empty>svg{width:36px;height:36px;color:#b8c6a7}
.docs-layout{max-width:870px;display:grid;gap:17px}.docs-card{border:1px solid var(--line);border-radius:12px;background:#fff;padding:23px 25px}.docs-card h2{font-size:14px;font-weight:600;margin-bottom:12px}.docs-card p,.docs-card li{font-size:11px;color:#8a987e;line-height:2}.docs-card ol{margin:0;padding-left:19px}.docs-card code{font:10px var(--mono);background:#f2f5ed;border:1px solid #e9eedf;padding:2px 5px;border-radius:4px;color:#6f855f}.docs-card a{color:var(--green);text-decoration:underline}.docs-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.docs-step>span{width:25px;height:25px;background:#edf4e7;color:#789965;border-radius:7px;display:grid;place-items:center;font:10px var(--mono);margin-bottom:8px}.docs-step strong{font-size:11px;font-weight:500}.docs-step p{font-size:10px;margin-top:3px}.modal{border:1px solid #dfe7d8;border-radius:16px;max-width:520px;width:calc(100% - 32px);padding:26px;background:#fff;color:var(--ink);box-shadow:0 25px 100px #21362135}.modal::backdrop{background:#172c2366;backdrop-filter:blur(3px)}.modal-header{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:12px}.modal h2{font-size:20px;font-weight:550;letter-spacing:-.5px;margin-top:7px;overflow-wrap:anywhere}.modal>.muted,.modal form>.muted{font-size:11px}.mode-options{border:0;padding:0;margin:21px 0;display:grid;gap:9px}.mode-options label{display:flex;align-items:center;gap:10px;padding:14px;border:1px solid #e4eadb;border-radius:9px;cursor:pointer}.mode-options label:has(input:checked){background:#f3f8ee;border-color:#acc59a}.mode-options input{accent-color:var(--green)}.mode-options strong{font-size:12px;font-weight:500;display:block}.mode-options small{font-size:10px;color:#95a286;display:block;margin-top:3px}.option-tag{margin-left:auto;align-self:start;font-size:9px;color:#8ca27b;background:#ecf3e6;border-radius:4px;padding:2px 5px;white-space:nowrap}.field-label{font-size:11px;display:block;margin-bottom:7px;color:#708360}.modal input[type=url]{width:100%;border:1px solid #dce5d3;border-radius:7px;padding:10px 12px;font-size:12px;outline-color:#a9c296}.field-help{font-size:9px;color:#a0ad92;line-height:1.8;margin-top:7px}.modal-footer{display:flex;justify-content:flex-end;align-items:center;gap:8px;border-top:1px solid var(--line);padding-top:18px;margin-top:17px}.model-modal .model-id{font:10px/1.8 var(--mono);color:#91a080;overflow-wrap:anywhere;background:#f6f9f1;padding:10px 12px;border-radius:7px}.model-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin:20px 0}.model-detail-grid dt{font-size:9px;color:#9faa92;margin-bottom:5px}.model-detail-grid dd{margin:0;font-size:11px;color:#647955;overflow-wrap:anywhere}.model-notes{padding-left:17px;font-size:10px;line-height:1.9;color:#8c9b7d}.model-source{font-size:10px;color:var(--green);text-decoration:underline}.toast{position:fixed;bottom:27px;left:calc(50% + var(--sidebar)/2);transform:translateX(-50%);padding:11px 18px;background:#254a36;color:#fff;border:1px solid #2c593f;border-radius:9px;box-shadow:0 6px 30px #1f3c2d24;font-size:11px;z-index:100;max-width:calc(100% - 40px)}.initial-loading{height:55vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;font-size:11px;color:#94a286}.loader{width:20px;height:20px;display:inline-block;border:2px solid #dce6d3;border-top-color:#6a9360;border-radius:50%;animation:spin 1s linear infinite}.loading-dot{width:5px;height:5px;border-radius:50%;background:currentColor;animation:pulse 1.5s ease-in-out infinite}.nav-backdrop[hidden],[hidden]{display:none!important}@keyframes spin{to{transform:rotate(360deg)}}@keyframes pulse{50%{opacity:.3}}
@media(min-width:1500px){main{padding:37px 45px 35px}.workspace-grid{grid-template-columns:minmax(0,1fr) 310px}.hero-copy h2{font-size:32px}.model-card{padding:21px}.migration-hero{padding:34px 36px 25px}.migration-graphic{width:310px}.topbar{padding:0 45px}}
@media(max-width:1150px){:root{--sidebar:202px}.sidebar{padding-left:12px;padding-right:12px}.brand{font-size:16px;gap:8px}.brand-symbol{width:31px}.brand small{letter-spacing:1.2px;font-size:9px}main{padding:25px}.topbar{padding:0 25px}.hero-copy h2{font-size:24px}.migration-graphic{width:210px;height:132px}.hero-top{gap:8px}.workspace-grid{grid-template-columns:minmax(0,1fr) 240px;gap:14px}.guide-panel{padding:21px 17px}.job-stages,.process-preview{grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 6px}.preview-step,.job-stage{font-size:9px;gap:5px}.stage-symbol,.preview-step span{width:19px;height:19px}.model-card{padding:14px}.stat-card{padding:15px 13px}.model-name{font-size:11px}.stat-icon{width:26px;height:26px}.target-note{display:none}.model-grid{gap:11px}}
@media(max-width:960px){.workspace-grid{grid-template-columns:1fr}.guide-panel{display:none}.stats-grid{gap:11px}.stat-icon{display:none}.hero-copy h2{font-size:25px}.migration-graphic{width:180px}.model-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.input-bottom{align-items:flex-start}.page-footer{padding-left:25px;padding-right:25px}.page-footer>span:last-child{display:none}.page-intro h1{font-size:23px}.filter-controls{width:100%}.select-control{flex:1;max-width:none}.filter-search{max-width:none}.docs-steps{grid-template-columns:repeat(2,1fr)}}
@media(max-width:720px){:root{--sidebar:230px}.sidebar{transform:translateX(-100%);transition:transform .2s;padding-left:19px;padding-right:19px}.sidebar.open{transform:translateX(0)}.nav-backdrop{position:fixed;inset:0;border:0;background:#132a2455;z-index:25}.app-shell{margin-left:0}.topbar{height:61px;padding:0 17px}.mobile-menu{display:inline-grid}.breadcrumb{gap:9px;font-size:10px}.topbar-actions{gap:10px}.topbar-separator{display:none}.avatar{width:26px;height:26px}.mode-pill{font-size:9px;padding:3px 7px}.brand{font-size:18px}.page-intro{margin-bottom:19px}.page-intro h1{font-size:22px}.page-intro p{font-size:10px}.page-intro .intro-actions .button{font-size:10px;padding:7px 10px;min-height:32px}.intro-actions .button svg{display:none}main{padding:24px 17px 20px}.migration-hero{padding:23px 20px 15px;border-radius:13px}.hero-top{gap:0}.hero-copy{width:100%;position:relative;z-index:2}.hero-copy h2{font-size:25px;letter-spacing:-.8px;margin-top:12px}.hero-copy>p{max-width:260px;font-size:10px}.migration-graphic{position:absolute;right:-50px;top:5px;opacity:.25;width:200px;height:120px}.hero-badge{display:none}.eyebrow{font-size:8px;letter-spacing:1.2px}.migration-form{margin-top:23px}.migration-input-wrap{gap:7px;padding:6px}.migration-input-wrap input{font-size:11px}.migration-input-wrap .button{padding:9px 12px;font-size:10px}.migration-input-wrap .button svg{display:none}.examples{gap:5px}.example-chip{font-size:8px;padding:2px 5px}.input-bottom{font-size:9px}.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0 21px}.stat-card{padding:13px 15px}.stat-icon{display:grid}.stat-number{font-size:24px;margin:5px 0 3px}.stat-description{font-size:9px}.panel-header{padding:17px 17px 14px}.job-body{padding:0 17px 17px}.workspace-grid{margin-bottom:24px}.job-stages,.process-preview{gap:15px 7px;grid-template-columns:repeat(4,minmax(0,1fr))}.job-stage,.preview-step{flex-direction:column;align-items:flex-start;font-size:9px;gap:6px}.stage-symbol,.preview-step span{height:22px;width:22px}.empty-job-title{font-size:12px}.empty-job-top{gap:8px}.empty-job-top .button{font-size:9px;padding:7px 9px}.empty-job-top p{font-size:9px}.empty-job-foot{font-size:8px}.section-head h2{font-size:14px}.section-head p{font-size:9px}.model-grid{gap:10px}.model-card{padding:13px}.model-card-head{margin-bottom:11px}.model-card-foot{gap:5px}.model-developer{font-size:8px}.model-tag{font-size:8px;padding:2px 5px}.candidate-note{font-size:8px}.model-card-foot .text-button{font-size:9px}.model-card-foot .text-button svg{display:none}.parameter-chip{font-size:8px}.page-footer{padding:15px 17px 20px;font-size:8px}.page-footer>span:first-child{font-size:9px}.category-tabs{gap:5px;margin-bottom:17px}.category-tab{padding:6px 9px;font-size:9px}.category-tab span{margin-left:5px;font-size:8px}.filter-controls{gap:6px}.select-control{font-size:9px;padding-left:8px;padding-right:18px;min-width:0}.library-notice{font-size:9px;align-items:flex-start;padding:10px 12px}.library-notice svg{margin-top:2px;flex-shrink:0}.docs-card{padding:19px}.toast{left:50%;bottom:18px;width:max-content;max-width:calc(100% - 34px)}.suggestions{width:100%;top:58px}.modal{padding:21px}.model-detail-grid{gap:12px}.job-model{font-size:15px}.job-meta{font-size:8px}.log-lines{font-size:8px}}
@media(max-width:380px){.migration-input-wrap{flex-wrap:wrap;padding:8px}.migration-input-wrap input{flex-basis:calc(100% - 40px)}.migration-input-wrap .button{width:100%;margin-top:3px}.suggestions{top:100px}.hero-copy h2{font-size:23px}.model-grid{grid-template-columns:1fr}.topbar-actions{gap:4px}.avatar{display:none}.page-intro .intro-actions{display:none}.page-intro p{max-width:280px}.model-card{padding:17px}.model-card-foot .text-button svg{display:block}.stat-card{padding:12px}.stat-icon{display:none}.mode-pill{font-size:8px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
